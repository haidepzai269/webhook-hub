datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["hub", "shop"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum ProviderEnum {
  payos
  sepay
  github
  stripe

  @@schema("hub")
}

enum RawStatus {
  ACCEPTED
  REJECTED
  DUPLICATE

  @@schema("hub")
}

enum EventOrigin {
  webhook
  reconciliation
  replay
  derived

  @@schema("hub")
}

enum DestinationType {
  webhook
  telegram
  discord

  @@schema("hub")
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  RETRYING
  SUCCEEDED
  DEAD

  @@schema("hub")
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN

  @@schema("hub")
}

// ======================== SCHEMA HUB ========================

model Source {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  provider   ProviderEnum
  name       String       @db.VarChar(255)
  sourceKey  String       @unique @map("source_key") @db.VarChar(64)
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  secrets   SourceSecret[]
  rawEvents RawEvent[]

  @@map("sources")
  @@schema("hub")
}

model SourceSecret {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted") @db.Text
  version         Int       @default(1)
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("source_secrets")
  @@schema("hub")
}

model RawEvent {
  id              String      @id @default(uuid()) @db.Uuid
  sourceId        String      @map("source_id") @db.Uuid
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(255)
  headers         Json
  body            Json
  bodyRaw         Bytes       @map("body_raw")
  contentType     String?     @map("content_type") @db.VarChar(128)
  signatureHeader String?     @map("signature_header") @db.Text
  signatureValid  Boolean     @map("signature_valid")
  status          RawStatus   @default(ACCEPTED)
  origin          EventOrigin @default(webhook)
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)

  source Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  event  Event?

  @@unique([sourceId, idempotencyKey])
  @@index([receivedAt(sort: Desc)])
  @@map("raw_events")
  @@schema("hub")
}

model Event {
  id             String      @id @db.VarChar(36) // ULID
  tenantId       String      @map("tenant_id") @db.Uuid
  rawEventId     String?     @unique @map("raw_event_id") @db.Uuid
  parentEventId  String?     @map("parent_event_id") @db.VarChar(36)
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  correlationId  String      @map("correlation_id") @db.Uuid
  type           String      @db.VarChar(128)
  source         String      @db.VarChar(64)
  subject        String?     @db.VarChar(255)
  data           Json
  origin         EventOrigin @default(webhook)
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)

  rawEvent   RawEvent?    @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([correlationId])
  @@index([type])
  @@map("events")
  @@schema("hub")
}

model Destination {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  name                  String          @db.VarChar(255)
  type                  DestinationType
  configEncrypted       String          @map("config_encrypted") @db.Text
  signingSecretEncrypted String?        @map("signing_secret_encrypted") @db.Text
  rateLimitRps          Int             @default(0) @map("rate_limit_rps")
  circuitState          CircuitState    @default(CLOSED) @map("circuit_state")
  alertOnOpen           Boolean         @default(false) @map("alert_on_open")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("destinations")
  @@schema("hub")
}

model Subscription {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  destinationId String   @map("destination_id") @db.Uuid
  name          String   @db.VarChar(255)
  eventTypes    String[] @map("event_types")
  template      String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict) // ADR-053: đích còn subscription thì không xoá được
  deliveries  Delivery[]

  @@map("subscriptions")
  @@schema("hub")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  eventId           String         @map("event_id") @db.VarChar(36)
  subscriptionId    String         @map("subscription_id") @db.Uuid
  attemptGeneration Int            @default(1) @map("attempt_generation")
  status            DeliveryStatus @default(PENDING)
  attemptCount      Int            @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?      @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?        @map("last_error") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict) // ADR-053: lịch sử gửi (kể cả DEAD) không mất theo subscription
  attempts     DeliveryAttempt[]

  @@unique([eventId, subscriptionId, attemptGeneration])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, createdAt(sort: Desc)]) // danh sách deliveries/DLQ/timeseries: lọc tenant + ORDER BY created_at DESC (ADR-033)
  @@map("deliveries")
  @@schema("hub")
}

model DeliveryAttempt {
  id             BigInt   @id @default(autoincrement())
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptNo      Int      @map("attempt_no")
  requestBody    Json?    @map("request_body")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.Text
  durationMs     Int?     @map("duration_ms")
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_attempts")
  @@schema("hub")
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  topic       String    @db.VarChar(128)
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([id])
  @@map("outbox")
  @@schema("hub")
}

model ProcessedMessage {
  consumer  String   @db.VarChar(64)
  messageId String   @map("message_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("processed_messages")
  @@schema("hub")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(255)
  actor      String   @default("system") @db.VarChar(128)
  reason     String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("hub")
}

// ======================== SCHEMA SHOP ========================

model Order {
  id                 String   @id @default(uuid()) @db.Uuid
  orderCode          String   @unique @map("order_code") @db.VarChar(64)
  amount             BigInt
  paidAmount         BigInt   @default(0) @map("paid_amount")
  status             String   @default("PENDING") @db.VarChar(32) // PENDING, PAID, UNDERPAID, EXPIRED, CANCELLED
  paymentProvider    String?  @map("payment_provider") @db.VarChar(32)
  payosPaymentLinkId String?  @map("payos_payment_link_id") @db.VarChar(128)
  version            Int      @default(1) // optimistic locking
  items              Json     @default("[]") // [{id,name,price,qty}] — giá chốt tại server lúc tạo đơn (ADR-024)
  customer           Json? // {name, phone, address?, note?}
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments ProcessedHubEvent[]

  @@index([status, createdAt]) // reconcile: PENDING quá hạn
  @@map("orders")
  @@schema("shop")
}

// Chống trùng BỀN VỮNG cho outbound webhook từ Hub (thay Set trong bộ nhớ).
// Insert event_id và cộng paidAmount trong CÙNG transaction -> mỗi khoản tiền
// chỉ được cộng đúng một lần, bất kể retry/redeliver/restart hay thứ tự đến (ADR-034).
model ProcessedHubEvent {
  eventId   String   @id @map("event_id") @db.VarChar(128)
  orderId   String   @map("order_id") @db.Uuid
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict) // sổ tiền không được mất theo đơn

  @@index([orderId])
  @@map("processed_hub_events")
  @@schema("shop")
}
