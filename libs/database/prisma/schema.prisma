datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["hub", "shop"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum ProviderEnum {
  payos
  sepay
  github
  stripe
  generic // S8: GenericAdapter, cấu hình ở sources.verification_config (ADR-041)
  api // S4: source tạo kèm API key có publish:events — chỉ nhận qua POST /v1/p/:project/events

  @@schema("hub")
}

/// S1 (ADR-038): môi trường của project -> tiền tố key `hk_test_` / `hk_live_`.
enum ProjectEnv {
  test
  live

  @@schema("hub")
}

/// S6 (ADR-040): endpoint webhook phải qua challenge mới được giao sự kiện.
enum EndpointVerification {
  PENDING
  VERIFIED
  FAILED

  @@schema("hub")
}

/// KN2 (ADR-138): trạng thái kết nối hub -> provider (biến thể A).
enum ConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DRIFTED
  DISCONNECTED

  @@schema("hub")
}

enum RawStatus {
  ACCEPTED
  REJECTED
  DUPLICATE

  @@schema("hub")
}

enum EventOrigin {
  webhook
  api // MS-R6: service tự phát qua POST /v1/p/:project/events
  reconciliation
  replay
  derived

  @@schema("hub")
}

enum DestinationType {
  webhook
  telegram
  discord

  @@schema("hub")
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  RETRYING
  SUCCEEDED
  DEAD

  @@schema("hub")
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN

  @@schema("hub")
}

/// CB1 (SPEC-canh-bao-nhan-dinh §3.1, ADR-165): cảnh báo cho người vận hành.
enum AlertSeverity {
  critical
  warning
  info

  @@schema("hub")
}

enum AlertSubjectType {
  destination
  source
  project

  @@schema("hub")
}

enum AlertState {
  OPEN
  RESOLVED

  @@schema("hub")
}

/// CB1 (DINH-CHINH D1): email theo NGƯỜI — một dòng outbox cho mỗi (alert, user, kind).
enum AlertEmailKind {
  OPEN
  RESOLVED

  @@schema("hub")
}

enum AlertEmailState {
  PENDING
  SENT
  SUPPRESSED
  FAILED

  @@schema("hub")
}

/// CB1 (DINH-CHINH D3): ngôn ngữ người dùng — worker đọc để chọn mẫu email.
enum UserLocale {
  vi
  en

  @@schema("hub")
}

// ======================== SCHEMA HUB ========================

/// S1 (ADR-038/041): biên cô lập dữ liệu. `projects.id` = giá trị `tenant_id` ở mọi bảng nghiệp vụ.
/// Bảng gốc, không mang `tenant_id` — đọc/ghi qua escape hatch có tên trên PrismaService.
model Project {
  id          String     @id @db.Uuid
  slug        String     @unique @db.VarChar(64) // ^[a-z0-9][a-z0-9-]{2,62}$
  name        String     @db.VarChar(255)
  environment ProjectEnv @default(test)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// QT (SPEC-han-muc-dung-luong §2, ADR-182): operator ghi đè hạn mức (MB). NULL = `PROJECT_STORAGE_QUOTA_MB` (mặc định 50).
  storageQuotaMb Int?    @map("storage_quota_mb")

  apiKeys ApiKey[]
  members ProjectMember[]
  usage           ProjectUsage?
  storagePolicies StoragePolicy[]
  cleanJobs       StorageCleanJob[]

  @@map("projects")
  @@schema("hub")
}

/// S1 (ADR-038/039): mỗi service một API key có scope. DB chỉ giữ sha256 của key (key 256 bit entropy).
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId    String    @map("tenant_id") @db.Uuid
  serviceName String    @map("service_name") @db.VarChar(128)
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  keyHash     String    @unique @map("key_hash") @db.Char(64)
  scopes      String[]  @default([])
  readTypes   String[]  @default([]) @map("read_types")
  sourceId    String?   @unique @map("source_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
  @@schema("hub")
}

// ===================== Danh tính người dùng (SPEC-auth §5.1, AU1) =====================
// Bảng danh tính được tra TRƯỚC khi biết tenant -> KHÔNG đi qua TenantScopedRepository; chỉ qua
// `IdentityRepository` (libs/database/src/identity.repository.ts). Không bật RLS (AU6).

enum MemberRole {
  owner
  developer
  viewer

  @@schema("hub")
}

enum TokenPurpose {
  verify_email
  reset_password
  invite

  @@schema("hub")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(254) // luôn trim + lowercase
  name              String     @db.VarChar(100)
  passwordHash      String?    @map("password_hash") // null = chỉ đăng nhập GitHub
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  githubId          String?    @unique @map("github_id") @db.VarChar(32) // id số của GitHub, không dùng login
  googleSub         String?    @unique @map("google_sub") @db.VarChar(255) // AU5b: `sub` của ID token Google, không dùng email
  isOperator        Boolean    @default(false) @map("is_operator")
  /// CB1 (DINH-CHINH D3, ADR-167): ngôn ngữ console/email. Nút Ngôn ngữ ghi qua IdentityRepository.
  locale            UserLocale @default(vi)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     ProjectMember[]
  sessions        AuthSession[]
  alertPreference AlertPreference?
  alertEmails     AlertEmail[]

  @@map("users")
  @@schema("hub")
}

model ProjectMember {
  tenantId  String     @map("tenant_id") @db.Uuid // = project id
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// QT6 (§8): owner tắt được email dung lượng 70%/85% (không tắt được 95%/LOCKED).
  storageWarnEmail Boolean @default(true) @map("storage_warn_email")

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("project_members")
  @@schema("hub")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid // = claim `sid` của access token
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid // mọi token sinh từ một lần đăng nhập
  tokenHash         String    @unique @map("token_hash") @db.Char(64) // sha256(refresh token)
  replacedById      String?   @map("replaced_by_id") @db.Uuid
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(32) // logout|logout_all|password_changed|password_reset|reuse_detected|removed
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
  @@schema("hub")
}

model EmailToken {
  id        String       @id @default(uuid()) @db.Uuid
  purpose   TokenPurpose
  email     String       @db.VarChar(254)
  userId    String?      @map("user_id") @db.Uuid
  tenantId  String?      @map("tenant_id") @db.Uuid // chỉ cho invite
  role      MemberRole? // chỉ cho invite
  invitedBy String?      @map("invited_by") @db.Uuid
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose])
  @@map("email_tokens")
  @@schema("hub")
}

/// Sự kiện cấp user, không thuộc project nào (SPEC-auth §6.2). Không bao giờ chứa mật khẩu/token.
model AuthAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  ip        String?  @db.VarChar(45)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("auth_audit")
  @@schema("hub")
}

model Source {
  id                 String       @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId           String       @map("tenant_id") @db.Uuid
  provider           ProviderEnum
  name               String       @db.VarChar(255)
  sourceKey          String       @unique @map("source_key") @db.VarChar(64)
  isActive           Boolean      @default(true) @map("is_active")
  /// S8: chỉ dùng khi provider=generic (scheme, header, idempotency, eventType, mapping?)
  verificationConfig Json?        @map("verification_config")
  /// ADR-161: "Xoá" trên bản đồ luồng = lưu trữ (luôn kèm is_active=false). NULL = còn dùng. Lịch sử giữ nguyên.
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  /// QT E1 (ADR-189): user tự gắn "Giữ lâu" — nhận tới 110% (HARD_LOCKED), không gợi ý/không dọn tự động. Hub không tự gắn (BB-1).
  keepLonger         Boolean      @default(false) @map("keep_longer")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  secrets     SourceSecret[]
  rawEvents   RawEvent[]
  connections SourceConnection[] // tối đa MỘT (source_connections.source_id UNIQUE); khai mảng vì FK ghép (id, tenant_id)
  duplicates  IngestDuplicate[] // CB6 (ADR-171): bộ đếm bản trùng theo giờ
  traffic     SourceTrafficMinutely[] // EG4 (ADR-179): lưu lượng theo phút

  @@unique([id, tenantId]) // KN2: đích của khoá ngoại ghép source_connections(source_id, tenant_id)
  @@map("sources")
  @@schema("hub")
}

model SourceSecret {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted") @db.Text
  version         Int       @default(1)
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("source_secrets")
  @@schema("hub")
}

/// KN2 (SPEC-ket-noi §4.2, ADR-138): hub đã đăng ký URL ingest của source tại provider. Credentials MÃ HOÁ
/// (AES-256-GCM, MASTER_KEY), không route nào trả ra. RLS + TenantScopedRepository (BB-5).
model SourceConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  sourceId             String           @unique @map("source_id") @db.Uuid
  provider             ProviderEnum
  credentialsEncrypted String?          @map("credentials_encrypted") @db.Text
  status               ConnectionStatus @default(PENDING)
  remoteRef            String?          @map("remote_ref") @db.VarChar(255)
  display              String?          @db.VarChar(255)
  ingestUrl            String           @map("ingest_url") @db.Text
  lastError            String?          @map("last_error") @db.VarChar(255)
  lastFix              String?          @map("last_fix") @db.Text
  connectedAt          DateTime?        @map("connected_at") @db.Timestamptz(6)
  lastCheckedAt        DateTime?        @map("last_checked_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Khoá ngoại GHÉP (source_id, tenant_id): DB từ chối kết nối trỏ sang source của project khác.
  source Source @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("source_connections")
  @@schema("hub")
}

model RawEvent {
  id              String      @id @default(uuid()) @db.Uuid
  sourceId        String      @map("source_id") @db.Uuid
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(255)
  headers         Json
  body            Json
  bodyRaw         Bytes       @map("body_raw")
  contentType     String?     @map("content_type") @db.VarChar(128)
  signatureHeader String?     @map("signature_header") @db.Text
  signatureValid  Boolean     @map("signature_valid")
  status          RawStatus   @default(ACCEPTED)
  origin          EventOrigin @default(webhook)
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  /// QT §5.1 (ADR-184): "Dọn" đã bỏ nội dung (body_raw rỗng) — dòng gầy giữ khoá chống trùng (BB-2).
  trimmedAt       DateTime?   @map("trimmed_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  event  Event?

  @@unique([sourceId, idempotencyKey])
  @@index([receivedAt(sort: Desc)])
  @@map("raw_events")
  @@schema("hub")
}

/// CB6 (ADR-171): bản trùng hub đã chặn — KHÔNG lưu raw_events (unique (source_id, idempotency_key) là trọng tài, BB-2),
/// nên chỉ còn bộ đếm theo (source, giờ UTC). hub-api gom trong bộ nhớ rồi `INSERT … ON CONFLICT DO UPDATE n = n + …`
/// mỗi ~5s — không chạm Redis, không nằm trên đường ACK (BB-3). Nhận định `I-dup` đọc ở đây. RLS + TenantScopedRepository.
model IngestDuplicate {
  tenantId String   @map("tenant_id") @db.Uuid
  sourceId String   @map("source_id") @db.Uuid
  /// Đầu giờ (UTC) — múi Việt Nam lệch giờ chẵn nên "hôm nay" cắt đúng theo bucket.
  bucket   DateTime @db.Timestamptz(6)
  n        Int      @default(0)

  source Source @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([tenantId, sourceId, bucket])
  @@index([tenantId, bucket(sort: Desc)])
  @@map("ingest_duplicates")
  @@schema("hub")
}

/// EG4 (ADR-179): kết quả của một request vào source, theo phút. BLOCKED = bị hộp phạt chặn theo cặp (IP, sourceKey).
enum TrafficOutcome {
  ACCEPTED
  DUPLICATE
  REJECTED
  RATE_LIMITED
  BLOCKED
  STORAGE_FULL // QT E2: bị 507 vì project đầy (bytes = 0)

  @@schema("hub")
}

/// EG4 (SPEC-chong-qua-tai §5, ADR-179): lưu lượng theo (source, phút, outcome). hub-api đếm trong bộ nhớ ở `traced()`
/// rồi upsert theo lô mỗi `TRAFFIC_FLUSH_MS` (60s) — không thêm truy vấn vào đường nóng. Được phép thiếu (số liệu quan sát,
/// không phải idempotency). Giữ `TRAFFIC_RETENTION_DAYS` (7) ngày. RLS + TenantScopedRepository.
model SourceTrafficMinutely {
  tenantId String         @map("tenant_id") @db.Uuid
  sourceId String         @map("source_id") @db.Uuid
  /// Đầu phút (UTC).
  minute   DateTime       @db.Timestamptz(6)
  outcome  TrafficOutcome
  count    Int            @default(0)
  /// ≤ 5 phần tử `{ip, count}` nhiều nhất của phút đó; IPv6 ghi theo prefix /64.
  topIps   Json           @default("[]") @map("top_ips")
  /// QT E2 (ADR-183): số byte THỰC SỰ ghi xuống DB trong phút đó (body_raw khi ACCEPTED, mẫu ≤4KB khi REJECTED, còn lại 0).
  bytes    BigInt         @default(0)

  source Source @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([tenantId, sourceId, minute, outcome])
  @@index([minute])
  @@map("source_traffic_minutely")
  @@schema("hub")
}

/// QT (SPEC-han-muc-dung-luong §7 + E2, ADR-183): dung lượng ƯỚC TÍNH của project. `used_bytes` = mốc hiệu chỉnh
/// + bloat_factor × Σ bytes traffic sau mốc − đã giải phóng sau mốc. RLS + TenantScopedRepository; job worker đọc xuyên
/// project qua systemTx có tên.
model ProjectUsage {
  tenantId              String    @id @map("tenant_id") @db.Uuid
  usedBytes             BigInt    @default(0) @map("used_bytes")
  calibratedBytes       BigInt    @default(0) @map("calibrated_bytes")
  calibratedAt          DateTime? @map("calibrated_at") @db.Timestamptz(6)
  freedSinceCalibration BigInt    @default(0) @map("freed_since_calibration")
  bloatFactor           Decimal   @default(2) @map("bloat_factor") @db.Decimal(6, 3)
  bySource              Json      @default("{}") @map("by_source")
  byBucket              Json      @default("[]") @map("by_bucket")
  suggestions           Json      @default("[]")
  suggestedAt           DateTime? @map("suggested_at") @db.Timestamptz(6)
  suggestedBytes        BigInt?   @map("suggested_bytes")
  level                 String    @default("OK") @db.VarChar(16)
  notifiedLevel         String?   @map("notified_level") @db.VarChar(16)
  notifiedAt            DateTime? @map("notified_at") @db.Timestamptz(6)
  /// QT6 (ADR-190): nấc đã báo lần cuối (alert + webhook hub.project.storage + email) — khác `level` = còn nợ một lần báo.
  signaledLevel         String?   @map("signaled_level") @db.VarChar(16)
  measuredAt            DateTime? @map("measured_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("project_usage")
  @@schema("hub")
}

/// QT §5.4 (ADR-186): dọn tự động theo mức quan trọng (chỉ junk/low/medium — "Cao"/"Giữ" không có ở đây). RLS.
model StoragePolicy {
  tenantId   String   @map("tenant_id") @db.Uuid
  importance String   @db.VarChar(16)
  action     String   @db.VarChar(8)
  afterDays  Int      @map("after_days")
  trigger    String   @default("always") @db.VarChar(16)
  updatedBy  String   @default("system") @map("updated_by") @db.VarChar(128)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, importance])
  @@map("storage_policies")
  @@schema("hub")
}

/// QT4 (§5.5, ADR-184): LỆNH DỌN — API ghi PENDING + trả 202; hub-worker nhận bằng SKIP LOCKED và chạy theo lô (mỗi lô một
/// transaction ngắn, tiến độ + byte giải phóng cộng trong CÙNG transaction). Index một phần (status đang chờ) chỉ ở migration.
model StorageCleanJob {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  action           String    @db.VarChar(8)
  importance       String[]
  olderThan        String    @map("older_than") @db.VarChar(40)
  cutoff           DateTime  @db.Timestamptz(6)
  sourceId         String?   @map("source_id") @db.Uuid
  origin           String    @default("manual") @db.VarChar(16)
  suggestionId     String?   @map("suggestion_id") @db.VarChar(64)
  advisor          String?   @db.VarChar(32)
  requestedBy      String    @map("requested_by") @db.VarChar(128)
  status           String    @default("PENDING") @db.VarChar(16)
  eventsAffected   Int       @default(0) @map("events_affected")
  rejectedAffected Int       @default(0) @map("rejected_affected")
  freedBytes       BigInt    @default(0) @map("freed_bytes")
  batches          Int       @default(0)
  attempts         Int       @default(0)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(6)
  error            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)], map: "storage_clean_jobs_tenant_created_idx")
  @@map("storage_clean_jobs")
  @@schema("hub")
}

model Event {
  id             String      @id @db.VarChar(36) // ULID
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId       String      @map("tenant_id") @db.Uuid
  /// S7: cursor polling (A) — tăng dần theo thứ tự INSERT. Không dùng ULID (nhiều worker cùng ms không có thứ tự).
  seq            BigInt      @unique @default(autoincrement())
  /// R-3 (ADR-095): cursor polling theo thứ tự COMMIT — cấp lúc poll cho dòng đã commit (advisory lock theo tenant).
  pollSeq        BigInt?     @unique @map("poll_seq")
  /// S5: source sinh ra event (lọc subscription theo sourceIds). Null với event cũ không còn raw_event.
  sourceId       String?     @map("source_id") @db.Uuid
  rawEventId     String?     @unique @map("raw_event_id") @db.Uuid
  parentEventId  String?     @map("parent_event_id") @db.VarChar(36)
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  correlationId  String      @map("correlation_id") @db.Uuid
  type           String      @db.VarChar(128)
  source         String      @db.VarChar(64)
  subject        String?     @db.VarChar(255)
  data           Json
  /// S3-2 (ADR-053): true = data theo catalog kiểu chuẩn; false = kiểu chưa ánh xạ, data = { raw }
  normalized     Boolean     @default(true)
  /// KQ1: request kiểm tra của chính provider (adapter đặt cờ) — lưu cho console, KHÔNG định tuyến, polling KHÔNG trả.
  probe          Boolean     @default(false)
  origin         EventOrigin @default(webhook)
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  /// S7 (ADR-077): lúc INSERT (clock_timestamp) — cửa sổ lắng của polling lọc theo cột này, không theo received_at.
  createdAt      DateTime    @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  /// QT §5.1 (ADR-184): "Dọn" đã bỏ `data` — polling trả `trimmed: true, data: null`.
  trimmedAt      DateTime?   @map("trimmed_at") @db.Timestamptz(6)

  rawEvent   RawEvent?  @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([tenantId, seq])
  @@index([tenantId, pollSeq])
  @@index([correlationId])
  @@index([type])
  @@map("events")
  @@schema("hub")
}

model Destination {
  id                     String               @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId               String               @map("tenant_id") @db.Uuid
  name                   String               @db.VarChar(255)
  type                   DestinationType
  configEncrypted        String               @map("config_encrypted") @db.Text
  signingSecretEncrypted String?              @map("signing_secret_encrypted") @db.Text
  rateLimitRps           Int                  @default(0) @map("rate_limit_rps")
  circuitState           CircuitState         @default(CLOSED) @map("circuit_state")
  /// @deprecated CB1/CB7 (SPEC §3.3, ADR-172): cờ chết — không code nào đọc. Thay bằng luật `destination.circuit_open`
  /// (luôn bật). Đã bỏ khỏi view/UI (CB7); cột drop ở một migration sau. KHÔNG dùng mới.
  alertOnOpen            Boolean              @default(false) @map("alert_on_open")
  /// S6 (ADR-040): default VERIFIED cho dữ liệu cũ + telegram/discord; endpoint tạo qua API service bắt đầu PENDING.
  verification           EndpointVerification @default(VERIFIED)
  verifiedAt             DateTime?            @map("verified_at") @db.Timestamptz(6)
  verificationError      String?              @map("verification_error") @db.VarChar(64)
  /// R-1/R-2 (ADR-094): API key tạo endpoint qua /v1/p — chỉ key này quản endpoint ở /v1/p. NULL = đích của operator.
  createdByKeyId         String?              @map("created_by_key_id") @db.Uuid
  /// ADR-161: "Ngắt" đích — false = normalize không tạo delivery mới tới đích này (delivery đang bay vẫn chạy nốt).
  isActive               Boolean              @default(true) @map("is_active")
  /// ADR-161: lưu trữ ("Xoá" trên bản đồ luồng). NULL = còn dùng.
  archivedAt             DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@unique([id, tenantId]) // đích của khoá ngoại ghép subscriptions(destination_id, tenant_id)
  @@index([tenantId, createdByKeyId])
  @@map("destinations")
  @@schema("hub")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId      String    @map("tenant_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  name          String    @db.VarChar(255)
  eventTypes    String[]  @map("event_types")
  /// S5: rỗng = mọi source trong project; có giá trị = chỉ event từ các source này.
  sourceIds     String[]  @default([]) @map("source_ids") @db.Uuid
  template      String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  /// ADR-161: lưu trữ ("Xoá" trên bản đồ luồng) — luôn kèm is_active=false; không bao giờ khớp sự kiện mới.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // S1 (ADR-038): khoá ngoại GHÉP (destination_id, tenant_id) — DB từ chối subscription trỏ sang đích của
  // project khác, kể cả khi code quên kiểm. RESTRICT giữ ADR-054: đích còn subscription thì không xoá được.
  destination Destination @relation(fields: [destinationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries  Delivery[]

  @@map("subscriptions")
  @@schema("hub")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId          String         @map("tenant_id") @db.Uuid
  eventId           String         @map("event_id") @db.VarChar(36)
  subscriptionId    String         @map("subscription_id") @db.Uuid
  attemptGeneration Int            @default(1) @map("attempt_generation")
  status            DeliveryStatus @default(PENDING)
  attemptCount      Int            @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?      @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?        @map("last_error") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict) // ADR-053: lịch sử gửi (kể cả DEAD) không mất theo subscription
  attempts     DeliveryAttempt[]

  @@unique([eventId, subscriptionId, attemptGeneration])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, createdAt(sort: Desc)]) // danh sách deliveries/DLQ/timeseries: lọc tenant + ORDER BY created_at DESC (ADR-033)
  // CB2: + index MỘT PHẦN `deliveries_dead_tenant_updated_idx (tenant_id, updated_at DESC) WHERE status='DEAD'` — chỉ ở migration
  // 20261012060000_alert_eval_indexes (Prisma 6 không khai được WHERE).
  @@map("deliveries")
  @@schema("hub")
}

model DeliveryAttempt {
  id             BigInt   @id @default(autoincrement())
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptNo      Int      @map("attempt_no")
  requestBody    Json?    @map("request_body")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.Text
  durationMs     Int?     @map("duration_ms")
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([createdAt]) // CB2: cửa sổ attempt của AlertEvaluator (migration 20261012060000_alert_eval_indexes)
  @@map("delivery_attempts")
  @@schema("hub")
}

/// CB1 (SPEC §3.1, ADR-165): cảnh báo — bảng nghiệp vụ mang tenant_id, RLS, chỉ qua TenantScopedRepository (BB-5).
/// Trọng tài chống trùng: unique index MỘT PHẦN `(tenant_id, rule, subject_id) WHERE state = 'OPEN'` (chỉ có ở migration
/// 20261012050000_alerts — Prisma 6 không khai được `WHERE`). Redis không giữ gì của cảnh báo (BB-2).
model Alert {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  rule           String           @db.VarChar(64)
  severity       AlertSeverity
  subjectType    AlertSubjectType @map("subject_type")
  /// id đối tượng; cấp project thì = tenant_id.
  subjectId      String           @map("subject_id") @db.Uuid
  state          AlertState       @default(OPEN)
  openedAt       DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// lần cuối luật còn đúng.
  lastSeenAt     DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  /// số liệu dựng câu — KHÔNG payload, secret, header.
  facts          Json             @default("{}")
  /// "Đã xem": chỉ tắt banner, KHÔNG đóng cảnh báo.
  acknowledgedAt DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?          @map("acknowledged_by") @db.Uuid

  emails AlertEmail[]

  @@unique([id, tenantId]) // đích của khoá ngoại ghép alert_emails(alert_id, tenant_id)
  @@index([tenantId, state, openedAt(sort: Desc)])
  @@index([state, severity, openedAt(sort: Desc)])
  @@map("alerts")
  @@schema("hub")
}

/// CB1 (DINH-CHINH D1/D2, ADR-167): outbox email theo NGƯỜI. Mang tenant_id (= tenant của alert, khoá ngoại ghép) + RLS;
/// vòng gửi xuyên project (CB5) đi qua escape hatch có tên. Trần 6/giờ/người và chống flapping đếm trên bảng này.
model AlertEmail {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  alertId          String          @map("alert_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  kind             AlertEmailKind
  state            AlertEmailState @default(PENDING)
  attempts         Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(6)
  /// CB5 (ADR-173): lease + lùi thử lại của vòng gửi (gửi NGOÀI transaction). Index một phần
  /// `alert_emails_user_sent_idx (user_id, sent_at DESC) WHERE state='SENT'` (trần 6/giờ) chỉ có ở migration 20261012080000.
  nextAttemptAt    DateTime?       @map("next_attempt_at") @db.Timestamptz(6)
  lastError        String?         @map("last_error") @db.VarChar(200)
  suppressedReason String?         @map("suppressed_reason") @db.VarChar(64)
  rolledInto       String?         @map("rolled_into") @db.Uuid
  /// QT6 (ADR-190): email theo nấc/ngày của cùng cảnh báo (`up:WARN_85:<ngày>`, `remind:LOCKED:<ngày>`); email CB = ''.
  tag              String          @default("") @db.VarChar(48)

  alert Alert @relation(fields: [alertId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId, kind, tag])
  @@index([userId, createdAt(sort: Desc)])
  @@index([state, createdAt])
  @@map("alert_emails")
  @@schema("hub")
}

/// CB1 (SPEC §3.2, ADR-166): tuỳ chọn cảnh báo gắn NGƯỜI DÙNG, không gắn tenant -> KHÔNG tenant_id, KHÔNG RLS; chỉ qua
/// IdentityRepository (như users/auth_sessions). Có chủ ý, không phải lỗ BB-5.
model AlertPreference {
  userId         String   @id @map("user_id") @db.Uuid
  emailEnabled   Boolean  @default(false) @map("email_enabled")
  /// luật được gửi email. Dòng mới tạo qua IdentityRepository nhận DEFAULT_EMAIL_RULES (mọi luật critical, SPEC §3.2).
  emailRules     String[] @default([]) @map("email_rules")
  emailOnResolve Boolean  @default(false) @map("email_on_resolve")
  /// tắt EMAIL của các project này (chuông vẫn hiện).
  mutedProjects  String[] @default([]) @map("muted_projects") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alert_preferences")
  @@schema("hub")
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  topic       String    @db.VarChar(128)
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([id])
  @@map("outbox")
  @@schema("hub")
}

model ProcessedMessage {
  consumer  String   @db.VarChar(64)
  messageId String   @map("message_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("processed_messages")
  @@schema("hub")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId   String   @map("tenant_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(255)
  actor      String   @default("system") @db.VarChar(128)
  reason     String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("hub")
}

// ======================== SCHEMA SHOP ========================

model Order {
  id                 String   @id @default(uuid()) @db.Uuid
  orderCode          String   @unique @map("order_code") @db.VarChar(64)
  amount             BigInt
  paidAmount         BigInt   @default(0) @map("paid_amount")
  status             String   @default("PENDING") @db.VarChar(32) // PENDING, PAID, UNDERPAID, EXPIRED, CANCELLED
  paymentProvider    String?  @map("payment_provider") @db.VarChar(32)
  payosPaymentLinkId String?  @map("payos_payment_link_id") @db.VarChar(128)
  version            Int      @default(1) // optimistic locking
  items              Json     @default("[]") // [{id,name,price,qty}] — giá chốt tại server lúc tạo đơn (ADR-024)
  customer           Json? // {name, phone, address?, note?}
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments ProcessedHubEvent[]

  @@index([status, createdAt]) // reconcile: PENDING quá hạn
  @@map("orders")
  @@schema("shop")
}

// Chống trùng BỀN VỮNG cho outbound webhook từ Hub (thay Set trong bộ nhớ).
// Insert event_id và cộng paidAmount trong CÙNG transaction -> mỗi khoản tiền
// chỉ được cộng đúng một lần, bất kể retry/redeliver/restart hay thứ tự đến (ADR-034).
model ProcessedHubEvent {
  eventId   String   @id @map("event_id") @db.VarChar(128)
  orderId   String   @map("order_id") @db.Uuid
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict) // sổ tiền không được mất theo đơn

  @@index([orderId])
  @@map("processed_hub_events")
  @@schema("shop")
}

// SK2 (SPEC-shop-ket-noi-project §4.1, ADR-155): cài đặt kết nối của Shop — MỘT dòng (id = 1). Giá trị ở đây thắng env.
// Bốn trường bí mật là ciphertext AES-256-GCM (`iv:tag:data`, khoá SHOP_SETTINGS_KEY) — tên cột có hậu tố `_encrypted`.
// NULL / mảng rỗng = chưa lưu -> Shop dùng env cũ (HUB_URL, SHOP_PAYMENT_SOURCE_KEYS, PAYOS_*, SHOP_BANK_*).
model ShopSetting {
  id                Int      @id @default(1) @db.SmallInt
  hubConnectionUrl  String?  @map("hub_connection_url_encrypted")
  paymentSourceKeys String[] @default([]) @map("payment_source_keys")
  payosClientId     String?  @map("payos_client_id_encrypted")
  payosApiKey       String?  @map("payos_api_key_encrypted")
  payosChecksumKey  String?  @map("payos_checksum_key_encrypted")
  bankCode          String?  @map("bank_code") @db.VarChar(512)
  bankAccount       String?  @map("bank_account") @db.VarChar(512)
  bankAccountName   String?  @map("bank_account_name") @db.VarChar(512)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
  @@schema("shop")
}
