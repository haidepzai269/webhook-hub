datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["hub", "shop"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum ProviderEnum {
  payos
  sepay
  github
  stripe
  generic // S8: GenericAdapter, cấu hình ở sources.verification_config (ADR-041)
  api // S4: source tạo kèm API key có publish:events — chỉ nhận qua POST /v1/p/:project/events

  @@schema("hub")
}

/// S1 (ADR-038): môi trường của project -> tiền tố key `hk_test_` / `hk_live_`.
enum ProjectEnv {
  test
  live

  @@schema("hub")
}

/// S6 (ADR-040): endpoint webhook phải qua challenge mới được giao sự kiện.
enum EndpointVerification {
  PENDING
  VERIFIED
  FAILED

  @@schema("hub")
}

/// KN2 (ADR-138): trạng thái kết nối hub -> provider (biến thể A).
enum ConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DRIFTED
  DISCONNECTED

  @@schema("hub")
}

enum RawStatus {
  ACCEPTED
  REJECTED
  DUPLICATE

  @@schema("hub")
}

enum EventOrigin {
  webhook
  api // MS-R6: service tự phát qua POST /v1/p/:project/events
  reconciliation
  replay
  derived

  @@schema("hub")
}

enum DestinationType {
  webhook
  telegram
  discord

  @@schema("hub")
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  RETRYING
  SUCCEEDED
  DEAD

  @@schema("hub")
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN

  @@schema("hub")
}

/// CB1 (SPEC-canh-bao-nhan-dinh §3.1, ADR-165): cảnh báo cho người vận hành.
enum AlertSeverity {
  critical
  warning
  info

  @@schema("hub")
}

enum AlertSubjectType {
  destination
  source
  project

  @@schema("hub")
}

enum AlertState {
  OPEN
  RESOLVED

  @@schema("hub")
}

/// CB1 (DINH-CHINH D1): email theo NGƯỜI — một dòng outbox cho mỗi (alert, user, kind).
enum AlertEmailKind {
  OPEN
  RESOLVED

  @@schema("hub")
}

enum AlertEmailState {
  PENDING
  SENT
  SUPPRESSED
  FAILED

  @@schema("hub")
}

/// CB1 (DINH-CHINH D3): ngôn ngữ người dùng — worker đọc để chọn mẫu email.
enum UserLocale {
  vi
  en

  @@schema("hub")
}

// ======================== SCHEMA HUB ========================

/// S1 (ADR-038/041): biên cô lập dữ liệu. `projects.id` = giá trị `tenant_id` ở mọi bảng nghiệp vụ.
/// Bảng gốc, không mang `tenant_id` — đọc/ghi qua escape hatch có tên trên PrismaService.
model Project {
  id          String     @id @db.Uuid
  slug        String     @unique @db.VarChar(64) // ^[a-z0-9][a-z0-9-]{2,62}$
  name        String     @db.VarChar(255)
  environment ProjectEnv @default(test)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  apiKeys ApiKey[]
  members ProjectMember[]

  @@map("projects")
  @@schema("hub")
}

/// S1 (ADR-038/039): mỗi service một API key có scope. DB chỉ giữ sha256 của key (key 256 bit entropy).
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId    String    @map("tenant_id") @db.Uuid
  serviceName String    @map("service_name") @db.VarChar(128)
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  keyHash     String    @unique @map("key_hash") @db.Char(64)
  scopes      String[]  @default([])
  readTypes   String[]  @default([]) @map("read_types")
  sourceId    String?   @unique @map("source_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
  @@schema("hub")
}

// ===================== Danh tính người dùng (SPEC-auth §5.1, AU1) =====================
// Bảng danh tính được tra TRƯỚC khi biết tenant -> KHÔNG đi qua TenantScopedRepository; chỉ qua
// `IdentityRepository` (libs/database/src/identity.repository.ts). Không bật RLS (AU6).

enum MemberRole {
  owner
  developer
  viewer

  @@schema("hub")
}

enum TokenPurpose {
  verify_email
  reset_password
  invite

  @@schema("hub")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(254) // luôn trim + lowercase
  name              String     @db.VarChar(100)
  passwordHash      String?    @map("password_hash") // null = chỉ đăng nhập GitHub
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  githubId          String?    @unique @map("github_id") @db.VarChar(32) // id số của GitHub, không dùng login
  googleSub         String?    @unique @map("google_sub") @db.VarChar(255) // AU5b: `sub` của ID token Google, không dùng email
  isOperator        Boolean    @default(false) @map("is_operator")
  /// CB1 (DINH-CHINH D3, ADR-167): ngôn ngữ console/email. Nút Ngôn ngữ ghi qua IdentityRepository.
  locale            UserLocale @default(vi)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     ProjectMember[]
  sessions        AuthSession[]
  alertPreference AlertPreference?
  alertEmails     AlertEmail[]

  @@map("users")
  @@schema("hub")
}

model ProjectMember {
  tenantId  String     @map("tenant_id") @db.Uuid // = project id
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("project_members")
  @@schema("hub")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid // = claim `sid` của access token
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid // mọi token sinh từ một lần đăng nhập
  tokenHash         String    @unique @map("token_hash") @db.Char(64) // sha256(refresh token)
  replacedById      String?   @map("replaced_by_id") @db.Uuid
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(32) // logout|logout_all|password_changed|password_reset|reuse_detected|removed
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(45)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
  @@schema("hub")
}

model EmailToken {
  id        String       @id @default(uuid()) @db.Uuid
  purpose   TokenPurpose
  email     String       @db.VarChar(254)
  userId    String?      @map("user_id") @db.Uuid
  tenantId  String?      @map("tenant_id") @db.Uuid // chỉ cho invite
  role      MemberRole? // chỉ cho invite
  invitedBy String?      @map("invited_by") @db.Uuid
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose])
  @@map("email_tokens")
  @@schema("hub")
}

/// Sự kiện cấp user, không thuộc project nào (SPEC-auth §6.2). Không bao giờ chứa mật khẩu/token.
model AuthAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  ip        String?  @db.VarChar(45)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("auth_audit")
  @@schema("hub")
}

model Source {
  id                 String       @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId           String       @map("tenant_id") @db.Uuid
  provider           ProviderEnum
  name               String       @db.VarChar(255)
  sourceKey          String       @unique @map("source_key") @db.VarChar(64)
  isActive           Boolean      @default(true) @map("is_active")
  /// S8: chỉ dùng khi provider=generic (scheme, header, idempotency, eventType, mapping?)
  verificationConfig Json?        @map("verification_config")
  /// ADR-161: "Xoá" trên bản đồ luồng = lưu trữ (luôn kèm is_active=false). NULL = còn dùng. Lịch sử giữ nguyên.
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  secrets     SourceSecret[]
  rawEvents   RawEvent[]
  connections SourceConnection[] // tối đa MỘT (source_connections.source_id UNIQUE); khai mảng vì FK ghép (id, tenant_id)

  @@unique([id, tenantId]) // KN2: đích của khoá ngoại ghép source_connections(source_id, tenant_id)
  @@map("sources")
  @@schema("hub")
}

model SourceSecret {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted") @db.Text
  version         Int       @default(1)
  validFrom       DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("source_secrets")
  @@schema("hub")
}

/// KN2 (SPEC-ket-noi §4.2, ADR-138): hub đã đăng ký URL ingest của source tại provider. Credentials MÃ HOÁ
/// (AES-256-GCM, MASTER_KEY), không route nào trả ra. RLS + TenantScopedRepository (BB-5).
model SourceConnection {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  sourceId             String           @unique @map("source_id") @db.Uuid
  provider             ProviderEnum
  credentialsEncrypted String?          @map("credentials_encrypted") @db.Text
  status               ConnectionStatus @default(PENDING)
  remoteRef            String?          @map("remote_ref") @db.VarChar(255)
  display              String?          @db.VarChar(255)
  ingestUrl            String           @map("ingest_url") @db.Text
  lastError            String?          @map("last_error") @db.VarChar(255)
  lastFix              String?          @map("last_fix") @db.Text
  connectedAt          DateTime?        @map("connected_at") @db.Timestamptz(6)
  lastCheckedAt        DateTime?        @map("last_checked_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Khoá ngoại GHÉP (source_id, tenant_id): DB từ chối kết nối trỏ sang source của project khác.
  source Source @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("source_connections")
  @@schema("hub")
}

model RawEvent {
  id              String      @id @default(uuid()) @db.Uuid
  sourceId        String      @map("source_id") @db.Uuid
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(255)
  headers         Json
  body            Json
  bodyRaw         Bytes       @map("body_raw")
  contentType     String?     @map("content_type") @db.VarChar(128)
  signatureHeader String?     @map("signature_header") @db.Text
  signatureValid  Boolean     @map("signature_valid")
  status          RawStatus   @default(ACCEPTED)
  origin          EventOrigin @default(webhook)
  receivedAt      DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  event  Event?

  @@unique([sourceId, idempotencyKey])
  @@index([receivedAt(sort: Desc)])
  @@map("raw_events")
  @@schema("hub")
}

model Event {
  id             String      @id @db.VarChar(36) // ULID
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId       String      @map("tenant_id") @db.Uuid
  /// S7: cursor polling (A) — tăng dần theo thứ tự INSERT. Không dùng ULID (nhiều worker cùng ms không có thứ tự).
  seq            BigInt      @unique @default(autoincrement())
  /// R-3 (ADR-095): cursor polling theo thứ tự COMMIT — cấp lúc poll cho dòng đã commit (advisory lock theo tenant).
  pollSeq        BigInt?     @unique @map("poll_seq")
  /// S5: source sinh ra event (lọc subscription theo sourceIds). Null với event cũ không còn raw_event.
  sourceId       String?     @map("source_id") @db.Uuid
  rawEventId     String?     @unique @map("raw_event_id") @db.Uuid
  parentEventId  String?     @map("parent_event_id") @db.VarChar(36)
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(255)
  correlationId  String      @map("correlation_id") @db.Uuid
  type           String      @db.VarChar(128)
  source         String      @db.VarChar(64)
  subject        String?     @db.VarChar(255)
  data           Json
  /// S3-2 (ADR-053): true = data theo catalog kiểu chuẩn; false = kiểu chưa ánh xạ, data = { raw }
  normalized     Boolean     @default(true)
  /// KQ1: request kiểm tra của chính provider (adapter đặt cờ) — lưu cho console, KHÔNG định tuyến, polling KHÔNG trả.
  probe          Boolean     @default(false)
  origin         EventOrigin @default(webhook)
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  /// S7 (ADR-077): lúc INSERT (clock_timestamp) — cửa sổ lắng của polling lọc theo cột này, không theo received_at.
  createdAt      DateTime    @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  rawEvent   RawEvent?  @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([tenantId, seq])
  @@index([tenantId, pollSeq])
  @@index([correlationId])
  @@index([type])
  @@map("events")
  @@schema("hub")
}

model Destination {
  id                     String               @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId               String               @map("tenant_id") @db.Uuid
  name                   String               @db.VarChar(255)
  type                   DestinationType
  configEncrypted        String               @map("config_encrypted") @db.Text
  signingSecretEncrypted String?              @map("signing_secret_encrypted") @db.Text
  rateLimitRps           Int                  @default(0) @map("rate_limit_rps")
  circuitState           CircuitState         @default(CLOSED) @map("circuit_state")
  /// @deprecated CB1 (SPEC §3.3; ADR ghi ở CB7): cờ chết — không code nào đọc. Thay bằng luật `destination.circuit_open`
  /// (luôn bật). CB7 bỏ khỏi view/UI; cột drop ở một migration sau. KHÔNG dùng mới.
  alertOnOpen            Boolean              @default(false) @map("alert_on_open")
  /// S6 (ADR-040): default VERIFIED cho dữ liệu cũ + telegram/discord; endpoint tạo qua API service bắt đầu PENDING.
  verification           EndpointVerification @default(VERIFIED)
  verifiedAt             DateTime?            @map("verified_at") @db.Timestamptz(6)
  verificationError      String?              @map("verification_error") @db.VarChar(64)
  /// R-1/R-2 (ADR-094): API key tạo endpoint qua /v1/p — chỉ key này quản endpoint ở /v1/p. NULL = đích của operator.
  createdByKeyId         String?              @map("created_by_key_id") @db.Uuid
  /// ADR-161: "Ngắt" đích — false = normalize không tạo delivery mới tới đích này (delivery đang bay vẫn chạy nốt).
  isActive               Boolean              @default(true) @map("is_active")
  /// ADR-161: lưu trữ ("Xoá" trên bản đồ luồng). NULL = còn dùng.
  archivedAt             DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@unique([id, tenantId]) // đích của khoá ngoại ghép subscriptions(destination_id, tenant_id)
  @@index([tenantId, createdByKeyId])
  @@map("destinations")
  @@schema("hub")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId      String    @map("tenant_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  name          String    @db.VarChar(255)
  eventTypes    String[]  @map("event_types")
  /// S5: rỗng = mọi source trong project; có giá trị = chỉ event từ các source này.
  sourceIds     String[]  @default([]) @map("source_ids") @db.Uuid
  template      String?   @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  /// ADR-161: lưu trữ ("Xoá" trên bản đồ luồng) — luôn kèm is_active=false; không bao giờ khớp sự kiện mới.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // S1 (ADR-038): khoá ngoại GHÉP (destination_id, tenant_id) — DB từ chối subscription trỏ sang đích của
  // project khác, kể cả khi code quên kiểm. RESTRICT giữ ADR-054: đích còn subscription thì không xoá được.
  destination Destination @relation(fields: [destinationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries  Delivery[]

  @@map("subscriptions")
  @@schema("hub")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId          String         @map("tenant_id") @db.Uuid
  eventId           String         @map("event_id") @db.VarChar(36)
  subscriptionId    String         @map("subscription_id") @db.Uuid
  attemptGeneration Int            @default(1) @map("attempt_generation")
  status            DeliveryStatus @default(PENDING)
  attemptCount      Int            @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?      @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String?        @map("last_error") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict) // ADR-053: lịch sử gửi (kể cả DEAD) không mất theo subscription
  attempts     DeliveryAttempt[]

  @@unique([eventId, subscriptionId, attemptGeneration])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, createdAt(sort: Desc)]) // danh sách deliveries/DLQ/timeseries: lọc tenant + ORDER BY created_at DESC (ADR-033)
  @@map("deliveries")
  @@schema("hub")
}

model DeliveryAttempt {
  id             BigInt   @id @default(autoincrement())
  deliveryId     String   @map("delivery_id") @db.Uuid
  attemptNo      Int      @map("attempt_no")
  requestBody    Json?    @map("request_body")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.Text
  durationMs     Int?     @map("duration_ms")
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_attempts")
  @@schema("hub")
}

/// CB1 (SPEC §3.1, ADR-165): cảnh báo — bảng nghiệp vụ mang tenant_id, RLS, chỉ qua TenantScopedRepository (BB-5).
/// Trọng tài chống trùng: unique index MỘT PHẦN `(tenant_id, rule, subject_id) WHERE state = 'OPEN'` (chỉ có ở migration
/// 20261012050000_alerts — Prisma 6 không khai được `WHERE`). Redis không giữ gì của cảnh báo (BB-2).
model Alert {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  rule           String           @db.VarChar(64)
  severity       AlertSeverity
  subjectType    AlertSubjectType @map("subject_type")
  /// id đối tượng; cấp project thì = tenant_id.
  subjectId      String           @map("subject_id") @db.Uuid
  state          AlertState       @default(OPEN)
  openedAt       DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  /// lần cuối luật còn đúng.
  lastSeenAt     DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  /// số liệu dựng câu — KHÔNG payload, secret, header.
  facts          Json             @default("{}")
  /// "Đã xem": chỉ tắt banner, KHÔNG đóng cảnh báo.
  acknowledgedAt DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?          @map("acknowledged_by") @db.Uuid

  emails AlertEmail[]

  @@unique([id, tenantId]) // đích của khoá ngoại ghép alert_emails(alert_id, tenant_id)
  @@index([tenantId, state, openedAt(sort: Desc)])
  @@index([state, severity, openedAt(sort: Desc)])
  @@map("alerts")
  @@schema("hub")
}

/// CB1 (DINH-CHINH D1/D2, ADR-167): outbox email theo NGƯỜI. Mang tenant_id (= tenant của alert, khoá ngoại ghép) + RLS;
/// vòng gửi xuyên project (CB5) đi qua escape hatch có tên. Trần 6/giờ/người và chống flapping đếm trên bảng này.
model AlertEmail {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  alertId   String          @map("alert_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  kind      AlertEmailKind
  state     AlertEmailState @default(PENDING)
  attempts  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?       @map("sent_at") @db.Timestamptz(6)

  alert Alert @relation(fields: [alertId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId, kind])
  @@index([userId, createdAt(sort: Desc)])
  @@index([state, createdAt])
  @@map("alert_emails")
  @@schema("hub")
}

/// CB1 (SPEC §3.2, ADR-166): tuỳ chọn cảnh báo gắn NGƯỜI DÙNG, không gắn tenant -> KHÔNG tenant_id, KHÔNG RLS; chỉ qua
/// IdentityRepository (như users/auth_sessions). Có chủ ý, không phải lỗ BB-5.
model AlertPreference {
  userId         String   @id @map("user_id") @db.Uuid
  emailEnabled   Boolean  @default(false) @map("email_enabled")
  /// luật được gửi email. Dòng mới tạo qua IdentityRepository nhận DEFAULT_EMAIL_RULES (mọi luật critical, SPEC §3.2).
  emailRules     String[] @default([]) @map("email_rules")
  emailOnResolve Boolean  @default(false) @map("email_on_resolve")
  /// tắt EMAIL của các project này (chuông vẫn hiện).
  mutedProjects  String[] @default([]) @map("muted_projects") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alert_preferences")
  @@schema("hub")
}

model Outbox {
  id          BigInt    @id @default(autoincrement())
  topic       String    @db.VarChar(128)
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([id])
  @@map("outbox")
  @@schema("hub")
}

model ProcessedMessage {
  consumer  String   @db.VarChar(64)
  messageId String   @map("message_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([consumer, messageId])
  @@map("processed_messages")
  @@schema("hub")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  // tenant_id = project_id (ADR-038/041). Giữ tên cột để không đổi 40 file.
  tenantId   String   @map("tenant_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(255)
  actor      String   @default("system") @db.VarChar(128)
  reason     String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("hub")
}

// ======================== SCHEMA SHOP ========================

model Order {
  id                 String   @id @default(uuid()) @db.Uuid
  orderCode          String   @unique @map("order_code") @db.VarChar(64)
  amount             BigInt
  paidAmount         BigInt   @default(0) @map("paid_amount")
  status             String   @default("PENDING") @db.VarChar(32) // PENDING, PAID, UNDERPAID, EXPIRED, CANCELLED
  paymentProvider    String?  @map("payment_provider") @db.VarChar(32)
  payosPaymentLinkId String?  @map("payos_payment_link_id") @db.VarChar(128)
  version            Int      @default(1) // optimistic locking
  items              Json     @default("[]") // [{id,name,price,qty}] — giá chốt tại server lúc tạo đơn (ADR-024)
  customer           Json? // {name, phone, address?, note?}
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments ProcessedHubEvent[]

  @@index([status, createdAt]) // reconcile: PENDING quá hạn
  @@map("orders")
  @@schema("shop")
}

// Chống trùng BỀN VỮNG cho outbound webhook từ Hub (thay Set trong bộ nhớ).
// Insert event_id và cộng paidAmount trong CÙNG transaction -> mỗi khoản tiền
// chỉ được cộng đúng một lần, bất kể retry/redeliver/restart hay thứ tự đến (ADR-034).
model ProcessedHubEvent {
  eventId   String   @id @map("event_id") @db.VarChar(128)
  orderId   String   @map("order_id") @db.Uuid
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict) // sổ tiền không được mất theo đơn

  @@index([orderId])
  @@map("processed_hub_events")
  @@schema("shop")
}

// SK2 (SPEC-shop-ket-noi-project §4.1, ADR-155): cài đặt kết nối của Shop — MỘT dòng (id = 1). Giá trị ở đây thắng env.
// Bốn trường bí mật là ciphertext AES-256-GCM (`iv:tag:data`, khoá SHOP_SETTINGS_KEY) — tên cột có hậu tố `_encrypted`.
// NULL / mảng rỗng = chưa lưu -> Shop dùng env cũ (HUB_URL, SHOP_PAYMENT_SOURCE_KEYS, PAYOS_*, SHOP_BANK_*).
model ShopSetting {
  id                Int      @id @default(1) @db.SmallInt
  hubConnectionUrl  String?  @map("hub_connection_url_encrypted")
  paymentSourceKeys String[] @default([]) @map("payment_source_keys")
  payosClientId     String?  @map("payos_client_id_encrypted")
  payosApiKey       String?  @map("payos_api_key_encrypted")
  payosChecksumKey  String?  @map("payos_checksum_key_encrypted")
  bankCode          String?  @map("bank_code") @db.VarChar(512)
  bankAccount       String?  @map("bank_account") @db.VarChar(512)
  bankAccountName   String?  @map("bank_account_name") @db.VarChar(512)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
  @@schema("shop")
}
