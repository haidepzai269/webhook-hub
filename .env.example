# ==========================================
# CẤU HÌNH HẠ TẦNG (DOCKER / LOCAL)
# ==========================================
# Database PostgreSQL (Schema: hub cho webhook hub, shop cho demo shop)
# Cổng 5433 được ánh xạ từ container postgres (tránh trùng cổng 5432 của PostgreSQL local)
# AU6 (RLS, ADR-108): DATABASE_URL = role runtime `hub_app` (KHÔNG superuser, KHÔNG BYPASSRLS) — hub-api/hub-worker
# thoát nếu là role đặc quyền. DIRECT_URL = owner (migrate + seed). docker-compose tự tạo hub_app bằng HUB_APP_DB_PASSWORD.
DATABASE_URL="postgresql://hub_app:hub_app_local_only_password@localhost:5433/webhook_hub?schema=hub"
DIRECT_URL="postgresql://hub_user:hub_password@localhost:5433/webhook_hub?schema=hub"
HUB_APP_DB_PASSWORD="hub_app_local_only_password"
# Chỉ dùng cho test (NODE_ENV=test): cho phép chạy bằng role đặc quyền. KHÔNG BAO GIỜ đặt ở môi trường khác.
# RLS_ALLOW_PRIVILEGED=1

# Redis: đường tắt chống trùng, rate limit cửa sổ cố định, circuit breaker, pub/sub realtime (BB-2: được phép sai)
REDIS_URL="redis://localhost:6379"

# RabbitMQ Message Broker
RABBITMQ_URL="amqp://hub_admin:hub_secret@localhost:5672"

# Server Ports
PORT=4000
SHOP_PORT=4001

# ==========================================
# BẢO MẬT & MÃ HÓA (SECURITY & ENCRYPTION)
# ==========================================
# MASTER_KEY dùng mã hoá/giải mã AES-256-GCM cho secret khách hàng (source_secrets, destinations).
# Đây CHỈ là giá trị mẫu để tham khảo cấu trúc — đổi sang giá trị ngẫu nhiên riêng, tối thiểu 32 ký tự.
# TUYỆT ĐỐI KHÔNG dùng nguyên giá trị mẫu này khi deploy thật (nó đã công khai trên GitHub).
# hub-api và hub-worker sẽ process.exit(1) lúc bootstrap nếu MASTER_KEY thiếu hoặc < 32 ký tự.
MASTER_KEY="dev-master-secret-key-at-least-32-chars!"
HUB_SIGNING_SECRET="hub_outbound_signing_secret_999"
# ---- Đăng nhập console (SPEC-auth §7, ADR-103) ----
# JWT_SECRET ký access token 15 phút (cookie __Host-hub_at). CSRF_SECRET ký token CSRF gắn với phiên.
# SOCKET_TICKET_SECRET ký vé Socket.IO 60 giây. OAUTH_COOKIE_SECRET ký cookie state/PKCE của GitHub OAuth (AU5).
# Mỗi biến ≥ 32 ký tự, KHÁC NHAU — hub-api process.exit(1) lúc bootstrap nếu sai. Giá trị dưới CHỈ là mẫu
# (công khai trên GitHub) — sinh giá trị riêng: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET="dev-jwt-placeholder-change-me-min-32-chars"
CSRF_SECRET="dev-csrf-placeholder-change-me-min-32-chars"
SOCKET_TICKET_SECRET="dev-socket-placeholder-change-me-min-32-chars"
OAUTH_COOKIE_SECRET="dev-oauth-placeholder-change-me-min-32-chars"
# R-2 (ADR-110): web (proxy.ts) chuyển IP client sang hub-api kèm secret này; hub-api VÀ web phải cùng giá trị.
# Để trống = tắt (mọi request console qua web mang IP của web -> rate limit theo IP thành giới hạn chung).
WEB_PROXY_SECRET="dev-webproxy-placeholder-change-me-min-32-chars"
# Thời gian sống: access (giây), refresh trượt / tuyệt đối (ngày)
JWT_ACCESS_TTL_S=900
REFRESH_IDLE_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
# Operator (kế thừa admin env cũ — ADMIN_USERNAME/ADMIN_PASSWORD_HASH không còn dùng). Seed tạo user operator
# (đã xác minh email, owner của project default) nếu chưa có; KHÔNG ghi đè mật khẩu nếu đã có.
# Hash bcrypt (không lưu plaintext):  node -e "console.log(require('bcryptjs').hashSync('mat-khau-that', 12))"
# QUAN TRỌNG: .env bị docker-compose nội suy — MỌI dấu `$` trong hash PHẢI escape thành `$$` (đã kiểm bằng
# `docker compose config`). Mẫu dưới (đã escape) = mật khẩu "changeme123" — CHỈ dev local.
OPERATOR_EMAIL="admin@hub.local"
OPERATOR_PASSWORD_HASH="$$2b$$10$$nzHQAACL/wKU7flcgQUM3.QWQcn7gsRcH1W6HyX6.5XGmPMIejDg2"
# Mail (AU2, SPEC-auth §5.9): log = in link ra log (CHỈ local) · resend = gửi thật qua Resend.
# Bẫy Resend: chưa xác minh domain thì chỉ gửi được tới email CHỦ tài khoản Resend (from onboarding@resend.dev).
MAIL_DRIVER=log
RESEND_API_KEY=""
MAIL_FROM="Webhook Hub <onboarding@resend.dev>"
# MAIL_DRIVER=gmail (ADR-124): Gmail API qua HTTPS + OAuth2 — cách lấy: docs/DEPLOYMENT.md §9 "Lấy GOOGLE_REFRESH_TOKEN".
# Khi dùng gmail, MAIL_FROM phải là đúng địa chỉ Gmail đó (vd "Webhook Hub <ban@gmail.com>").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Đăng nhập GitHub (AU5): tạo GitHub OAuth App (KHÁC webhook secret của adapter GitHub), scope read:user user:email.
# Authorization callback URL = <WEB_PUBLIC_URL>/auth/github/callback (đi qua proxy của web). Trống -> nút GitHub trả 503.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
# Chỉ stack kiểm chứng (fake-github). Production bắt buộc https://github.com (app thoát nếu khác).
GITHUB_OAUTH_BASE_URL=""
# AU5b (ADR-127): đăng nhập Google — client OAuth "Web application" RIÊNG (KHÔNG phải GOOGLE_CLIENT_ID/SECRET gửi mail).
# Redirect URI: <WEB_PUBLIC_URL>/auth/google/callback (local: http://localhost:3000/auth/google/callback). Trống -> nút Google trả 503.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Chỉ stack kiểm chứng (fake-google trong sink); production đặt biến này -> hub-api thoát.
GOOGLE_OAUTH_FAKE_BASE_URL=""
# Render (đứng sau proxy thật) đặt 1. LOCAL: KHÔNG đặt biến này — compose tự để hub-api chỉ tin service `edge`
# (TRUST_PROXY mặc định = EDGE_IP 10.250.250.6, EG1). Đặt 0 ở đây sẽ đè mặc định đó: qua edge, req.ip thành IP container.
# TRUST_PROXY=
# --- EG1: nginx đứng trước hub-api (ADR-175/176) — chi tiết, giá trị cho Render: docs/DEPLOYMENT.md §3.6 ---
# Để comment = dùng mặc định. Không có secret. Image/hub-all mặc định TẮT; service `edge` của compose bật cầu chì sẵn.
# EDGE_NGINX=0                   # 1 = hub-all chạy nginx làm con thứ ba (deployed). Bật thì BẮT BUỘC EDGE_TRUSTED_PROXIES (D11)
# EDGE_TRUSTED_PROXIES=          # IP/CIDR proxy phía trước, cách nhau dấu phẩy. Trống = không tin X-Forwarded-For
# EDGE_REAL_IP_RECURSIVE=on      # on|off. Dải rộng (/0) chỉ đi với off (lấy phần tử cuối của XFF)
# EDGE_ALLOW_NO_REAL_IP=0        # 1 = cố ý chạy EDGE_NGINX không có proxy tin cậy (cảnh báo level 50)
# EDGE_IP_FUSE=0                 # cầu chì IP ở /hooks/* và /v1/p/* (compose: mặc định 1)
# EDGE_IP_RATE=50                # r/s mỗi IP
# EDGE_IP_BURST=500
# EDGE_CONN_PER_IP=50
# EDGE_API_PORT=4000             # cổng nội bộ hub-api sau nginx (hub-all), khác PORT
# EDGE_DRAIN_MS=16000            # tắt máy: hub-api chờ nginx tối đa chừng này (kẹp để còn ≥ 6 s trong 25 s)
# Mạng edge_net của compose — đổi thì đổi cả ba cho khớp (TRUST_PROXY mặc định = EDGE_IP):
# EDGE_NET_SUBNET=10.250.250.0/29
# EDGE_NET_RANGE=10.250.250.0/30
# EDGE_IP=10.250.250.6
INTERNAL_TOKEN="dev-internal-reconcile-token"
NODE_ENV="development"

# ==========================================
# CẤU HÌNH BÊN THỨ 3 (3RD-PARTY PROVIDERS & DESTINATIONS)
# (Điền key thật vào đây khi test với bên thứ 3)
# ==========================================

# --- 1. PayOS (Cổng thanh toán trực tuyến Việt Nam) ---
# Lấy tại: https://my.payos.vn -> Kênh thanh toán -> Thông tin tích hợp
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# --- 2. SePay (Cổng giám sát biến động số dư ngân hàng) ---
# Lấy tại: https://my.sepay.vn -> Tích hợp -> Webhook API Key
SEPAY_API_KEY=""

# --- 3. GitHub (Nhận webhook push/PR từ GitHub) ---
# Đặt secret khi cấu hình Webhook trên GitHub Repo Settings
GITHUB_WEBHOOK_SECRET=""

# --- 4. Telegram (Gửi thông báo biến động số dư / sự kiện) ---
# Tạo bot tại @BotFather để lấy TELEGRAM_BOT_TOKEN
# Lấy Chat ID / Group ID (vd: -100xxxxxxxxxx)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- 5. Discord (Gửi thông báo Git / Webhook) ---
# Tạo Webhook trong Discord Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=""

# =============================================================
# VẬN HÀNH & QUAN SÁT (S3-4, S3-5 — tất cả có mặc định, chỉ đặt khi cần đổi)
# =============================================================
# Trần ingest mỗi source mỗi phút (cửa sổ cố định 60s, 1 lệnh Redis). Nâng tạm khi chạy k6.
INGEST_RATE_LIMIT_PER_MIN=100
# Đặt trên môi trường deployed để chặn /metrics của hub-api VÀ hub-worker bằng "Authorization: Bearer <token>".
# Local để trống: Prometheus trong compose scrape thẳng.
METRICS_TOKEN=""
# Cổng /metrics + /health/live + /health/ready của hub-worker (http server tối giản, chỉ mạng nội bộ). 0 = tắt.
WORKER_METRICS_PORT=9101
# ADR-248: dead-man's switch, TẮT khi để trống. hub-worker GET URL này mỗi HEARTBEAT_INTERVAL_MS, CHỈ khi vòng outbox relay
# vừa làm việc thành công. Dùng Healthchecks.io-kiểu: worker im -> dịch vụ ngoài báo. URL là bí mật, đừng commit.
HEARTBEAT_URL=""
HEARTBEAT_INTERVAL_MS=60000
# ---- LOG TỰ NÓI NGUYÊN NHÂN (docs/LOGGING.md, ADR-250/254/255) — tất cả có mặc định ----
# Mức log: local = debug, deployed = info (debug không bao giờ ở đường nóng production).
LOG_LEVEL=info
# Tỉ lệ ghi dòng THÀNH CÔNG (`ingest.done`/`normalize.done`/`delivery.attempt` ok), 0..1. Để trống: local 1 (ghi hết), deployed 0.1
# (nhận ra deployed qua RENDER hoặc DEPLOY_ENV=deployed). Lỗi/chậm/hoãn/DEAD LUÔN ghi. Số đếm lấy từ hub_log_events_total (không phụ thuộc mẫu).
LOG_SUCCESS_SAMPLE=
# local | deployed — chỉ ảnh hưởng mặc định lấy mẫu ở trên; Render đã tự đặt RENDER nên thường không cần.
DEPLOY_ENV=
# Gộp dòng lặp (wrong.signature/unknown_source/payload_shape/policy_blocked, slow.deferred_*, fail.hub_db/broker/redis) theo (cause, source|destination): ≤ 1 dòng / cửa sổ, dòng sau mang sampled.suppressed.
LOG_DEDUPE_WINDOW_MS=30000
# Ngưỡng "chậm" (ms) — MỘT nơi: libs/common/src/slow-thresholds.ts. Vượt ngưỡng -> dòng được ghi đủ kèm cause slow.*.
SLOW_INGEST_MS=500          # ingest.done: total_ms
SLOW_DELIVERY_MS=3000       # delivery.attempt: chặng gọi đích (stage_ms.dest_http) -> slow.destination
SLOW_NORMALIZE_MS=1000      # normalize.done: thời gian xử lý của handler
SLOW_QUEUE_WAIT_MS=5000     # message nằm hàng đợi QUÁ hạn (đã trừ chờ cố ý của tầng retry) -> slow.queue_wait
SLOW_RELAY_LAG_MS=3000      # tuổi dòng outbox lúc relay -> slow.relay_lag
COLD_START_WINDOW_S=60      # tiến trình trẻ hơn mức này + request đầu -> slow.cold_start và header x-hub-cold
EVENT_LOOP_LAG_P99_MS=200   # ngưỡng cảnh báo p99 event loop (gauge hub_event_loop_lag_seconds, cờ slow.hub_cpu)
# growth.window (tổng hợp 60s trong bộ nhớ, không Redis/DB): burst_source > factor × đường nền; dup_flood; dlq_swell; retry_storm; backlog.
GROWTH_WINDOW_MS=60000
GROWTH_BURST_FACTOR=5
GROWTH_MIN_COUNT=100        # dưới ngưỡng tuyệt đối này (sự kiện/cửa sổ) không bao giờ báo burst/dup/retry_storm
GROWTH_DUP_RATIO=0.5
GROWTH_DLQ_MIN=20
GROWTH_RETRY_RATIO=0.5
GROWTH_BACKLOG_WINDOWS=3
# ---- SENTRY backend (docs/LOGGING.md §11, ADR-258) — TẮT khi SENTRY_DSN trống (local/CI): no-op hoàn toàn, không nạp SDK ----
# MỘT project Sentry (region EU) dùng chung hub-api + hub-worker; phân biệt bằng tag `svc`. DSN là bí mật vận hành: chỉ đặt trên Render, KHÔNG commit.
SENTRY_DSN=
SENTRY_ENVIRONMENT=         # trống: DEPLOY_ENV, rồi 'deployed' nếu có RENDER, còn lại 'local'
SENTRY_RELEASE=             # git sha (cùng sha với image/Render) để gom lỗi theo bản phát hành
SENTRY_MAX_PER_MIN=         # trần event gửi / phút / tiến trình (trống = 10); vượt thì bỏ + đếm. Đếm trong bộ nhớ, không Redis
SENTRY_DEDUPE_WINDOW_MS=    # cùng fingerprint trong cửa sổ này chỉ gửi 1 lần (trống = 300000)
# ---- SENTRY web (apps/web, ADR-264) — build-time (Vercel). Trống NEXT_PUBLIC_SENTRY_DSN = no-op, SDK không vào bundle ----
NEXT_PUBLIC_SENTRY_DSN=     # DSN trình duyệt (công khai); nên là Client Key riêng của cùng project. SENTRY_ENVIRONMENT/SENTRY_RELEASE ở trên dùng chung (release web: VERCEL_GIT_COMMIT_SHA)
SENTRY_TRACES_SAMPLE_RATE_WEB= # 0–1; trống = 0.1 deployed / 0 local
SENTRY_AUTH_TOKEN=          # CHỈ build Vercel (secret): upload source map. Thiếu = không upload, build vẫn thành công. KHÔNG commit
SENTRY_ORG=
SENTRY_PROJECT_WEB=
# Số ngày giữ events (+ deliveries, attempts), outbox đã publish, processed_messages, raw_events REJECTED
# (phải > tổng TTL retry). Tên chính EVENT_RETENTION_DAYS; CLEANUP_RETENTION_DAYS vẫn đọc làm alias (ADR-077).
# raw_events ACCEPTED KHÔNG BAO GIỜ bị xoá (ADR-045). Polling (A) chỉ lấy lại được trong N ngày này.
EVENT_RETENTION_DAYS=7
# Trần TỔNG một lần gửi tới đích, kẹp 1000–10000ms (S10, ADR-078). Đổi phải restart hub-worker.
DELIVERY_TIMEOUT_MS=5000
# QT (SPEC-han-muc-dung-luong, ADR-182..185): hạn mức dung lượng MẶC ĐỊNH mỗi project (MB, ước tính). Operator ghi đè từng
# project ở projects.storage_quota_mb. Đọc ở hub-worker (job đo) — đổi phải restart.
PROJECT_STORAGE_QUOTA_MB=50
# QT2 (ADR-183): nhịp job cập nhật nấc (cộng dồn qua bảng lưu lượng, mặc định 60s) và nhịp hiệu chỉnh quét thật (mặc định 24h).
STORAGE_LEVEL_INTERVAL_MS=60000
STORAGE_RECALIBRATE_INTERVAL_MS=86400000
# QT2 (ADR-185): ngân sách ổ của cả database (MB). pg_database_size ≥ 80% -> metric hub_storage_near_full = 1 (chốt toàn cục).
# Neon free = 512.
DB_DISK_BUDGET_MB=512
# QT3 E5 (ADR-189): khoá chiều ghi (507 project_storage_full) khi project ≥ 100% (source "Giữ lâu" tới 110%).
# MẶC ĐỊNH 0 = an toàn khi tự deploy: vẫn đo, vẫn đổi nấc, KHÔNG trả 507 (chỉ đếm hub_ingest_storage_would_reject_total).
# Chỉ bật (=1) sau checklist trong docs/DEPLOYMENT.md (≥ 24h, so số cộng dồn với số quét thật). docker-compose local/hubv mặc định 1.
STORAGE_LOCK_ENABLED=0
# QT5 E5 (ADR-186/189): dọn tự động theo policy (mặc định seed: Rác xoá hẳn 1 ngày, Thấp dọn 3 ngày). MẶC ĐỊNH 0 = policy
# đã cài, hiện trên console ("Đã cài, chưa chạy"), nhưng worker KHÔNG tự dọn. Dọn tay vẫn chạy. Bật sau checklist DEPLOYMENT.
STORAGE_AUTO_CLEAN_ENABLED=0
# QT4 (ADR-184): nhịp hub-worker thăm dò lệnh dọn (ms, 1000–60000).
STORAGE_CLEAN_POLL_MS=5000
# QT9 (Q11): trần số source CHƯA lưu trữ mỗi project (409 source_limit). Operator không bị giới hạn.
SOURCE_LIMIT_PER_PROJECT=20
# BP2 (ADR-196): thời gian tối đa (ms) một lần thử được hoãn vì circuit trước khi tính là một lần thử thất bại.
# Thay CIRCUIT_MAX_DEFERRALS. Chỉ được đặt THẤP hơn mặc định 1800000 (cao hơn bị kẹp — sàn dọn QT tính theo mặc định).
CIRCUIT_MAX_DEFER_MS=1800000
# BP3 (ADR-197): OPEN sau khi probe thất bại (giây, 60..300). Chỉ được đặt THẤP hơn 300 (cửa sổ retry QT tính theo 300).
CIRCUIT_OPEN_MAX_SECONDS=300
# BP4 (ADR-198): slow-start sau khi đích hồi phục (probe thành công): 2 -> 4 -> ... rps, mỗi bước 10s, trong 60s.
# DELIVERY_RAMP_SECONDS=0 tắt; chỉ được THẤP hơn 60 (cửa sổ retry QT tính theo 60).
DELIVERY_RAMP_START_RPS=2
DELIVERY_RAMP_STEP_SECONDS=10
DELIVERY_RAMP_SECONDS=60
# BP5 (ADR-200): áp lực ngược cho DB (cục bộ trong worker, 0 lệnh Redis).
BACKPRESSURE_SET_POINT=0.05
BACKPRESSURE_PROBE_INTERVAL_MS=5000
# Chỉ được THẤP hơn 60000 (cửa sổ retry QT cộng 6 × giá trị mặc định).
BACKPRESSURE_HOLD_MAX_MS=60000
# Normalize hoãn không đốt lượt khi DB ốm, tối đa (ms). Chỉ được THẤP hơn 3600000 (cửa sổ retry QT tính theo mặc định).
NORMALIZE_MAX_DEFER_MS=3600000
# docker-compose: tự seed khi DB trống (idempotent). false = không seed.
RUN_SEED=true
# Subscription Telegram do seed tạo có BẬT không. Compose local mặc định false (không gửi Telegram thật).
SEED_TELEGRAM_ACTIVE=false
# Graceful shutdown — 25s, KHÔNG phải 30s (Render SIGKILL sau ~30s).
SHUTDOWN_TIMEOUT_MS=25000

# =============================================================
# ĐA SERVICE: project · API key · kết nối (S1–S12, ADR-071..082)
# =============================================================
# Host trong connection string trả về khi tạo key: hub://<key>@<host>/<project> (https -> hubs://).
HUB_PUBLIC_URL=http://localhost:4000
# ADR-211: URL provider gọi vào (/hooks/*). Trống = HUB_PUBLIC_URL. Đặt khi provider đi qua lưới hứng (workers.dev).
# LH3 (H4): request có chữ ký lưới hợp lệ dựng URL công khai từ biến này; request gọi thẳng dùng HUB_PUBLIC_URL.
HUB_INGEST_PUBLIC_URL=
# LH3 (ADR-217): HMAC header lưới hứng (Cloudflare Worker) — cùng giá trị với secret của Worker. Trống = tắt (header
# x-catchnet-* bị bỏ qua). Xoay khoá: "mới,cũ". Sinh: openssl rand -hex 32. Local không chạy Worker -> để trống.
CATCHNET_FORWARD_SECRET=
# LH3: hạn của x-catchnet-received-at (ngày, 1..30, mặc định 7) — bằng giá trị của Worker.
CATCHNET_RETENTION_DAYS=7
# DX1 (ADR-136, review L-3): gốc của `docsUrl` trong body lỗi (`<HUB_DOCS_URL>#<mã>`). Trống = `docs/ERRORS.md` (tương đối,
# không bấm được ở bản deploy). Gợi ý: https://github.com/haidepzai269/webhook-hub/blob/master/docs/ERRORS.md
HUB_DOCS_URL=""
# Key `shop` mà seed tạo (lưu sha256) — compose truyền CÙNG giá trị cho Shop trong HUB_URL. Để trống = seed sinh
# ngẫu nhiên và in HUB_URL ra log một lần (khi đó phải tự đặt HUB_URL cho Shop). Dạng hk_test_<43 ký tự base64url>.
SEED_SHOP_API_KEY=""
# Shop là service dùng hub (S11): connection string của key `shop` + URL công khai để tự đăng ký endpoint.
# Compose local tự dựng: HUB_URL=hub://<SEED_SHOP_API_KEY>@hub-api:4000/default, SHOP_PUBLIC_URL=http://shop:4001
HUB_URL=""
SHOP_PUBLIC_URL=http://localhost:4001
# P1 (ADR-141) — Shop nhận tiền thật. PayOS dùng CHUNG PAYOS_CLIENT_ID/API_KEY/CHECKSUM_KEY ở trên (cùng kênh với source hub).
# Trang Shop (web) để PayOS đưa khách quay lại sau khi trả / huỷ.
SHOP_WEB_URL=http://localhost:3000/shop
# Hạn đơn (phút) — link PayOS hết hạn cùng lúc. Mặc định 30.
SHOP_ORDER_TTL_MIN=30
# SePay: VietQR thật của tài khoản nhận tiền (mã ngân hàng kiểu VietQR, vd MB, VCB, ACB). Để trống = không hiện QR.
SHOP_BANK_CODE=""
SHOP_BANK_ACCOUNT=""
SHOP_BANK_ACCOUNT_NAME=""
# Chỉ đổi khi test với máy chủ PayOS giả. KHÔNG đặt PAYOS_BASE_URL (SDK của hub đọc biến đó).
# SHOP_PAYOS_API_BASE=https://api-merchant.payos.vn
# Seed hai project demo cafe/bookstore (S12, docs/DEMO-MULTI-PROJECT.md). false = không tạo.
SEED_DEMO_PROJECTS=true
# Gốc URL endpoint mock của project demo; trống = <MOCK_BASE_URL>/mock/echo
DEMO_ENDPOINT_BASE_URL=""
# Web console (AU1): CORS có credentials CHỈ cho origin này (+ CORS_ORIGINS), link trong mail, OAuth callback.
# Trống = CORS origin *, KHÔNG credentials (khi đó web phải đi qua proxy /api, /auth của chính nó).
WEB_PUBLIC_URL="http://localhost:3000"
# Web (Next.js) proxy /api/* và /auth/* sang hub-api — đặt LÚC BUILD web (Next tính rewrites khi build)
HUB_API_INTERNAL_URL="http://localhost:4000"
CORS_ORIGINS=""
# Redis fail nhanh (MS-P2-3): thời gian tối đa một lệnh Redis trước khi fail-open (50–5000ms)
REDIS_COMMAND_TIMEOUT_MS=300
