<mxfile host="drawio" type="device" compressed="false"><diagram id="pg1" name="1. Tổng quan các tầng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · Phân quyền Webhook Hub — các tầng từ chủ thể đến dữ liệu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;Vẽ theo CODE hiện hành. Mỗi đường đi qua: xác thực → thuộc project nào → được làm gì → dữ liệu (RLS). Cạnh đỏ = từ chối, kèm mã trả về. Route không khai scope bị đóng mặc định: 500 scope_not_declared (R-8).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;CHỦ THỂ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="250" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;① CỔNG XÁC THỰC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="78" width="270" height="22" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;② CỔNG PROJECT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="78" width="270" height="22" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;③ CỔNG SCOPE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="970" y="78" width="270" height="22" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;④ TẦNG DỮ LIỆU&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="78" width="300" height="22" as="geometry"/></mxCell><mxCell id="c8" value="Đường NGƯỜI — console /api/v1/*  (cookie phiên, không dùng API key)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="105" width="1260" height="430" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;users.is_operator = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="250" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Thành viên owner&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="250" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Thành viên developer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="250" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Thành viên viewer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="250" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;SessionGuard&lt;/b&gt;&lt;br&gt;cookie __Host-hub_at (JWT HS256, iss+aud+exp)&lt;br&gt;+ 1 truy vấn session còn sống + user (thu hồi có hiệu lực ngay)&lt;br&gt;+ CSRF double-submit ký theo sid với POST/PUT/PATCH/DELETE&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;session.guard.ts:33-62&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="270" height="175" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;ProjectScopeGuard&lt;/b&gt;&lt;br&gt;đọc ?projectId= (hoặc :projectId)&lt;br&gt;role = membership(user, project)&lt;br&gt;không là thành viên và không phải operator → 404 cùng một body với &amp;#x27;project không tồn tại&amp;#x27;&lt;br&gt;operator không là thành viên → scope owner (viaOperator)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;project-scope.guard.ts:30-39,57-85&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="150" width="270" height="215" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;@RequireScope(…)&lt;/b&gt;&lt;br&gt;scope cần = metadata của route&lt;br&gt;scope có = ROLE_SCOPES[role] (viewer ⊂ developer ⊂ owner)&lt;br&gt;thiếu scope → 403 missing_scope {required}&lt;br&gt;route quên khai → 500 (đóng mặc định)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;project-scope.guard.ts:62-73  ·  roles.ts:21-27&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="970" y="150" width="270" height="215" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="principal {user, isOperator}" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="scopes[]" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Từ chối ở cổng ①&lt;/b&gt;&lt;br&gt;thiếu cookie → 401 unauthenticated · JWT/session hết hạn hoặc bị thu hồi → 401 session_expired · sai CSRF → 403 csrf_failed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="270" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Từ chối ở cổng ②&lt;/b&gt;&lt;br&gt;thiếu projectId → 400 project_required · không phải UUID, project không có, không là thành viên → 404 (không bao giờ 403)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="270" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Từ chối ở cổng ③&lt;/b&gt;&lt;br&gt;403 missing_scope  ·  500 scope_not_declared" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="970" y="380" width="270" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Operator đi qua viaOperator → MỖI request ghi audit_logs &amp;#x27;operator.access&amp;#x27; TRƯỚC khi handler chạy&lt;/b&gt;&lt;br&gt;(cũng ghi khi xin vé socket) — chi tiết ở trang 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="465" width="590" height="54" as="geometry"/></mxCell><mxCell id="c26" value="viaOperator" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="c14" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;OperatorGuard (route riêng operator)&lt;/b&gt;&lt;br&gt;không phải operator → 403 operator_required (owner cũng bị)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="270" height="62" as="geometry"/></mxCell><mxCell id="c28" value="route @UseGuards(OperatorGuard)" style="endArrow=classic;html=1;rounded=0;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="c13" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Đường MÁY — service cầm API key hk_*  (/v1/p/:project/*, connection string)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="550" width="1260" height="175" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Service / backend&lt;/b&gt;&lt;br&gt;Authorization: Bearer hk_test_… | hk_live_…&lt;br&gt;scope gắn với KEY, không theo người" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="250" height="90" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;ApiKeyGuard&lt;/b&gt;&lt;br&gt;regex hk_(test|live)_…, tra sha256(key) ở DB&lt;br&gt;sai định dạng / không có hash / đã revoke → 401 invalid_api_key&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;api-key.guard.ts:36-42&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="585" width="270" height="110" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Slug project của KEY ≠ :project trên path&lt;/b&gt;&lt;br&gt;→ 404 not_found (cùng body, không dò được project khác)&lt;br&gt;tenant = tenant của key&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;api-key.guard.ts:44&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="585" width="270" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;@RequireScope&lt;/b&gt;&lt;br&gt;scope cần ∈ key.scopes? thiếu → 403 missing_scope {required}&lt;br&gt;key chỉ cấp: publish:events, read:events, manage:endpoints, manage:sources, read:unverified (trang 2)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;api-key.guard.ts:46-52&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="970" y="585" width="270" height="110" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="key hợp lệ" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="tenantId của key" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="Đường PROVIDER — ingest /hooks/:provider/…  (không có người dùng, không có scope)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="740" width="1260" height="150" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Provider gọi vào&lt;/b&gt;&lt;br&gt;PayOS · SePay · GitHub · Stripe · generic&lt;br&gt;(webhook)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="250" height="90" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Chữ ký của provider trên body_raw&lt;/b&gt;&lt;br&gt;ProviderAdapter.verify, so bằng timingSafeEqual&lt;br&gt;sai → 401 (ack theo định dạng provider)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;ingest.controller.ts:11  ·  ingest.service.ts:746&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="770" width="270" height="105" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Tenant suy ra từ SOURCE&lt;/b&gt;&lt;br&gt;tra source → tenant_id bằng systemTx (app.rls_system=on), rồi chuyển hẳn sang tenantTx / forTenant&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;prisma.service.ts:819-842&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="770" width="270" height="105" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;@PublicRoute — không có scope&lt;/b&gt;&lt;br&gt;xác thực bằng chữ ký, không theo role/key/user&lt;br&gt;COMMIT xong mới ACK 2xx (BB-3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="970" y="770" width="270" height="105" as="geometry"/></mxCell><mxCell id="c42" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="chữ ký hợp lệ" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="Đường HỆ THỐNG — không theo người dùng, mỗi cơ chế một bí mật riêng" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="15" y="905" width="1260" height="380" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Prometheus scrape&lt;/b&gt;&lt;br&gt;GET /metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="250" height="62" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;METRICS_TOKEN&lt;/b&gt;&lt;br&gt;đặt thì bắt buộc Bearer, so timingSafeCompare → sai 401 metrics_unauthorized; để trống (local) = mở&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;metrics.controller.ts:10-31  ·  hmac.ts:36-41&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="940" width="270" height="72" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Số liệu GỘP, không theo tenant&lt;/b&gt;&lt;br&gt;@PublicRoute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="940" width="270" height="72" as="geometry"/></mxCell><mxCell id="c49" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Web (Next.js proxy)&lt;/b&gt;&lt;br&gt;chuyển request tới hub-api" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="250" height="62" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;WEB_PROXY_SECRET (≥ 32 ký tự)&lt;/b&gt;&lt;br&gt;chỉ để TIN header IP client x-hub-client-ip; KHÔNG phải xác thực người dùng. Không đặt = tắt&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;client-ip.ts:26  ·  proxy.ts:13&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="1025" width="270" height="80" as="geometry"/></mxCell><mxCell id="c53" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Trình duyệt mở Socket.IO&lt;/b&gt;&lt;br&gt;xin vé GET /auth/socket-ticket" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="1125" width="250" height="62" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Vé socket (JWT ngắn hạn)&lt;/b&gt;&lt;br&gt;cấp bởi cùng luật resolveProjectScope + đòi read:project; kết nối: vé + session còn sống + còn là thành viên (operator luôn được) — kiểm lại định kỳ, mất quyền → ngắt&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;socket-ticket.service.ts:22-38  ·  realtime.gateway.ts:221,250-266&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="1120" width="270" height="105" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Room theo project&lt;/b&gt;&lt;br&gt;operator → room ops của project; owner → room owners (cảnh báo dung lượng)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;realtime.gateway.ts:185,299&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="650" y="1120" width="270" height="105" as="geometry"/></mxCell><mxCell id="c57" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;INTERNAL_TOKEN (X-Internal-Token) chỉ có ở apps/shop /api/internal/reconcile (timingSafeCompare) — hub-api/hub-worker KHÔNG dùng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="1235" width="850" height="34" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;TẦNG DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;br&gt;BB-5: mọi bảng nghiệp vụ có tenant_id; mọi truy vấn qua TenantScopedRepository (forTenant / tenantTx, đặt app.project_id)&lt;br&gt;&lt;br&gt;Postgres RLS: policy tenant_isolation, ENABLE + FORCE ROW LEVEL SECURITY — cả owner không BYPASSRLS cũng bị lọc&lt;br&gt;&lt;br&gt;Role runtime hub_app: NOSUPERUSER, NOBYPASSRLS. App từ chối khởi động nếu DATABASE_URL là superuser/BYPASSRLS&lt;br&gt;&lt;br&gt;Role owner (DIRECT_URL): chỉ migrate và seed&lt;br&gt;&lt;br&gt;Đường xuyên project DUY NHẤT: systemTx (app.rls_system=on), chỉ nằm trong prisma.service.ts — dùng cho ingest (tra source), cleanup, thống kê &amp;#x27;Tất cả dự án&amp;#x27;&lt;br&gt;&lt;br&gt;Quên scope tenant ⇒ RLS trả 0 dòng, không rò dữ liệu&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;tenant-scoped.repository.ts  ·  prisma.service.ts:104-110,819-842,955-962  ·  ensure-app-role.ts  ·  migration *_source_connections:37-41&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1290" y="105" width="300" height="785" as="geometry"/></mxCell><mxCell id="c61" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c33" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c40" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c48" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c56" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="tenantId đã chốt" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1610" y="105" width="250" height="220" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1618" y="109" width="230" height="20" as="geometry"/></mxCell><mxCell id="c69" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="135" width="22" height="16" as="geometry"/></mxCell><mxCell id="c70" value="Chủ thể (ai gọi)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="133" width="205" height="22" as="geometry"/></mxCell><mxCell id="c71" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="163" width="22" height="16" as="geometry"/></mxCell><mxCell id="c72" value="Cổng xác thực" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="161" width="205" height="22" as="geometry"/></mxCell><mxCell id="c73" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="191" width="22" height="16" as="geometry"/></mxCell><mxCell id="c74" value="Cổng project (thuộc project nào)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="189" width="205" height="22" as="geometry"/></mxCell><mxCell id="c75" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="219" width="22" height="16" as="geometry"/></mxCell><mxCell id="c76" value="Cổng scope (được làm gì)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="217" width="205" height="22" as="geometry"/></mxCell><mxCell id="c77" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="247" width="22" height="16" as="geometry"/></mxCell><mxCell id="c78" value="Tầng dữ liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="245" width="205" height="22" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="275" width="22" height="16" as="geometry"/></mxCell><mxCell id="c80" value="Đặc quyền / dấu vết operator" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="273" width="205" height="22" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1620" y="303" width="22" height="16" as="geometry"/></mxCell><mxCell id="c82" value="Ghi chú, ngoại lệ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="301" width="205" height="22" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;Đọc nhanh:&lt;/b&gt;&lt;br&gt;• Người và máy dùng MỘT ngôn ngữ quyền: scope. Role chỉ là bó scope có tên (roles.ts).&lt;br&gt;• &amp;#x27;Không thuộc project&amp;#x27; luôn là 404 để không lộ project nào tồn tại (cả đường người lẫn đường key).&lt;br&gt;• Thứ tự lỗi: 401 → 404 → 403 (hai guard khớp nhau).&lt;br&gt;• Operator = cờ trên NGƯỜI, không phải role; không có API hay UI nào bật cờ (trang 3).&lt;br&gt;• Cổng dữ liệu độc lập với cổng ứng dụng: guard sót vẫn bị RLS chặn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1610" y="360" width="260" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="2. Ma trận scope"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;2 · Ma trận scope × chủ thể&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#444444&quot;&gt;Nguồn: roles.ts (ROLE_SCOPES) và api-key.ts (API_SCOPES). Role là bó scope lồng nhau viewer ⊂ developer ⊂ owner. Operator không là thành viên = owner (viaOperator); operator LÀ thành viên = role thật, không đặc cách.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1720" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Scope&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="190" height="52" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;viewer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220" y="90" width="90" height="52" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;developer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="310" y="90" width="100" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;owner&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="90" height="52" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Operator&lt;br&gt;(viaOperator)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="120" height="52" as="geometry"/></mxCell><m