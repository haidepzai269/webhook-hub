"&lt;b&gt;q.normalize&lt;/b&gt;&lt;br&gt;DLX = x.hub.normalize.dlx" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="200" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;NormalizeConsumer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="190" height="60" as="geometry"/></mxCell><mxCell id="c7" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="event.received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;x.hub.normalize.dlx&lt;/b&gt;&lt;br&gt;direct" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="200" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;q.normalize.dlq&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="190" height="60" as="geometry"/></mxCell><mxCell id="c12" value="nack(requeue=false)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;x.hub.delivery&lt;/b&gt;&lt;br&gt;direct" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="440" width="190" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;q.delivery.main&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="445" width="200" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;DeliveryConsumer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="445" width="190" height="60" as="geometry"/></mxCell><mxCell id="c17" value="publish deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="160"/><mxPoint x="1050" y="365"/><mxPoint x="355" y="365"/></Array></mxGeometry></mxCell><mxCell id="c18" value="deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="5 tầng retry (messageTtl)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1100" y="370" width="300" height="420" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;q.delivery.retry.10s&lt;/b&gt;&lt;br&gt;TTL 10s · lần 1" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="405" width="260" height="55" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;q.delivery.retry.1m&lt;/b&gt;&lt;br&gt;TTL 1 phút · lần 2" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="260" height="55" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;q.delivery.retry.5m&lt;/b&gt;&lt;br&gt;TTL 5 phút · lần 3" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="555" width="260" height="55" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;q.delivery.retry.30m&lt;/b&gt;&lt;br&gt;TTL 30 phút · lần 4" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="630" width="260" height="55" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;q.delivery.retry.2h&lt;/b&gt;&lt;br&gt;TTL 2 giờ · lần 5" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="705" width="260" height="55" as="geometry"/></mxCell><mxCell id="c26" value="sendToQueue&lt;br&gt;(theo attempt)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;span style='color:#1f4e8c'&gt;↑ hết TTL → DLX = x.hub.delivery, key deliver&lt;br&gt;(tự quay lại q.delivery.main)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="330" height="40" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c25" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="732"/><mxPoint x="1070" y="545"/><mxPoint x="355" y="545"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;x.hub.delivery.dlx&lt;/b&gt;&lt;br&gt;direct" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="590" width="190" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;q.delivery.dlq&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="830" y="700" width="190" height="55" as="geometry"/></mxCell><mxCell id="c31" value="DEAD (4xx / hết tầng)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c16" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Quy tắc&lt;/b&gt;&lt;br&gt;• Mọi exchange/queue &lt;b&gt;durable&lt;/b&gt;, khai báo idempotent khi app khởi động&lt;br&gt;• RETRY_TIERS tự assert sắp &lt;b&gt;tăng dần&lt;/b&gt; theo TTL lúc load module&lt;br&gt;• Circuit OPEN → nhảy thẳng tầng &lt;b&gt;dài nhất&lt;/b&gt; (tìm theo TTL lớn nhất, không theo vị trí mảng)&lt;br&gt;• Throttle hết token → tầng &lt;b&gt;ngắn nhất&lt;/b&gt; (10s)&lt;br&gt;• ⚠️ Đổi TTL của queue đã tồn tại → &lt;b&gt;PRECONDITION_FAILED&lt;/b&gt;: xoá queue trước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="440" height="230" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Từ DLQ đi đâu?&lt;/b&gt; Dashboard → POST /api/v1/deliveries/:id/replay → tạo delivery mới với &lt;b&gt;attempt_generation + 1&lt;/b&gt;, publish lại vào x.hub.delivery. Lịch sử cũ giữ nguyên, ghi audit_logs." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="790" width="530" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. Máy trạng thái"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:20px"&gt;6 · Máy trạng thái: Delivery · Circuit breaker · Order (Shop)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#555"&gt;Chuyển trạng thái không hợp lệ bị từ chối ở tầng service.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1560" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Delivery (hub.deliveries.status)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="760" height="520" as="geometry"/></mxCell><mxCell id="c4" value="PENDING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="150" height="55" as="geometry"/></mxCell><mxCell id="c5" value="DELIVERING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="150" height="55" as="geometry"/></mxCell><mxCell id="c6" value="SUCCEEDED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="150" height="55" as="geometry"/></mxCell><mxCell id="c7" value="RETRYING&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;hết TTL → về DELIVERING&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="150" height="55" as="geometry"/></mxCell><mxCell id="c8" value="DEAD" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="150" height="55" as="geometry"/></mxCell><mxCell id="c9" value="consumer nhận" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="2xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="5xx · 408 · 429&lt;br&gt;timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;exitX=0.6;exitY=0;entryX=0.6;entryY=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="4xx (≠408/429)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="265"/><mxPoint x="675" y="265"/></Array></mxGeometry></mxCell><mxCell id="c14" value="quá tầng 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="REPLAY: attempt_generation + 1&lt;br&gt;→ bản ghi MỚI · audit_logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Vì sao replay không đụng UNIQUE?&lt;/b&gt; Ràng buộc là &lt;b&gt;UNIQUE(event_id, subscription_id, attempt_generation)&lt;/b&gt; — bản gốc dùng (event_id, subscription_id) thì replay = vi phạm unique = chết. Mỗi lần replay là một generation mới; lịch sử các lần trước còn nguyên trong delivery_attempts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="720" height="100" as="geometry"/></mxCell><mxCell id="c17" value="Circuit breaker — theo từng destination, lưu ở Redis" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="760" height="520" as="geometry"/></mxCell><mxCell id="c18" value="CLOSED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="150" height="55" as="geometry"/></mxCell><mxCell id="c19" value="OPEN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="150" height="55" as="geometry"/></mxCell><mxCell id="c20" value="HALF_OPEN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="350" width="150" height="55" as="geometry"/></mxCell><mxCell id="c21" value="≥ 5 lỗi liên tiếp&lt;br&gt;SET :state OPEN EX 60 · bắn alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="60s trôi qua&lt;br&gt;(:state hết hạn)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;exitX=0.25;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1397" y="366"/></Array></mxGeometry></mxCell><mxCell id="c23" value="gửi thành công&lt;br&gt;DEL :failures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c20" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="thất bại → mở lại ngay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=1;exitY=0.75;entryX=0.75;entryY=1;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1472" y="391"/></Array></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;⚠️ Đối chiếu code (circuit-breaker.service.ts):&lt;/b&gt; HALF_OPEN không được lưu riêng — khi key &lt;b&gt;:state&lt;/b&gt; hết hạn, getState() trả CLOSED; bộ đếm &lt;b&gt;:failures&lt;/b&gt; vẫn ≥ 5 nên chỉ cần 1 lỗi là OPEN lại. Khác doc §5.4: trong cửa sổ đó &lt;b&gt;mọi&lt;/b&gt; message đều được gửi, không phải đúng 1 request thử.&lt;br&gt;&lt;b&gt;Redis chết →&lt;/b&gt; fail-open (coi như CLOSED) + log cảnh báo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="720" height="140" as="geometry"/></mxCell><mxCell id="c26" value="Order — thuộc apps/shop, Hub KHÔNG biết (BB-1)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="760" height="320" as="geometry"/></mxCell><mxCell id="c27" value="PENDING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="730" width="140" height="50" as="geometry"/></mxCell><mxCell id="c28" value="PAID" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="730" width="140" height="50" as="geometry"/></mxCell><mxCell id="c29" value="UNDERPAID" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="665" width="150" height="50" as="geometry"/></mxCell><mxCell id="c30" value="EXPIRED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="150" height="50" as="geometry"/></mxCell><mxCell id="c31" value="CANCELLED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="830" width="140" height="50" as="geometry"/></mxCell><mxCell id="c32" value="đủ tiền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="thiếu tiền" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="trả bù" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c29" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="quá hạn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.4;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="huỷ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;exitX=0.75;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="930"/><mxPoint x="630" y="930"/></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Cặp khái niệm trình bày cùng nhau (ADR-016)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Throttle&lt;/b&gt; = &lt;i&gt;phòng ngừa&lt;/i&gt;: giữ nhịp để không làm đích quá tải (token bucket theo destination.rate_limit_rps)&lt;br&gt;• &lt;b&gt;Circuit breaker&lt;/b&gt; = &lt;i&gt;phản ứng&lt;/i&gt;: đích ĐÃ hỏng thì ngừng đập vào nó&lt;br&gt;Thiếu throttle: scale worker lên 5 sẽ bắn gấp 5 lần vào một đích yếu → tự tạo ra sự cố mà circuit breaker phải đi dọn." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="760" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Mô hình dữ liệu (schema hub)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:20px"&gt;7 · Mô hình dữ liệu — schema hub (libs/database/prisma/schema.prisma)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#555"&gt;Xanh = bảng nghiệp vụ mang tenant_id, chỉ truy cập qua TenantScopedRepository (BB-5). Xám = bảng hạ tầng.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1610" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:13px'&gt;sources&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;provider (payos|sepay|github|stripe)&lt;br&gt;name&lt;br&gt;🔑 source_key UNIQUE (nằm trong URL)&lt;br&gt;is_active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="270" height="170" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:13px'&gt;source_secrets&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;source_id FK&lt;br&gt;secret_encrypted (AES-GCM)&lt;br&gt;version&lt;br&gt;valid_from · valid_until&lt;br&gt;&lt;i&gt;nhiều secret = xoay khoá không gián đoạn&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="270" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;raw_events&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;source_id FK&lt;br&gt;idempotency_key&lt;br&gt;headers jsonb · body jsonb&lt;br&gt;&lt;b&gt;body_raw bytea&lt;/b&gt; ← HMAC tính trên đây&lt;br&gt;signature_valid&lt;br&gt;status ACCEPTED|REJECTED|DUPLICATE&lt;br&gt;origin&lt;br&gt;received_at&lt;br&gt;🔑 &lt;b&gt;② UNIQUE(source_id, idempotency_key)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="270" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;outbox&lt;/b&gt;&lt;hr&gt;id bigserial PK&lt;br&gt;topic = event.received&lt;br&gt;payload {rawEventId, tenantId…}&lt;br&gt;published_at (NULL = chưa gửi)&lt;br&gt;attempts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="270" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;processed_messages&lt;/b&gt;&lt;hr&gt;consumer&lt;br&gt;message_id&lt;br&gt;🔑 &lt;b&gt;⑤ PK(consumer, message_id)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="600" width="270" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;events  (chuẩn hoá, kiểu CloudEvents)&lt;/b&gt;&lt;hr&gt;id ULID PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;raw_event_id FK &lt;i&gt;NULL nếu phái sinh&lt;/i&gt;&lt;br&gt;parent_event_id&lt;br&gt;🔑 &lt;b&gt;③ idempotency_key UNIQUE&lt;/b&gt;&lt;br&gt;correlation_id&lt;br&gt;type (vd. payment.succeeded)&lt;br&gt;source · subject&lt;br&gt;data jsonb&lt;br&gt;origin webhook|replay|derived|reconciliation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="290" height="270" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;deliveries&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;event_id FK&lt;br&gt;subscription_id FK&lt;br&gt;&lt;b&gt;attempt_generation&lt;/b&gt;&lt;br&gt;status PENDING…DEAD&lt;br&gt;attempt_count · next_attempt_at&lt;br&gt;last_error&lt;br&gt;🔑 &lt;b&gt;④ UNIQUE(event_id, subscription_id,&lt;br&gt;attempt_generation)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="90" width="270" height="270" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;delivery_attempts&lt;/b&gt;&lt;hr&gt;id bigserial PK&lt;br&gt;delivery_id FK&lt;br&gt;attempt_no&lt;br&gt;request_body&lt;br&gt;response_status · response_body (≤2KB)&lt;br&gt;duration_ms · error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="420" width="270" height="180" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;subscriptions&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;destination_id FK&lt;br&gt;event_types text[]&lt;br&gt;template&lt;br&gt;is_active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="90" width="270" height="170" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;destinations&lt;/b&gt;&lt;hr&gt;id uuid PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;type webhook|telegram|discord&lt;br&gt;config_encrypted&lt;br&gt;signing_secret_encrypted&lt;br&gt;rate_limit_rps (throttle)&lt;br&gt;circuit_state&lt;br&gt;alert_on_open" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="270" height="210" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;audit_logs&lt;/b&gt;&lt;hr&gt;id bigserial PK&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt;&lt;br&gt;action (vd. REPLAY)&lt;br&gt;entity_type · entity_id&lt;br&gt;actor · reason&lt;br&gt;metadata" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="600" width="270" height="150" as="geometry"/></mxCell><mxCell id="c14" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="0..1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c8" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="payload.rawEventId&lt;br&gt;(không FK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;5 chốt idempotency (§5.2)&lt;/b&gt;&lt;br&gt;① &lt;b&gt;Redis&lt;/b&gt; idem:{src}:{key} EX 86400 — đường tắt, &lt;i&gt;được phép sai&lt;/i&gt;&lt;br&gt;② &lt;b&gt;raw_events&lt;/b&gt; UNIQUE(source_id, idempotency_key) — &lt;b&gt;trọng tài&lt;/b&gt; (BB-2): provider gửi trùng&lt;br&gt;③ &lt;b&gt;events&lt;/b&gt; UNIQUE(idempotency_key) — chặn sự kiện phái sinh trùng (key = sha256(parentEventId:type))&lt;br&gt;④ &lt;b&gt;deliveries&lt;/b&gt; UNIQUE(event_id, subscription_id, attempt_generation) — chặn fan-out trùng, &lt;b&gt;vẫn cho replay&lt;/b&gt;&lt;br&gt;⑤ &lt;b&gt;processed_messages&lt;/b&gt; PK(consumer, message_id) — consumer nhận lại message không gây tác dụng phụ&lt;br&gt;&lt;b&gt;→ at-least-once + idempotent consumer = effectively-once&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="900" height="210" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Schema shop&lt;/b&gt; (orders: order_code UNIQUE, amount, paid_amount, status, version — optimistic lock) nằm cùng database nhưng &lt;b&gt;Hub không bao giờ đọc&lt;/b&gt;. Shop chỉ nhận sự kiện qua HTTP như mọi đích khác." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="560" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8. Gãy rồi tự lành"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;8 · Gãy rồi tự lành — kịch bản demo chaos (chạy trên LOCAL docker-compose, ADR-019)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;Mỗi cột: sự cố → hệ thống phản ứng → kết quả quan sát được. Không cột nào kết thúc bằng 'mất sự kiện'.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;💥 PostgreSQL chết&lt;br&gt;giữa lúc ingest&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="315" height="80" as="geometry"/></mxCell><mxCell id="c4" value="Transaction lỗi → ROLLBACK → trả &lt;b&gt;500&lt;/b&gt;&lt;br&gt;Redis &lt;b&gt;chưa&lt;/b&gt; SET (SET nằm sau COMMIT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="315" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Provider tự retry → PG sống lại → lần sau ghi được.&lt;br&gt;&lt;b&gt;Không mất · không nhầm duplicate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="315" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cách demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;docker compose stop postgres&lt;br&gt;bắn webhook → 500&lt;br&gt;docker compose start postgres&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="315" height="100" as="geometry"/></mxCell><mxCell id="c7" value="hệ thống phản ứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;💥 Redis chết&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="355" y="100" width="315" height="80" as="geometry"/></mxCell><mxCell id="c10" value="Rate limit fail-open · GET idem trả null&lt;br&gt;circuit breaker coi như CLOSED&lt;br&gt;→ mọi request đi thẳng xuống PG" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="230" width="315" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Chậm đi, không sai.&lt;/b&gt;&lt;br&gt;Gửi trùng vẫn bị UNIQUE ② ở PG chặn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="355" y="400" width="315" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Cách demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;docker compose stop redis&lt;br&gt;bắn cùng 1 webhook 2 lần&lt;br&gt;→ lần 2 vẫn 200 duplicate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="355" y="560" width="315" height="100" as="geometry"/></mxCell><mxCell id="c13" value="hệ thống phản ứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style='font-size:14px'&gt;💥 RabbitMQ chết&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="315" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Ingest vẫn &lt;b&gt;200&lt;/b&gt; (chỉ ghi PG)&lt;br&gt;Relay publish lỗi → ROLLBACK&lt;br&gt;outbox giữ published_at = NULL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="230" width="315" height="120" as="geometry"/></mxCell><mxCell id="c17" value="Rabbit lên lại → relay đẩy bù toàn bộ.&lt;br&gt;&lt;b&gt;Nhận vẫn chạy khi xử lý chết&lt;/b&gt; — lý do tách 2 hop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="400" width="315" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Cách demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;docker compose stop rabbitmq&lt;br&gt;bắn 10 webhook → đều 200&lt;br&gt;start lại → 10 sự kiện chảy tiếp&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="690" y="560" width="315" height="100" as="geometry"/></mxCell><mxCell id="c19" value="hệ thống phản ứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b style='font-size:14px'&gt;💥 Worker bị kill&lt;br&gt;giữa chừng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1025" y="100" width="315" height="80" as="geometry"/></mxCell><mxCell id="c22" value="Message chưa ack → RabbitMQ trả về queue&lt;br&gt;worker khác nhận lại&lt;br&gt;processed_messages ⑤ chặn xử lý 2 lần" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="230" width="315" height="120" as="geometry"/></mxCell><mxCell id="c23" value="Không mất, không gửi trùng.&lt;br&gt;Tắt êm: SIGTERM → chờ in-flight ≤ &lt;b&gt;25s&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="400" width="315" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Cách demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;docker compose up --scale hub-worker=3&lt;br&gt;docker kill &amp;lt;1 worker&amp;gt;&lt;br&gt;xem dashboard vẫn chạy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1025" y="560" width="315" height="100" as="geometry"/></mxCell><mxCell id="c25" value="hệ thống phản ứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b style='font-size:14px'&gt;💥 Đích (Discord) chết&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1360" y="100" width="315" height="80" as="geometry"/></mxCell><mxCell id="c28" value="5xx → retry 10s → 1m → 5m…&lt;br&gt;≥ 5 lỗi → circuit &lt;b&gt;OPEN&lt;/b&gt; 60s + alert&lt;br&gt;message nhảy tầng retry dài nhất" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="230" width="315" height="120" as="geometry"/></mxCell><mxCell id="c29" value="Hết 5 tầng → &lt;b&gt;DEAD&lt;/b&gt; → DLQ&lt;br&gt;Đích sống lại → &lt;b&gt;Replay&lt;/b&gt; từ dashboard (generation + 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="315" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Cách demo&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;cho /mock/discord trả 500&lt;br&gt;xem delivery RETRYING → DEAD&lt;br&gt;sửa lại → bấm Replay → SUCCEEDED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1360" y="560" width="315" height="100" as="geometry"/></mxCell><mxCell id="c31" value="hệ thống phản ứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="kết quả" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Thông điệp cho hội đồng:&lt;/b&gt; độ tin cậy không đến từ việc &lt;i&gt;không có gì hỏng&lt;/i&gt;, mà từ việc &lt;b&gt;mỗi thành phần hỏng đều có chỗ để rơi vào&lt;/b&gt;: PostgreSQL giữ sự thật, outbox giữ thứ chưa gửi, RabbitMQ giữ thứ chưa xử lý xong, DLQ giữ thứ không gửi được, replay đưa nó về. Redis là thứ duy nhất được phép mất — và mất nó chỉ làm hệ thống chậm đi." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="1660" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>