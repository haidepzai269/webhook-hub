<mxfile host="drawio" type="device"><diagram id="p1" name="1. Bối cảnh hệ thống"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;1 · Bối cảnh hệ thống (C4 mức 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;Hub đứng giữa: nhận webhook từ mọi provider, giao lại cho mọi đích. Hub KHÔNG biết 'đơn hàng' là gì (BB-1).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;PayOS&lt;/b&gt;&lt;br&gt;thanh toán QR (VN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;SePay&lt;/b&gt;&lt;br&gt;biến động số dư ngân hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="220" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;push · PR · issue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;thanh toán quốc tế" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:18px'&gt;WEBHOOK HUB&lt;/b&gt;&lt;br&gt;&lt;br&gt;① nhận + xác thực chữ ký HMAC&lt;br&gt;② lưu bền (PostgreSQL) rồi mới trả 200&lt;br&gt;③ chuẩn hoá thành sự kiện chung&lt;br&gt;④ định tuyến theo subscription&lt;br&gt;⑤ giao lại · retry · DLQ · replay&lt;br&gt;&lt;br&gt;&lt;i&gt;Generic: thêm provider = thêm 1 adapter&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="420" height="260" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Discord&lt;/b&gt;&lt;br&gt;kênh thông báo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="260" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;bot nhắn tin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="210" width="260" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Shop demo&lt;/b&gt; POST /hub-webhook&lt;br&gt;(nghiệp vụ đơn hàng nằm ở đây)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="260" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Webhook bất kỳ&lt;/b&gt;&lt;br&gt;URL do khách đăng ký" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="410" width="260" height="70" as="geometry"/></mxCell><mxCell id="c12" value="POST /hooks/:provider/:sourceKey&lt;br&gt;body + chữ ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="HTTP POST ký HMAC&lt;br&gt;(webhook-signature)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="40" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Dashboard&lt;/b&gt; (Next.js)&lt;br&gt;xem sự kiện realtime · DLQ · replay" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="240" height="70" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="REST /api/v1 + Socket.IO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;" edge="1" parent="1" source="c21" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Vòng demo đầu-cuối&lt;/b&gt;&lt;br&gt;1. Khách tạo đơn ở Shop → nhận mã &lt;b&gt;DH123&lt;/b&gt; + QR&lt;br&gt;2. Khách chuyển khoản qua PayOS&lt;br&gt;3. PayOS bắn webhook vào &lt;b&gt;Hub&lt;/b&gt;&lt;br&gt;4. Hub chuẩn hoá → &lt;i&gt;payment.succeeded&lt;/i&gt; → giao cho Shop + Discord&lt;br&gt;5. &lt;b&gt;Shop&lt;/b&gt; tự tìm mã DH123 trong sự kiện → đơn PAID&lt;br&gt;&lt;i&gt;→ Hub chỉ chở sự kiện, Shop mới hiểu đơn hàng.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="440" height="170" as="geometry"/></mxCell><mxCell id="c25" value="Chú giải" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="260" height="200" as="geometry"/></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="590" width="28" height="20" as="geometry"/></mxCell><mxCell id="c27" value="Provider (nguồn gửi webhook)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="590" width="200" height="22" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="617" width="28" height="20" as="geometry"/></mxCell><mxCell id="c29" value="Webhook Hub (code của ta)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="617" width="200" height="22" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="644" width="28" height="20" as="geometry"/></mxCell><mxCell id="c31" value="Đích nhận" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="644" width="200" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="671" width="28" height="20" as="geometry"/></mxCell><mxCell id="c33" value="Kho dữ liệu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="671" width="200" height="22" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="698" width="28" height="20" as="geometry"/></mxCell><mxCell id="c35" value="Thành công / đường tắt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="698" width="200" height="22" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1112" y="725" width="28" height="20" as="geometry"/></mxCell><mxCell id="c37" value="Lỗi · DLQ · DEAD" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1148" y="725" width="200" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Thành phần &amp; tiến trình"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:20px"&gt;2 · Thành phần &amp; tiến trình (C4 mức 2)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#555"&gt;hub-api và hub-worker là HAI tiến trình tách rời (BB-4) — scale độc lập: docker compose up --scale hub-worker=3&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1640" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Provider&lt;/b&gt;&lt;br&gt;PayOS · SePay · GitHub · Stripe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="170" height="70" as="geometry"/></mxCell><mxCell id="c4" value="hub-api (NestJS) — chỉ nhận · p95 &lt; 100ms" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="380" height="380" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;IngestController&lt;/b&gt;&lt;br&gt;POST /hooks/:provider/:sourceKey (rawBody)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="340" height="55" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;IngestService&lt;/b&gt;&lt;br&gt;verify → TX(raw_events + outbox) → COMMIT → 200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="215" width="340" height="55" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ProviderRegistry&lt;/b&gt;&lt;br&gt;PayOS · SePay · GitHub · Stripe adapter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="295" width="340" height="55" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;/api/v1 · /auth&lt;/b&gt;&lt;br&gt;REST + JWT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="385" width="160" height="55" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;RealtimeGateway&lt;/b&gt;&lt;br&gt;Socket.IO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430" y="385" width="160" height="55" as="geometry"/></mxCell><mxCell id="c10" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="adapter.verify()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;schema &lt;b&gt;hub&lt;/b&gt; + &lt;b&gt;shop&lt;/b&gt;&lt;br&gt;&lt;i&gt;trọng tài idempotency&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="110" width="200" height="130" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;RabbitMQ 3&lt;/b&gt;&lt;br&gt;exchanges · queues&lt;br&gt;retry TTL · DLQ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="380" width="200" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Dây nối với hub-worker&lt;/b&gt;&lt;br&gt;━ đậm: publish &lt;i&gt;event.received&lt;/i&gt;, &lt;i&gt;deliver&lt;/i&gt;&lt;br&gt;─ mảnh: consume &lt;i&gt;q.normalize&lt;/i&gt;, &lt;i&gt;q.delivery.main&lt;/i&gt;&lt;br&gt;PostgreSQL ← relay đọc outbox · normalize ghi events/deliveries" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="690" y="510" width="260" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Redis 7&lt;/b&gt;&lt;br&gt;idem · rate limit&lt;br&gt;circuit · pub/sub&lt;br&gt;&lt;i&gt;được phép sai&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="690" y="640" width="200" height="120" as="geometry"/></mxCell><mxCell id="c17" value="TX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#000000;strokeWidth=2;exitX=1;exitY=0.3;entryX=0;entryY=0.6;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="GET/SET idem&lt;br&gt;rate limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.35;" edge="1" parent="1" source="c6" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="259"/><mxPoint x="650" y="682"/></Array></mxGeometry></mxCell><mxCell id="c19" value="SUBSCRIBE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;exitX=0;exitY=0.7;entryX=0.5;entryY=1;" edge="1" parent="1" source="c16" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="724"/><mxPoint x="630" y="490"/><mxPoint x="510" y="490"/></Array></mxGeometry></mxCell><mxCell id="c20" value="hub-worker (NestJS) — xử lý · chạy N bản"