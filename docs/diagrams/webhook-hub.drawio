eometry></mxCell><mxCell id="c14" value="OK · hoặc 429 · Redis chết → fail-open" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#6c8ebf;fontColor=#1f4e8c;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="323" as="sourcePoint"/><mxPoint x="400" y="323" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;③&lt;/b&gt; nạp source + secrets (giải mã AES-GCM)" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="375" as="sourcePoint"/><mxPoint x="980" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;④&lt;/b&gt; adapter.verify(&lt;b&gt;body_raw&lt;/b&gt;, headers, secrets[])&lt;br&gt;so sánh bằng crypto.timingSafeEqual" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="408" y="415" width="270" height="48" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;⑤&lt;/b&gt; key = adapter.extractIdempotencyKey()&lt;br&gt;vd. payos:{orderCode}:{reference}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="408" y="477" width="270" height="48" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;⑥&lt;/b&gt; GET idem:{sourceId}:{key} — &lt;i&gt;chỉ ĐỌC&lt;/i&gt;" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="551" as="sourcePoint"/><mxPoint x="690" y="551" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="hit → trả &lt;b&gt;200 duplicate&lt;/b&gt; ngay, không chạm DB" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="690" y="603" as="sourcePoint"/><mxPoint x="400" y="603" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;⑦&lt;/b&gt; BEGIN" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="663" as="sourcePoint"/><mxPoint x="980" y="663" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="INSERT raw_events  — &lt;b&gt;UNIQUE(source_id, idempotency_key)&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="715" as="sourcePoint"/><mxPoint x="980" y="715" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="INSERT outbox (topic = event.received, payload = {rawEventId…})" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="767" as="sourcePoint"/><mxPoint x="980" y="767" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;COMMIT&lt;/b&gt;" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#000000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="819" as="sourcePoint"/><mxPoint x="980" y="819" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="OK — sự kiện đã nằm trên đĩa" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="871" as="sourcePoint"/><mxPoint x="400" y="871" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="641" width="660" height="270" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;br&gt;raw_events + outbox&lt;br&gt;cùng sống / cùng chết" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="1030" y="645" width="230" height="60" as="geometry"/></mxCell><mxCell id="c27" value="" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;endArrow=none;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="921" as="sourcePoint"/><mxPoint x="1050" y="921" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b style='color:#b85450'&gt;━━ BB-3: chỉ từ dòng này trở xuống mới được trả 2xx ━━&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="895" width="600" height="24" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;⑧&lt;/b&gt; SET idem:{sourceId}:{key} EX 86400 — &lt;i&gt;SAU COMMIT, lỗi thì mặc kệ&lt;/i&gt;" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="961" as="sourcePoint"/><mxPoint x="690" y="961" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;⑨ 200&lt;/b&gt; — adapter.buildAck() đúng định dạng provider mong đợi" style="html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;strokeColor=#82b366;fontColor=#2d6b2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="1013" as="sourcePoint"/><mxPoint x="110" y="1013" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Sai chữ ký (bước ④)&lt;/b&gt;&lt;br&gt;INSERT raw_events(status=REJECTED) để điều tra&lt;br&gt;→ &lt;b&gt;401&lt;/b&gt;, dừng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="300" height="70" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Lỗi trong transaction (bước ⑦)&lt;/b&gt;&lt;br&gt;• P2002 unique violation → &lt;b&gt;trùng thật&lt;/b&gt; → 200 duplicate&lt;br&gt;• lỗi khác (PG chết…) → ROLLBACK → &lt;b&gt;500&lt;/b&gt;&lt;br&gt;→ provider tự retry, không mất gì" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="300" height="110" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Vì sao Redis SET ở SAU COMMIT?&lt;/b&gt;&lt;br&gt;Nếu SET trước mà PG chết, key vẫn còn → lần retry của provider bị trả '200 duplicate' → sự kiện mất vĩnh viễn." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="300" height="100" as="geometry"/></mxCell><mxCell id="c34" value="❌ Bản ý tưởng gốc — SAI" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1430" y="90" width="300" height="560" as="geometry"/></mxCell><mxCell id="c35" value="1. SET idem NX ở Redis → &lt;b&gt;OK&lt;/b&gt;&lt;br&gt;2. BEGIN&lt;br&gt;3. INSERT raw_events…&lt;br&gt;4. 💥 PostgreSQL chết → ROLLBACK&lt;br&gt;5. Trả 500, provider sẽ retry&lt;br&gt;6. Provider retry cùng sự kiện&lt;br&gt;7. Redis: key ĐÃ CÓ → &lt;b&gt;200 duplicate&lt;/b&gt;&lt;br&gt;8. Provider: &lt;i&gt;'giao xong rồi'&lt;/i&gt;, ngừng retry&lt;br&gt;&lt;br&gt;&lt;b style='color:#b85450'&gt;→ SỰ KIỆN MẤT VĨNH VIỄN.&lt;br&gt;Không log lỗi nào. Không ai biết.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1445" y="125" width="270" height="380" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;✅ Bản đúng (đang chạy)&lt;/b&gt;&lt;br&gt;Redis chỉ ĐỌC trước TX, chỉ GHI sau COMMIT.&lt;br&gt;Redis mất dữ liệu → hệ thống &lt;b&gt;chậm đi, không sai&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1445" y="520" width="270" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. Luồng xử lý 2 hop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;4 · Luồng xử lý đầu-cuối: Ingest → Outbox → Normalize → Deliver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;Tách 'nhận' khỏi 'xử lý'. 2 hop qua RabbitMQ. at-least-once + consumer idempotent = effectively-once.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c3" value="hub-api · INGEST" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="300" height="560" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Provider&lt;/b&gt; gửi webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="55" as="geometry"/></mxCell><mxCell id="c5" value="verify chữ ký → &lt;b&gt;TX&lt;/b&gt;(raw_events + outbox)&lt;br&gt;→ COMMIT → &lt;b&gt;200&lt;/b&gt;&lt;br&gt;&lt;i&gt;(chi tiết: trang 3)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="260" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;hub.outbox&lt;/b&gt;&lt;br&gt;published_at = NULL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="ghi cùng TX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;fontColor=#000000;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="hub-worker · OUTBOX RELAY" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="80" width="320" height="560" as="geometry"/></mxCell><mxCell id="c10" value="tick mỗi ~500ms (± jitter)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="280" height="45" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;BEGIN&lt;/b&gt;&lt;br&gt;SELECT … WHERE published_at IS NULL&lt;br&gt;LIMIT 50 &lt;b&gt;FOR UPDATE SKIP LOCKED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="195" width="280" height="85" as="geometry"/></mxCell><mxCell id="c12" value="publish → &lt;b&gt;x.hub.events&lt;/b&gt;&lt;br&gt;key event.received&lt;br&gt;(chờ publisher confirm)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="310" width="280" height="70" as="geometry"/></mxCell><mxCell id="c13" value="UPDATE published_at = now()&lt;br&gt;&lt;b&gt;COMMIT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="410" width="280" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Vì sao an toàn?&lt;/b&gt;&lt;br&gt;• N worker cùng poll: SKIP LOCKED → mỗi row đúng 1 worker lấy&lt;br&gt;• publish lỗi → ROLLBACK → lần sau gửi lại (at-least-once)&lt;br&gt;• chấp nhận trùng, phía sau đã chặn trùng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor