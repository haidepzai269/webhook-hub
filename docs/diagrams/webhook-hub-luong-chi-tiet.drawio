mxGeometry x="1752" y="453" width="180" height="24" as="geometry"/></mxCell><mxCell id="p40" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="488" width="1" height="1" as="geometry"/></mxCell><mxCell id="p41" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="488" width="1" height="1" as="geometry"/></mxCell><mxCell id="p42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p40" target="p41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p43" value="Redis PUBLISH / SUBSCRIBE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="477" width="180" height="24" as="geometry"/></mxCell><mxCell id="p44" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p45" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p44" target="p45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47" value="message AMQP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="501" width="180" height="24" as="geometry"/></mxCell><mxCell id="p48" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p49" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;endSize=5;" edge="1" parent="1" source="p48" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="HTTP ra / vào bên ngoài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="525" width="180" height="24" as="geometry"/></mxCell><mxCell id="p52" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p53" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;endSize=5;" edge="1" parent="1" source="p52" target="p53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="nhánh lỗi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="Danh mục provider (PK9, ADR-208) — dữ liệu, không phải code" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="520" height="560" as="geometry"/></mxCell><mxCell id="p57" value="&lt;b&gt;catalog/entries/*.json&lt;/b&gt; — &lt;b&gt;31 mục&lt;/b&gt;: 24 config (GenericAdapter) · 4 native (github, payos, sepay, stripe) · 3 unsupported (discord, vnpay, zalopay — đòi trả lời nghiệp vụ đồng bộ)&lt;br&gt;&lt;b&gt;entries-pending/&lt;/b&gt; — 60 mục chờ (blockedBy + lý do), KHÔNG build" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="38" width="500" height="110" as="geometry"/></mxCell><mxCell id="p58" value="npm run catalog:build → kiểm từng mục → sinh &lt;b&gt;catalog.data.ts&lt;/b&gt;. CATALOG kiểm lại lúc import: config qua validateGenericConfig, native có trong ProviderRegistry — sai thì hub-api KHÔNG khởi động" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="162" width="500" height="80" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;GET /api/v1/catalog&lt;/b&gt; (SessionGuard + ProjectScopeGuard, read:project, Cache-Control private 300s) → {entries}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="256" width="500" height="66" as="geometry"/></mxCell><mxCell id="p60" value="&lt;b&gt;identify()&lt;/b&gt; — hàm thuần chạy Ở TRÌNH DUYỆT: dev dán mẫu request → khớp fingerprint (score = khớp/tổng) → gợi ý cấu hình; không khớp → đoán tên kèm bằng chứng. Mẫu KHÔNG BAO GIỜ lên server" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="336" width="500" height="90" as="geometry"/></mxCell><mxCell id="p61" value="Ví dụ mục: shopify (hmac sha256 base64, x-shopify-webhook-id) · slack (signed-template v0:{timestamp}:{body}, afterVerify) · heroku (idempotency path) · pipedrive (static-token basic, path meta.id, chỉ v2) · render/resend/svix (standard-webhooks) · momo, twilio (unverified)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p56"><mxGeometry x="10" y="440" width="500" height="110" as="geometry"/></mxCell><mxCell id="p62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p57" target="p58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="GenericAdapter — sources.verification_config (generic-config.ts)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="560" height="560" as="geometry"/></mxCell><mxCell id="p66" value="&lt;b&gt;scheme&lt;/b&gt; (6): &lt;b&gt;hmac&lt;/b&gt; (algo sha1/sha256/sha512 · hex|base64 · prefix tĩnh hoặc “&amp;lt;algo&amp;gt;=” · keyEncoding) · &lt;b&gt;hmac-sha256&lt;/b&gt; (bí danh cũ) · &lt;b&gt;static-token&lt;/b&gt; (header | basic | query) · &lt;b&gt;standard-webhooks&lt;/b&gt; · &lt;b&gt;signed-template&lt;/b&gt; ({timestamp} {body} {id}, toleranceSec 5..900, verifyAt) · &lt;b&gt;unverified&lt;/b&gt; (PK5)&lt;br&gt;So chữ ký/khoá bằng timingSafeEqual (gate sig-compare trong CI)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p65"><mxGeometry x="10" y="38" width="540" height="130" as="geometry"/></mxCell><mxCell id="p67" value="&lt;b&gt;handshake&lt;/b&gt; (6 kiểu, PK4, ADR-205): query-echo (GET) · body-echo · header-echo · manual-url (SNS) — TRƯỚC verify; hmac-echo (Zoom) và afterVerify — SAU verify; head-ok (HEAD 200 rỗng). Echo chỉ ^[\x21-\x7E]{1,256}, text/plain + nosniff; hub KHÔNG tự gọi URL lấy từ request (SSRF)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p65"><mxGeometry x="10" y="182" width="540" height="110" as="geometry"/></mxCell><mxCell id="p68" value="&lt;b&gt;idempotency&lt;/b&gt; (đúng MỘT dạng, PK10, ADR-230): {header} · {field} cấp một · &lt;b&gt;{path}&lt;/b&gt; 1–3 cấp ^[A-Za-z0-9_-]{1,64}$ (cấm __proto__/prototype/constructor, cấm cấp toàn số) · &lt;b&gt;{bodyHash: true}&lt;/b&gt;&lt;br&gt;khoá: generic:&amp;lt;v&amp;gt; · path thiếu giá trị → generic:body:&amp;lt;sha256 32 hex&amp;gt; · body rỗng → 422 empty_body · KHÔNG BAO GIỜ ngẫu nhiên" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p65"><mxGeometry x="10" y="306" width="540" height="120" as="geometry"/></mxCell><mxCell id="p69" value="&lt;b&gt;ack&lt;/b&gt;: successStatus 200|202|204 · rejectStatus 401|403|503 (2xx hay mã lạ → 422 lúc lưu; lõi kẹp lại lúc chạy). &lt;b&gt;eventType&lt;/b&gt; + mapping → normalize ra &amp;lt;provider&amp;gt;.&amp;lt;kiểu&amp;gt;; adapter KHÔNG được sinh payment.* / repo.* sai khuôn hay hub.*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p65"><mxGeometry x="10" y="440" width="540" height="110" as="geometry"/></mxCell><mxCell id="p70" value="Nguồn unverified — “đích tự kiểm” (PK5, ADR-206): bốn khoá, thiếu một là bug — một interface ProviderAdapter duy nhất, không PresetHandler" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1640" height="520" as="geometry"/></mxCell><mxCell id="p71" value="&lt;b&gt;Vì sao&lt;/b&gt;: 26/91 bên ký kiểu hub không verify được bằng config (ghép trường đã parse, ký cả URL, khoá bất đối xứng, không ký). Hub nhận nhờ URL bí mật, giữ nguyên bytes, giao kèm header chữ ký gốc (+ URL nếu forwardUrl); đích tự verify bằng SDK provider (@hub/sdk unwrapUnverified)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p70"><mxGeometry x="10" y="38" width="380" height="150" as="geometry"/></mxCell><mxCell id="p72" value="&lt;b&gt;Khoá 1 — project tự bật&lt;/b&gt;&lt;br&gt;projects.allow_unverified_sources (mặc định false, chỉ owner, audit). Ingest nạp CÙNG câu với source → ctx.projectFlags. Tắt → refusal rejectStatus, KHÔNG lưu, KHÔNG phạt, outcome refused" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="410" y="38" width="290" height="150" as="geometry"/></mxCell><mxCell id="p73" value="&lt;b&gt;Khoá 2 — đánh dấu ở tầng raw&lt;/b&gt;&lt;br&gt;verify trả {ok:true, verified:false} → raw_events.verified=false (signature_valid vẫn true). Normalize CHÉP sang events.verified; phong bì toWebhookBody luôn có “verified”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="720" y="38" width="290" height="150" as="geometry"/></mxCell><mxCell id="p74" value="&lt;b&gt;Khoá 3 — không giả kiểu chuẩn&lt;/b&gt;&lt;br&gt;eventType không được là payment.* / repo.* / hub.* (422 lúc lưu); worker kiểm lần hai: assertUnverifiedNotReserved → lỗi vĩnh viễn, DLQ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="1030" y="38" width="290" height="150" as="geometry"/></mxCell><mxCell id="p75" value="&lt;b&gt;Khoá 4 — đích tự đồng ý&lt;/b&gt;&lt;br&gt;subscriptions.accept_unverified (mặc định false) — router bỏ qua (hub_unverified_skipped_total); polling lọc trừ includeUnverified + scope read:unverified; replay kiểm lại cờ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="1340" y="38" width="290" height="150" as="geometry"/></mxCell><mxCell id="p76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p72" target="p73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p73" target="p74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p74" target="p75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p79" value="&lt;b&gt;Ingest&lt;/b&gt; (trang 2): khoá chống trùng LUÔN ghép bodyHashKey(rawBody) — generic:&amp;lt;id&amp;gt;:&amp;lt;hash&amp;gt; hoặc generic:&amp;lt;hash&amp;gt; (E7: body giả cùng transId không NUỐT bản thật). Body &amp;gt; 45 KB → 413 unverified_body_too_large (refused; base64 ×4/3 + phong bì phải lọt SEND_MAX_BYTES 64 KB). markGood chỉ khi verified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="10" y="210" width="620" height="120" as="geometry"/></mxCell><mxCell id="p80" value="&lt;b&gt;Normalize / giao&lt;/b&gt;: data = {raw base64, contentType, headers (forwardHeaders ≤ 10, cấm authorization/cookie/x-api-key/x-hub-*), url?, method}. Telegram/Discord gắn nhãn “chưa xác thực”. Redis: nhận 3 lệnh như mọi nguồn, từ chối 0 lệnh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="650" y="210" width="470" height="120" as="geometry"/></mxCell><mxCell id="p81" value="&lt;b&gt;Đánh đổi&lt;/b&gt;: kẻ biết sourceKey vẫn bơm được (tiêu EG3 + dung lượng) — đích PHẢI verify trước khi tin và chống trùng nghiệp vụ SAU verify; dung lượng ≈ 2,33× body; forwardUrl phát sourceKey tới đích (chỉ bật cho bên ký cả URL, vd Twilio)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p70"><mxGeometry x="1140" y="210" width="490" height="120" as="geometry"/></mxCell><mxCell id="p82" value="&lt;b&gt;Lõi ingest dùng kết quả adapter, không hỏi provider&lt;/b&gt;: verdictOf(adapter.verify()) → {ok, verified} | refusal · adapter.acceptsMethod? (405) · adapter.handshake?(…, 'before-verify' | 'after-verify') · adapter.extractIdempotencyKey (IdempotencyKeyMissingError / EmptyBodyIdempotencyError → 422 theo err.code) · adapter.storedMeta? (URL công khai khi forwardUrl) · adapter.sensitiveHeaders? (che khi lưu) · adapter.buildAck(result, ctx)&lt;br&gt;&lt;b&gt;PK0&lt;/b&gt; (ADR-201): segment /hooks/:provider phải khớp source.provider (lệch → 404 cùng body, không phạt) · cổng phạt mọi method trừ OPTIONS · body parser giữ bytes gốc MỌI content-type (express.raw) · method + query chuyển cho adapter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p70"><mxGeometry x="10" y="350" width="1620" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>