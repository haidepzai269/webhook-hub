><mxGeometry x="840" y="1113" width="270" height="49" as="geometry"/></mxCell><mxCell id="p132" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.188;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p129" target="p131"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p133" value="refusal (PK5): cờ unverified tắt → rejectStatus · body &amp;gt; 45 KB → 413 — refused, KHÔNG lưu, KHÔNG phạt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1168" width="270" height="49" as="geometry"/></mxCell><mxCell id="p134" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.612;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p129" target="p133"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p135" value="&lt;b&gt;hub.raw_events&lt;/b&gt; REJECTED (mẫu ≤ 4 KB, ≤ 20/phút/source, via nếu qua lưới)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1150" y="1207.0" width="290" height="44" as="geometry"/></mxCell><mxCell id="p136" value="storeRejected()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.892;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p129" target="p135"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p137" value="So khoá chỉ bằng timingSafeEqual (GitHub verifyWithFallback, Stripe constructEvent — ADR-174)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="1113" width="200" height="130" as="geometry"/></mxCell><mxCell id="p138" value="&lt;b&gt;③h adapter.handshake(…, 'after-verify')&lt;/b&gt; — hmac-echo (Zoom) / afterVerify (Slack, Twitch): chỉ trả lời khi request bắt tay ĐÃ verify qua" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1181" width="470" height="40" as="geometry"/></mxCell><mxCell id="p139" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p129" target="p138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p140" value="200 bắt tay — handshake" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1261" width="270" height="36" as="geometry"/></mxCell><mxCell id="p141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138" target="p140"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p142" value="&lt;b&gt;③c rate limit theo source&lt;/b&gt; — SAU verify (EG3): ký sai KHÔNG tiêu hạn mức · qua → markGood CHỈ khi verified (request unverified không nâng ngưỡng phạt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1239" width="470" height="62" as="geometry"/></mxCell><mxCell id="p143" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138" target="p142"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p144" value="429 vượt INGEST_RATE_LIMIT_PER_MIN (100/phút/source) — refused" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1319" width="270" height="36" as="geometry"/></mxCell><mxCell id="p145" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.29;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p142" target="p144"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p146" value="EVAL Lua INCR + EXPIRE &lt;b&gt;rate:source:{sourceId}&lt;/b&gt; (cửa sổ cố định 60s) · Redis chết → fail-OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="1340.0" width="290" height="54" as="geometry"/></mxCell><mxCell id="p147" value="1 EVAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthog