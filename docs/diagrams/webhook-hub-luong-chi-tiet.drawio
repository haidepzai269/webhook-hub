ometry"/></mxCell><mxCell id="p42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p40" target="p41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p43" value="Redis PUBLISH / SUBSCRIBE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="477" width="180" height="24" as="geometry"/></mxCell><mxCell id="p44" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p45" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p44" target="p45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47" value="message AMQP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="501" width="180" height="24" as="geometry"/></mxCell><mxCell id="p48" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p49" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;endSize=5;" edge="1" parent="1" source="p48" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="HTTP ra / vào bên ngoài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="525" width="180" height="24" as="geometry"/></mxCell><mxCell id="p52" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p53" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;endSize=5;" edge="1" parent="1" source="p52" target="p53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="nhánh lỗi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="&lt;b&gt;Provider&lt;/b&gt; — &lt;i&gt;KẾ HOẠCH khi bật LH2&lt;/i&gt;: source MỚI đăng ký URL lưới (https://hub-hooks.webhookhub.workers.dev), source cũ gọi thẳng (U-C). &lt;b&gt;Hiện tại&lt;/b&gt;: HUB_INGEST_PUBLIC_URL trống = HUB_PUBLIC_URL, mọi source gọi thẳng Render" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="380" height="76" as="geometry"/></mxCell><mxCell id="p57" value="KẾ HOẠCH — LH2 Cloudflare Worker hub-hooks + D1 (chưa code)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#888888;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="400" height="760" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;Ghi xuyên&lt;/b&gt;: chuyển tiếp hub, timeout 4s, kèm header ký (bên phải) + x-catchnet-mode: forward. Hub trả lời có x-hub-outcome ≠ unavailable → trả NGUYÊN cho provider (bỏ header x-hub-outcome), KHÔNG ghi D1 (H1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="216" width="380" height="92" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;Hub vắng&lt;/b&gt; = timeout · lỗi mạng · 5xx KHÔNG có outcome · outcome unavailable → ghi D1 inbox (bytes nguyên, URL + query, header gốc) → trả ack của source (sources_sync); ghi D1 lỗi → 503 (BB-3: “COMMIT” = lần ghi bền đầu tiên)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="380" height="92" as="geometry"/></mxCell><mxCell id="p60" value="&lt;b&gt;H6&lt;/b&gt;: GET/HEAD (bắt tay) không bao giờ được hứng — hub vắng → 503. Body &amp;gt; 1 MB → 413 (H10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="424" width="380" height="70" as="geometry"/></mxCell><mxCell id="p61" value="&lt;b&gt;Phát lại&lt;/b&gt;: Cron Trigger mỗi phút, ≤ CATCHNET_REPLAY_BATCH (25) dòng next_at ≤ now → /hooks/* cùng bytes, x-catchnet-mode: replay. Nhịp chậm = áp lực ngược có chủ ý (cùng tinh thần slow-start BP4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="506" width="380" height="92" as="geometry"/></mxCell><mxCell id="p62" value="&lt;b&gt;H2 + LH3 T-5&lt;/b&gt;: 408/429 → luôn retry (Retry-After); 2xx (kể cả duplicate) → xoá dòng; 404 hoặc 4xx rejected/refused → inbox_dead; 4xx không outcome, khác 404 → retry có hạn rồi inbox_dead (T-5); hạn CATCHNET_RETENTION_DAYS (7) → inbox_dead" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="380" height="104" as="geometry"/></mxCell><mxCell id="p63" value="&lt;b&gt;D1&lt;/b&gt; (vùng lỗi độc lập Neon/Render) — KẾ HOẠCH:&lt;br&gt;inbox(id ulid, source_key, provider, method, url, headers_json, body BLOB, received_at, attempts, next_at, last_status) · inbox_dead · sources_sync(source_key, ack_status/type/body, catch_methods — H6) — KHÔNG secret, KHÔNG tenant_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="726" width="380" height="120" as="geometry"/></mxCell><mxCell id="p64" value="Worker KHÔNG verify chữ ký provider (không giữ secret — verify chỉ có MỘT chỗ là hub). Trạng thái: spike LH-S cổng ĐẠT (hub-hooks-spike); LH0 sổ khoảng hở, LH4/LH5 chưa làm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="856" width="380" height="74" as="geometry"/></mxCell><mxCell id="p65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p56" target="p57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p69" value="hub-api — ĐÃ CÓ (LH3): nhận request từ lưới, /hooks/* vẫn là cửa DUY NHẤT" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="620" height="1000" as="geometry"/></mxCell><mxCell id="p70" value="&lt;b&gt;main.ts&lt;/b&gt; installHubOutcome ở GỐC app, TRƯỚC guard /hooks, cổng phạt, body parser: phản hồi /hooks/* chưa có x-hub-outcome → 4xx rejected · 5xx unavailable (hub-outcome.ts)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="38" width="600" height="66" as="geometry"/></mxCell><mxCell id="p71" value="&lt;b&gt;⓪′ penalty-gate.ts&lt;/b&gt; — catchnetOf(req) → verifyCatchnetHeaders (chỉ khi có header, thuần CPU, 0 Redis, 0 DB):&lt;br&gt;x-catchnet-signature: v1=HMAC(secret, id.received_at.client_ip.mode.METHOD.path_and_query) — KHÔNG có body&lt;br&gt;điều kiện: secret 1–2 giá trị ≥ 32 ký tự (xoay khoá) · id [0-9A-Za-z]{1,64} · IP hợp lệ · mode forward|replay · now − received_at ≤ CATCHNET_RETENTION_DAYS (≤ EVENT_RETENTION_DAYS) · tương lai ≤ 5 phút · timingSafeCompare với MỌI secret (không dừng sớm)&lt;br&gt;→ hợp lệ: IP cho checkIp/checkPair = x-catchnet-client-ip ĐÃ KÝ; sai/thiếu → bỏ CẢ bộ header (không 401)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="116" width="600" height="150" as="geometry"/></mxCell><mxCell id="p72" value="&lt;b&gt;②b IngestController&lt;/b&gt; — verifyCatchnetBody: x-catchnet-body-signature: v1=HMAC(secret, id.hex(sha256(rawBody)))&lt;br&gt;khớp → opts.catchnet = {mode, receivedAt}, ip = IP đã ký · lệch → coi như GỌI THẲNG (IP kết nối, không via, Date.now(), HUB_PUBLIC_URL) — REVIEW-LH3 T-1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="278" width="600" height="100" as="geometry"/></mxCell><mxCell id="p73" value="&lt;b&gt;ingestCore&lt;/b&gt; — thứ tự §3.1 KHÔNG đổi (trang 2), lưới chỉ thay IP và “bây giờ”:&lt;br&gt;· chấm điểm phạt theo IP đã ký (IP egress Cloudflare dùng chung không bị khoá)&lt;br&gt;· ctx.verifyAt = receivedAt (Stripe constructEvent(…, receivedAt), Standard Webhooks nowSec, signed-template)&lt;br&gt;· ctx.publicUrl = publicHooksUrl(req, env, 'catchnet') → base HUB_INGEST_PUBLIC_URL; gọi thẳng → HUB_PUBLIC_URL (H4)&lt;br&gt;· headers lưu bỏ x-catchnet-* trừ x-catchnet-id (omitCatchnetHeaders)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="390" width="600" height="150" as="geometry"/></mxCell><mxCell id="p74" value="&lt;b&gt;persistAccepted / storeRejected&lt;/b&gt; — pathColumns: raw_events.&lt;b&gt;via&lt;/b&gt; = catchnet-forward | catchnet-replay (NULL = gọi thẳng), received_at = giờ Worker nhận (chỉ khi chữ ký body khớp). COMMIT rồi mới SET NX như cũ; phát lại cùng bytes + cùng id provider → UNIQUE nuốt thành &lt;b&gt;duplicate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="552" width="600" height="90" as="geometry"/></mxCell><mxCell id="p75" value="&lt;b&gt;controller&lt;/b&gt; đặt x-hub-outcome = outcomeOf(trace) trên mọi phản hồi cố ý; cổng phạt 429 đặt refused; nginx tự sinh trên /hooks* cũng mang header" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="654" width="600" height="66" as="geometry"/></mxCell><mxCell id="p76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p71" target="p72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p72" target="p73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p73" target="p74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p74" target="p75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p81" value="&lt;b&gt;hub.raw_events&lt;/b&gt;.via text NULL + CHECK (via IN ('catchnet-forward','catchnet-replay')) — migration 20261014150000_raw_events_via (bỏ VALIDATE, T-4). Số “lưới đã cứu” chỉ đếm catchnet-replay (H5). Nợ T-3: received_at = giờ Worker làm lệch mồ côi / Lắng nghe — đề xuất cột committed_at (story riêng)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="746" width="600" height="110" as="geometry"/></mxCell><mxCell id="p82" value="&lt;b&gt;Hai chữ ký vì cổng phạt chạy TRƯỚC body parser&lt;/b&gt; (D3, ADR-177): chữ ký đầu kiểm được không cần body → IP đã ký cho hộp phạt; chữ ký body kiểm sau parser → chỉ khi khớp mới tin receivedAt. Test vector chung libs/crypto/test/fixtures/catchnet-vectors.json — Worker LH2 phải kiểm cùng file (T-7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p69"><mxGeometry x="10" y="870" width="600" height="116" as="geometry"/></mxCell><mxCell id="p83" value="forward (kế hoạch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p84" value="replay (kế hoạch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p85" value="gọi thẳng (đang chạy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p56" target="p70"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="128"/></Array></mxGeometry></mxCell><mxCell id="p86" value="&lt;b&gt;x-hub-outcome&lt;/b&gt; (hub-outcome.ts, ADR-221) — để Worker phân biệt “hub TỪ CHỐI” với “hub VẮNG”&lt;br&gt;&lt;b&gt;accepted&lt;/b&gt; — 2xx sau COMMIT raw_event mới&lt;br&gt;&lt;b&gt;duplicate&lt;/b&gt; — 2xx bản trùng (Redis hoặc UNIQUE)&lt;br&gt;&lt;b&gt;handshake&lt;/b&gt; — GET query-echo, body/header/hmac-echo, manual-url, HEAD head-ok&lt;br&gt;&lt;b&gt;rejected&lt;/b&gt; — chữ ký sai (kể cả rejectStatus 503), 400, 404, 405, 413, 414, 422&lt;br&gt;&lt;b&gt;refused&lt;/b&gt; — 429 cổng phạt / rate limit, 507, nguồn unverified bị từ chối&lt;br&gt;&lt;b&gt;unavailable&lt;/b&gt; — 5xx tạm thời (TX lỗi, exception) → Worker coi là hub vắng (BB-3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="560" height="210" as="geometry"/></mxCell><mxCell id="p87" value="&lt;b&gt;Biến môi trường&lt;/b&gt; (DEPLOYMENT, ADR-211/217)&lt;br&gt;&lt;b&gt;HUB_INGEST_PUBLIC_URL&lt;/b&gt; — URL provider gọi vào; thiếu → HUB_PUBLIC_URL. publicIngestBase(env, {route}) là hàm DUY NHẤT dựng URL ingest (Kết nối PayOS/Stripe, DRIFTED public_url_changed, URL console, publicHooksUrl). Đặt mà không công khai → 422, KHÔNG rơi về&lt;br&gt;&lt;b&gt;HUB_PUBLIC_URL&lt;/b&gt; — API, console, connection string&lt;br&gt;&lt;b&gt;CATCHNET_FORWARD_SECRET&lt;/b&gt; — trống/ngắn = TẮT · &lt;b&gt;CATCHNET_RETENTION_DAYS&lt;/b&gt; 1..30 (mặc định 7), phải bằng Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="560" height="190" as="geometry"/></mxCell><mxCell id="p88" value="&lt;b&gt;edge nginx khi lưới bật&lt;/b&gt; (docker/nginx/edge.js, DEPLOYMENT §3.6): secret hợp lệ → &lt;b&gt;EDGE_HOOKS_IP_LIMITS=0&lt;/b&gt; — tắt limit_req + limit_conn theo IP cho /hooks/* (khoá theo IP Cloudflare = khoá chung cả lưới); /v1/p/* giữ cầu chì; nginx KHÔNG BAO GIỜ đọc x-catchnet-client-ip. 429/413/404/503 nginx tự sinh mang x-hub-outcome" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="560" height="130" as="geometry"/></mxCell><mxCell id="p89" value="&lt;b&gt;Bất biến giữ nguyên&lt;/b&gt;: BB-3 (Worker chỉ 2xx sau khi D1 ghi bền; hub chỉ 2xx sau COMMIT) · BB-2 (UNIQUE Postgres vẫn là trọng tài — phát lại = duplicate) · MỘT cửa vào /hooks/* (hub không có module kéo, không đường ingest thứ hai — thêm lưới không sửa lõi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="560" height="130" as="geometry"/></mxCell><mxCell id="p90" value="&lt;b&gt;Thứ tự story còn lại&lt;/b&gt; (H12): LH2 Worker + D1 + phát lại → LH0 sổ khoảng hở (heartbeat, stopped_at — hub ngủ không phải gián đoạn, H9) → LH6 chaos LOCAL → LH5 reconcile PayOS → LH1 nhãn recovery → LH4 backfill Stripe → LH7 giấy. Bật Worker thật = thao tác hạ tầng, hỏi Admin từng lần" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="840" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg11" name="11. Nguồn generic · danh mục · unverified (PK)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;11 · “Nhà cung cấp khác”: GenericAdapter cấu hình theo source (PK0–PK4, PK10) · danh mục provider là DỮ LIỆU (PK9) · nguồn unverified với bốn khoá (PK5)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Thêm provider mới = thêm MỘT mục JSON vào danh mục (hoặc một class ProviderAdapter cho native) — lõi ingest/worker/DB không đổi, không có if (provider === …). libs/providers/src.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="80" width="250" height="508" as="geometry"/></mxCell><mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="46" height="18" as="geometry"/></mxCell><mxCell id="p5" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="107" width="180" height="24" as="geometry"/></mxCell><mxCell id="p6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="134" width="46" height="18" as="geometry"/></mxCell><mxCell id="p7" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="131" widt