ill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=1;exitY=0.774;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p152" target="p156"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p158" value="BB-2: Redis chỉ là đường tắt — được phép sai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="1486" width="200" height="62" as="geometry"/></mxCell><mxCell id="p159" value="&lt;b&gt;⑥ prisma.tenantTx(tenantId)&lt;/b&gt; BEGIN&lt;br&gt;INSERT &lt;b&gt;raw_events&lt;/b&gt; (ACCEPTED, body_raw bytea, headers đã che, signature_header, origin, &lt;b&gt;verified&lt;/b&gt;, &lt;b&gt;via&lt;/b&gt; + received_at nếu qua lưới)&lt;br&gt;INSERT &lt;b&gt;outbox&lt;/b&gt; (topic='event.received', payload {rawEventId, sourceId, tenantId, provider, correlationId})&lt;br&gt;COMMIT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1486" width="470" height="104" as="geometry"/></mxCell><mxCell id="p160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p152" target="p159"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p161" value="200 duplicate — P2002 UNIQUE(source_id, idempotency_key) → ROLLBACK" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1566" width="270" height="36" as="geometry"/></mxCell><mxCell id="p162" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.173;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p159" target="p161"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p163" value="500 lỗi TX khác → unavailable → provider gửi lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1608" width="270" height="36" as="geometry"/></mxCell><mxCell id="p164" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.577;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p159" target="p163"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p165" value="&lt;b&gt;hub.raw_events&lt;/b&gt;&lt;br&gt;UNIQUE(source_id, idempotency_key) = TRỌNG TÀI&lt;br&gt;&lt;b&gt;hub.outbox&lt;/b&gt; (published_at NULL)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="1598" width="290" height="86" as="geometry"/></mxCell><mxCell id="p166" value="INSERT ×2 + COMMIT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.865;exitDx=0;exitDy=0;entryX=0;entryY=0.674;entryDx=0;entryDy=0;" edge="1" parent="1" source="p159" target="p165"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p167" value="BB-3: chưa COMMIT thì chưa 2xx · BB-2: Postgres UNIQUE là trọng tài duy nhất" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="1566" width="200" height="104" as="geometry"/></mxCell><mxCell id="p168" value="&lt;b&gt;⑦ redis.setIdempotencyKey&lt;/b&gt; — SAU COMMIT (lỗi ở đây: mặc kệ). Rollback thì khoá chưa từng được ghi → không cần DEL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1608" width="470" height="44" as="geometry"/></mxCell><mxCell id="p169" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p159" target="p168"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p170" value="SET &lt;b&gt;idem:{sourceId}:{key}&lt;/b&gt; rawEventId NX EX 86400" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="1688.0" width="290" height="44" as="geometry"/></mxCell><mxCell id="p171" value="1 SET NX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p168" target="p170"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p172" value="Thứ tự cố định: SET NX nằm SAU COMMIT — đừng “tối ưu” lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1470" y="1688" width="200" height="44" as="geometry"/></mxCell><mxCell id="p173" value="&lt;b&gt;⑧ adapter.buildAck(result, ctx)&lt;/b&gt; — successStatus 200|202|204 (lõi kẹp) · controller đặt x-hub-outcome = outcomeOf(trace)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1670" width="470" height="40" as="geometry"/></mxCell><mxCell id="p174" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p168" target="p173"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p175" value="2xx ACK (chỉ sau COMMIT) — accepted | duplicate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="1750" width="270" height="36" as="geometry"/></mxCell><mxCell id="p176" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p173" target="p175"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p177" value="&lt;b&gt;traced()&lt;/b&gt; (mọi kết quả): hub_ingest_requests_total{provider,outcome} · hub_ingest_duration_seconds · TrafficRecorder (Map bộ nhớ, +bytes) · DuplicateCounter · trace.ingested Socket.IO in-process (0 Redis)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="1728" width="470" height="54" as="geometry"/></mxCell><mxCell id="p178" value="flush TRAFFIC_FLUSH_MS=60s: upsert &lt;b&gt;hub.source_traffic_minutely&lt;/b&gt; · mỗi 5s: &lt;b&gt;hub.ingest_duplicates&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1150" y="1808.0" width="290" height="54" as="geometry"/></mxCell><mxCell id="p179" value="upsert theo lô" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p177" target="p178"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p180" value="② proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p72"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="298" y="534"/><mxPoint x="298" y="147.0"/></Array></mxGeometry></mxCell><mxCell id="p181" value="&lt;b&gt;PenaltyBox&lt;/b&gt; (bộ nhớ từng instance hub-api, ADR-177; gate và ingest dùng CHUNG instance)&lt;br&gt;(a) 404 KHÔNG tìm thấy source: ≥20/60s theo IP → chặn mọi /hooks/* của IP 10 phút&lt;br&gt;(b) 401 sai chữ ký: ≥30/60s theo (IP, sourceKey) → chặn cặp 10 phút&lt;br&gt;cặp tốt (verify đúng 24h) không bị luật (a) chặn · IP = IP đã ký nếu qua lưới · LRU · fail-open&lt;br&gt;&lt;i&gt;checkIp/checkPair ở ⓪′ ⓪″ ②a · record*() ở ② ③ ③c&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="250" height="210" as="geometry"/></mxCell><mxCell id="p182" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p181"><mxGeometry x="0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="316" y="305.2"/><mxPoint x="316" y="765"/><mxPoint x="155" y="765"/></Array></mxGeometry></mxCell><mxCell id="p183" value="&lt;b&gt;x-hub-outcome&lt;/b&gt; (ADR-221) — lưới hứng phân biệt “hub từ chối” với “hub vắng”:&lt;br&gt;&lt;b&gt;accepted&lt;/b&gt; · &lt;b&gt;duplicate&lt;/b&gt; · &lt;b&gt;handshake&lt;/b&gt;&lt;br&gt;&lt;b&gt;rejected&lt;/b&gt;: chữ ký (kể cả 503 rejectStatus), 400, 404, 405, 413, 414, 422&lt;br&gt;&lt;b&gt;refused&lt;/b&gt;: 429 (cổng phạt, rate limit), 507, nguồn unverified bị từ chối (cờ tắt, VÀ 413 body &amp;gt; 45 KB)&lt;br&gt;&lt;b&gt;unavailable&lt;/b&gt;: 5xx tạm thời (BB-3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="250" height="190" as="geometry"/></mxCell><mxCell id="p184" value="&lt;b&gt;Chống trùng 5 chốt&lt;/b&gt; (§5.2): ① Redis idem (bước ⑤/⑦) · ② raw_events UNIQUE · ③ events UNIQUE(raw_event_id) · ④ deliveries UNIQUE(event, sub, generation) · ⑤ processed_messages + lease claimForSend. Phát lại qua lưới (cùng bytes + cùng id) → ② nuốt thành duplicate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1210" width="250" height="150" as="geometry"/></mxCell><mxCell id="p185" value="&lt;b&gt;Redis trên đường ingest&lt;/b&gt;: ≤ 3 lệnh (EVAL rate · GET idem · SET NX) — nhánh bắt tay, 405, 507, refusal: 0 lệnh. Đếm bằng apps/hub-api/test/redis-budget.spec.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1380" width="250" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg3" name="3. Outbox → RabbitMQ topology"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;3 · Transactional Outbox → relay SKIP LOCKED → topology RabbitMQ (libs/messaging/src/topology.ts — khai báo MỘT chỗ duy nhất)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Tên exchange / queue / routing key / TTL / DLX lấy nguyên văn từ setupRabbitMQTopology(). Hai chặng outbox: ingest (event.received) và normalize/replay/sweeper (delivery.*).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="hub-api — ghi outbox trong CÙNG transaction" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="330" height="300" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;IngestService.persistAccepted&lt;/b&gt; (/hooks/* và POST /v1/p/:project/events)&lt;br&gt;raw_events + outbox &lt;b&gt;topic=event.received&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p3"><mxGeometry x="10" y="38" width="310" height="58" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;POST /api/v1/raw-events/renormalize&lt;/b&gt; (phát lại raw_event mồ côi) → &lt;b&gt;event.received&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p3"><mxGeometry x="10" y="108" width="310" height="46" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;POST /api/v1/deliveries/:id/replay&lt;/b&gt; · &lt;b&gt;/deliveries/replay-bulk&lt;/b&gt;&lt;br&gt;deliveries gen+1 + audit_logs + outbox &lt;b&gt;delivery.replayed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p3"><mxGeometry x="10" y="166" width="310" height="58" as="geometry"/></mxCell><mxCell id="p7" value="BB-3: ingest chỉ trả 2xx sau COMMIT raw_events + outbox — relay mới là bên nói chuyện với broker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="p3"><mxGeometry x="10" y="236" width="310" height="52" as="geometry"/></mxCell><mxCell id="p8" value="hub-worker — ghi outbox trong CÙNG transaction" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="330" height="270" as="geometry"/></mxCell><mxCell id="p9" value="&lt;b&gt;NormalizeConsumer&lt;/b&gt; → routeEventToSubscriptions()&lt;br&gt;events + deliveries + outbox &lt;b&gt;delivery.requested&lt;/b&gt; (+ gợi ý destinationId, rateLimitRps — BP2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p8"><mxGeometry x="10" y="38" width="310" height="56" as="geometry"/></mxCell><mxCell id="p10" value="&lt;b&gt;emitHubEvent()&lt;/b&gt; (StorageJob / StorageAlerts: hub.project.*) → &lt;b&gt;delivery.requested&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p8"><mxGeometry x="10" y="106" width="310" height="56" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;DeliverySweeper&lt;/b&gt; (60s ±10s, systemTx): INSERT INTO hub.outbox … SELECT delivery PENDING/DELIVERING kẹt &amp;gt; 10 phút, RETRYING quá next_attempt_at + 5 phút → &lt;b&gt;delivery.requested&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p8"><mxGeometry x="10" y="174" width="310" height="84" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;hub.outbox&lt;/b&gt;&lt;br&gt;id bigserial · topic · payload jsonb&lt;br&gt;published_at NULL · created_at&lt;br&gt;index thường (id) — @@index([id]), 0_init&lt;br&gt;&lt;i&gt;không RLS — hạ tầng xuyên tenant, payload chỉ là tham chiếu&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="230" height="190" as="geometry"/></mxCell><mxCell id="p13" value="INSERT outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p12"><mxGeometry x="0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19" value="hub-worker — OutboxRelay (outbox.relay.ts)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="320" height="600" as="geometry"/></mxCell><mxCell id="p20" value="&lt;b&gt;① BEGIN&lt;/b&gt; (timeout 15s)&lt;br&gt;SELECT id, topic, payload FROM hub.outbox WHERE published_at IS NULL ORDER BY id LIMIT 200 FOR UPDATE SKIP LOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="38" width="300" height="84" as="geometry"/></mxCell><mxCell id="p21" value="&lt;b&gt;② TOPIC_ROUTES&lt;/b&gt; (một bảng, không if):&lt;br&gt;event.received → x.hub.events / event.received&lt;br&gt;delivery.requested → x.hub.delivery / deliver&lt;br&gt;delivery.replayed → x.hub.delivery / deliver" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="136" width="300" height="96" as="geometry"/></mxCell><mxCell id="p22" value="&lt;b&gt;③ channel.publish cả lô&lt;/b&gt; trên ConfirmChannel (persistent, header x-correlation-id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="246" width="300" height="60" as="geometry"/></mxCell><mxCell id="p23" value="&lt;b&gt;④ chờ publisher confirms THEO LÔ&lt;/b&gt; (Promise.all) — 1 message nack → ném → ROLLBACK cả lô (at-least-once)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="320" width="300" height="60" as="geometry"/></mxCell><mxCell id="p24" value="&lt;b&gt;⑤ UPDATE hub.outbox SET published_at = now() WHERE id = ANY($ids)&lt;/b&gt; → COMMIT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="394" width="300" height="52" as="geometry"/></mxCell><mxCell id="p25" value="nhịp ~500ms ±100ms jitter; lô đầy (200) → lượt kế chạy NGAY; metric hub_outbox_lag_seconds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p19"><mxGeometry x="10" y="460" width="300" height="62" as="geometry"/></mxCell><mxCell id="p26" value="SKIP LOCKED → N worker cùng chạy relay an toàn, KHÔNG cần Redis lock, KHÔNG cần hub-scheduler (ADR-020)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="p19"><mxGeometry x="10" y="534" width="300" height="56" as="geometry"/></mxCell><mxCell id="p27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p20" target="p21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p21" target="p22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p29" value="" style="edgeStyle=orthogonalEdg