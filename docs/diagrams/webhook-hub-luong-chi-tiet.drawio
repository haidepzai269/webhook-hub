=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;fontSize=10;arcSize=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="970" y="1130" width="330" height="34" as="geometry"/></mxCell><mxCell id="p176" value="nguồn sự thật DLQ = deliveries.status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;fontSize=10;arcSize=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="1300" y="1130" width="360" height="34" as="geometry"/></mxCell><mxCell id="p177" value="&lt;b&gt;Vì sao không jitter / auto-scale / queue theo đích?&lt;/b&gt; (§5.4c) TTL theo queue không cho jitter từng message (head-of-line blocking) → slow-start theo đích chặn TỐC ĐỘ thay jitter; queue theo đích = bùng nổ topology + PRECONDITION_FAILED → gate theo đích TRƯỚC khi nạp DB (0 truy vấn đọc, 1 lệnh Redis); áp lực ngược cả worker CHỈ theo lỗi hạ tầng hub. Hằng số dùng chung ở libs/messaging/src/retry-window.ts (cửa sổ retry ≈ 7h22m10s, trang 8)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="1184" width="1640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg10" name="10. Lưới hứng (LH) — chặng 1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;10 · Lưới hứng khi hub sập (SPEC-hub-sap) — CHẶNG 1 đã có: hub phía nhận (LH3, ADR-217/221) + tách HUB_INGEST_PUBLIC_URL (ADR-211); Worker thật + D1 + phát lại (LH2) CHƯA code&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Nét đứt xám = KẾ HOẠCH theo SPEC-hub-sap §4 + ĐÍNH CHÍNH H1/H2/H6 (thắng phần thân) — chưa có code, không phải hành vi đang chạy. Production hiện tại: CATCHNET_FORWARD_SECRET trống → mọi header x-catchnet-* bị bỏ qua, lưới TẮT.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="80" width="250" height="508" as="geometry"/></mxCell><mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="46" height="18" as="geometry"/></mxCell><mxCell id="p5" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="107" width="180" height="24" as="geometry"/></mxCell><mxCell id="p6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="134" width="46" height="18" as="geometry"/></mxCell><mxCell id="p7" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="131" width="180" height="24" as="geometry"/></mxCell><mxCell id="p8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="158" width="46" height="18" as="geometry"/></mxCell><mxCell id="p9" value="Trạng thái