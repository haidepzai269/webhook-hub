l id="p56" value="Bên gọi vào" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#9673a6;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="220" height="480" as="geometry"/></mxCell><mxCell id="p57" value="&lt;b&gt;PayOS&lt;/b&gt; — checksum HMAC trên data (SDK tính, so bằng timingSafeEqual của hub)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="200" height="56" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;SePay&lt;/b&gt; — Authorization: Apikey &amp;lt;key&amp;gt; (khoá dùng chung)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="188" width="200" height="50" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;GitHub&lt;/b&gt; — X-Hub-Signature-256 (verifyWithFallback)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="248" width="200" height="50" as="geometry"/></mxCell><mxCell id="p60" value="&lt;b&gt;Stripe&lt;/b&gt; — Stripe-Signature (constructEvent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="308" width="200" height="50" as="geometry"/></mxCell><mxCell id="p61" value="&lt;b&gt;generic&lt;/b&gt; — bên thứ ba, cấu hình theo source (GenericAdapter, danh mục 31 mục, unverified)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="368" width="200" height="56" as="geometry"/></mxCell><mxCell id="p62" value="&lt;b&gt;Service của khách&lt;/