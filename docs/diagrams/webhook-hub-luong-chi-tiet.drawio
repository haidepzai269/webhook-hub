l><mxCell id="p61" value="&lt;b&gt;metrics.ts&lt;/b&gt; (bộ nhớ): hub_deliveries_total · hub_circuit_transitions_total · hub_outbox_lag_seconds · &lt;b&gt;hub_backpressure_factor / _held / _spilled_total&lt;/b&gt; · &lt;b&gt;hub_deliveries_deferred_total{reason}&lt;/b&gt; · hub_delivery_infra_errors_total{kind} · hub_normalize_deferred_total · hub_unverified_skipped_total · hub_alerts_* → &lt;b&gt;:9101/metrics&lt;/b&gt; (nội bộ; hub-all đặt 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="346" width="310" height="118" as="geometry"/></mxCell><mxCell id="p62" value="&lt;b&gt;Redis pub/sub&lt;/b&gt; (connection riêng, fastFailRedisOptions)&lt;br&gt;&lt;br&gt;&lt;b&gt;hub:realtime:events&lt;/b&gt;&lt;br&gt;&lt;b&gt;hub:realtime:deliveries&lt;/b&gt;&lt;br&gt;&lt;b&gt;hub:realtime:circuit&lt;/b&gt;&lt;br&gt;&lt;b&gt;hub:realtime:alerts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;hub:auth:email-filter&lt;/b&gt; (hub-api ↔ hub-api: đồng bộ Bloom filter email, chỉ hash — ADR-180)&lt;br&gt;&lt;br&gt;Ngân sách R1: ≤ 4 lệnh / sự kiện + ≤ 2 / delivery — PUBLISH đã tính trong đó" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="250" height="330" as="geometry"/></mxCell><mxCell id="p63" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="p57" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p64" value="deliveries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="circuit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p66" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.66;entryDx=0;entryDy=0;" edge="1" parent="1" source="p60" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p67" value="hub-api — RealtimeGateway (Socket.IO) · /metrics" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="90" width="560" height="560" as="geometry"/></mxCell><mxCell id="p68" value="&lt;b&gt;redisSub&lt;/b&gt; — MỘT connection subscriber cho mọi kênh (redis-channels.ts dùng chung, giới hạn kết nối Upstash) · subscribe lại ở mỗi lần 'ready'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="10" y="38" width="540" height="70" as="geometry"/></mxCell><mxCell id="p69" value="&lt;b&gt;REALTIME_CHANNELS&lt;/b&gt; → tên sự kiện Socket.IO:&lt;br&gt;hub:realtime:events → &lt;b&gt;event.received&lt;/b&gt; · hub:realtime:deliveries → &lt;b&gt;delivery.attempt&lt;/b&gt;&lt;br&gt;hub:realtime:circuit → &lt;b&gt;circuit.changed&lt;/b&gt; · hub:realtime:alerts → &lt;b&gt;alert.changed&lt;/b&gt;&lt;br&gt;tin thiếu tenantId → bỏ qua" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="10" y="120" width="540" height="92" as="geometry"/></mxCell><mxCell id="p70" value="&lt;b&gt;Rooms (BB-5: không broadcast toàn server)&lt;/b&gt;&lt;br&gt;&lt;b&gt;project:&amp;lt;tenantId&amp;gt;&lt;/b&gt; — mọi thành viên · &lt;b&gt;project:&amp;lt;id&amp;gt;:ops&lt;/b&gt; — chỉ operator (alert.changed)&lt;br&gt;&lt;b&gt;project:&amp;lt;id&amp;gt;:owners&lt;/b&gt; — owner (cảnh báo audience owners+operator, vd dung lượng)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="10" y="224" width="540" height="92" as="geometry"/></mxCell><mxCell id="p71" value="&lt;b&gt;trace.ingested&lt;/b&gt; — IngestService emit IN-PROCESS (0 Redis); chỉ tới client nối CÙNG instance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="10" y="328" width="265" height="104" as="geometry"/></mxCell><mxCell id="p72" value="&lt;b&gt;metrics.tick&lt;/b&gt; mỗi 5s cho mỗi room project đang có người xem: bộ đếm trong bộ nhớ → eventsPerMin = events × 12, successRate (null khi chưa có kết quả)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="285" y="328" width="265" height="104" as="geometry"/></mxCell><mxCell id="p73" value="&lt;b&gt;GET /metrics&lt;/b&gt; (prom-client, không JWT; METRICS_TOKEN nếu đặt): hub_ingest_requests_total{provider,outcome} · hub_ingest_duration_seconds{provider} · hub_ingest_penalty_* · hub_ingest_unknown_source_total · hub_traffic_flush_dropped_total · hub_ingest_storage_would_reject_total · default process metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p67"><mxGeometry x="10" y="444" width="540" height="106" as="geometry"/></mxCell><mxCell id="p74" value="SUBSCRIBE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.08;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p62" target="p68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p68" target="p69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p69" target="p70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p77" value="&lt;b&gt;web — Next.js console&lt;/b&gt; (Vercel)&lt;br&gt;socket.io-client, transports: ['websocket'] (không sticky session)&lt;br&gt;handshake auth: {ticket} — vé 60s xin qua &lt;b&gt;GET /auth/socket-ticket?projectId=&lt;/b&gt; (qua proxy, có cookie)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="360" height="130" as="geometry"/></mxCell><mxCell id="p78" value="emit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p77"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="342"/><mxPoint x="1285" y="185"/></Array></mxGeometry></mxCell><mxCell id="p79" value="&lt;b&gt;Kiểm vé&lt;/b&gt;: HS256, aud 'socket', exp 60s, khoá riêng + session còn sống + ProjectScopeGuard (resolveProjectScope) → join đúng MỘT room project. R-3: quét lại session/membership mỗi 30s, mất quyền → ngắt socket." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1300" y="270" width="360" height="120" as="geometry"/></mxCell><mxCell id="p80" value="&lt;b&gt;Chuông xuyên project&lt;/b&gt;: GET /api/v1/alerts/summary poll 30s (systemTx có tên) + gọi lại khi nhận alert.changed · &lt;b&gt;nhận định&lt;/b&gt; GET /projects/:p/insights tính lúc đọc, không lưu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="410" width="360" height="96" as="geometry"/></mxCell><mxCell id="p81" value="&lt;b&gt;Prometheus&lt;/b&gt; v3.14.0&lt;br&gt;scrape 5s: hub-api:4000/metrics · hub-worker:9101/metrics&lt;br&gt;(chỉ LOCAL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="540" width="160" height="100" as="geometry"/></mxCell><mxCell id="p82" value="&lt;b&gt;Grafana&lt;/b&gt; 13.2.2 — provisioning infra/grafana: dashboard “Webhook Hub” 10 panel (7–8 cảnh báo, 9–10 lớp biên)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="540" width="150" height="100" as="geometry"/></mxCell><mxCell id="p83" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p81" target="p73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p84" value="scrape :9101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p81" target="p61"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="690"/><mxPoint x="185" y="690"/></Array></mxGeometry></mxCell><mxCell id="p85" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p82" target="p81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p86" value="hub-worker — cảnh báo cho người vận hành (AlertEvaluator 60s · AlertEmailSender 15s) — không tiến trình mới (ADR-020, BB-4)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1250" height="590" as="geometry"/></mxCell><mxCell id="p87" value="&lt;b&gt;① mỗi ALERT_EVAL_INTERVAL_MS (60s)&lt;/b&gt;: identity.listProjectIds() → với MỖI project: truy vấn tổng hợp có cửa sổ + LIMIT qua &lt;b&gt;TenantScopedRepository&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="10" y="40" width="280" height="120" as="geometry"/></mxCell><mxCell id="p88" value="&lt;b&gt;② luật = hàm thuần&lt;/b&gt; (libs/common/src/alerts/rules.ts): destination.circuit_open (“Thử lại lúc” = destinations.circuit_half_open_at, BP3 — không gọi Redis) · .failing · .client_error · .auth_rejected · delivery.dead_spike · source.signature_failing · .silent · .connection_broken · normalize.backlog · project.storage_* · hub.storage_near_full" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="310" y="40" width="300" height="120" as="geometry"/></mxCell><mxCell id="p89" value="&lt;b&gt;③ TX&lt;/b&gt;: INSERT … ON CONFLICT hub.alerts (unique MỘT PHẦN (tenant_id, rule, subject_id) WHERE state='OPEN') / đóng theo id · + hub.alert_emails PENDING (chống flapping 30') → COMMIT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="630" y="40" width="300" height="120" as="geometry"/></mxCell><mxCell id="p90" value="&lt;b&gt;④ sau COMMIT&lt;/b&gt;: PUBLISH hub:realtime:alerts → alert.changed vào room :ops (+ :owners). Không khoá (không advisory, không Redis lock) — N worker vẫn đúng một dòng OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="950" y="40" width="290" height="120" as="geometry"/></mxCell><mxCell id="p91" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p87" target="p88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p88" target="p89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p89" target="p90"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p94" value="&lt;b&gt;AlertEmailSender&lt;/b&gt; mỗi 15s: prisma.alertEmailOutbox… — systemTx có tên “alert email: lấy lô PENDING (SKIP LOCKED)”, lô 20, lease next_attempt_at 120s (đồng hồ DB, gia hạn có điều kiện trước mỗi lần gửi — fencing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="10" y="200" width="400" height="130" as="geometry"/></mxCell><mxCell id="p95" value="gửi NGOÀI transaction (timeout 30s), kiểm lại điều kiện lúc gửi · thư vi/en theo users.locale, câu luật dùng chung console (alerts/text.ts), không payload/header/secret/URL đích" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="430" y="200" width="380" height="130" as="geometry"/></mxCell><mxCell id="p96" value="&lt;b&gt;kết quả&lt;/b&gt;: SENT · SUPPRESSED (trần 6 thư/giờ/người, thư sau có “…và k cảnh báo khác”) · lỗi → thử lại 1' / 5', 3 lần → FAILED. Gửi lỗi KHÔNG chặn evaluator" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="830" y="200" width="410" height="130" as="geometry"/></mxCell><mxCell id="p97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p94" target="p95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p95" target="p96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p99" value="&lt;b&gt;PostgreSQL&lt;/b&gt;: &lt;b&gt;hub.alerts&lt;/b&gt; (tenant_id, rule, subject_id, state OPEN/RESOLVED, severity; RLS) · &lt;b&gt;hub.alert_emails&lt;/b&gt; (alert_id, user_id, kind, tag, state, attempts, next_attempt_at; RLS) · &lt;b&gt;hub.alert_preferences&lt;/b&gt; (theo người, sửa ở /dashboard/settings) · &lt;b&gt;users.locale&lt;/b&gt; · &lt;b&gt;auth_audit&lt;/b&gt; (email thử 3/giờ)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="10" y="370" width="600" height="110" as="geometry"/></mxCell><mxCell id="p100" value="&lt;b&gt;MAIL_DRIVER&lt;/b&gt;: gmail (Gmail API) · resend · log — capture chỉ cho stack kiểm chứng (production + capture → app thoát)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="p86"><mxGeometry x="840" y="390" width="400" height="90" as="geometry"/></mxCell><mxCell id="p101" value="INSERT … ON CONFLICT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.683;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p89" target="p99"><mxGeometry x="0.0" relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="905"/><mxPoint x="440" y="905"/></Array></mxGeometry></mxCell><mxCell id="p102" value="SKIP LOCKED + lease" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p94" target="p99"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p103" value="gửi thư" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p96" target="p100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p104" value="PUBLISH hub:realtime:alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p90" target="p62"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="705"/><mxPoint x="555" y="705"/></Array></mxGeometry></mxCell><mxCell id="p105" value="&lt;b&gt;Vì sao không “tự cảnh báo” qua Telegram/Slack bằng chính pipeline delivery?&lt;/b&gt; Pipeline cháy thì kênh báo cháy cháy theo (kênh hub:alerts cũ bỏ ở ADR-048). Cảnh báo đi đường riêng không qua RabbitMQ: chuông / banner / toast console + email (outbox theo người). Trọng tài là Postgres — Redis mất chỉ mất realtime (BB-2). Metric: hub_alerts_open{severity} · hub_alert_transitions_total{rule,to} · hub_alert_eval_errors_total{rule}." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p86"><mxGeometry x="10" y="500" width="1230" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg8" name="8. Dung lượng (QT) · lưu lượng (EG4) · dọn"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1270" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;8 · Hạn mức dung lượng theo project (QT) · lưu lượng theo source (EG4) · StorageJob · lệnh dọn · CleanupJob (khoá Redis) · sàn TOTAL_RETRY_WINDOW_MS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Cô lập TÀI NGUYÊN (lớp thứ tư): một project lấp đầy ổ chung không được làm INSERT của project khác lỗi. Đo trong worker, khoá chiều ghi ở bước ②q của ingest.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="80" width="250" height="508" as="geometry"/></mxCell><mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="46" height="18" as="geometry"/></mxCell><mxCell id="p5" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="107" width="180" height="24" as="geometry"/></mxCell><mxCell id="p6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="134" width="46" height="18" as="geometry"/></mxCell><mxCell id="p7" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="131" width="180" height="24" as="geometry"/></mxCell><mxCell id="p8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="158" width="46" height="18" as="geometry"/></mxCell><mxCell id="p9" value="Trạng thái trong bộ nhớ tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#00