top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="&lt;b&gt;Provider&lt;/b&gt; PayOS · SePay · GitHub · Stripe · generic (31 mục danh mục)&lt;br&gt;POST (GET/HEAD chỉ để bắt tay) /hooks/:provider/:sourceKey" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="250" height="70" as="geometry"/></mxCell><mxCell id="p57" value="&lt;b&gt;Lưới hứng&lt;/b&gt; (Cloudflare Worker) — &lt;i&gt;chặng 1: hub phía nhận ĐÃ CÓ; Worker thật CHƯA (LH2)&lt;/i&gt;. Production: CATCHNET_FORWARD_SECRET trống → header x-catchnet-* bị bỏ qua (trang 10)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="250" height="92" as="geometry"/></mxCell><mxCell id="p58" value="edge — nginx (chỉ khi EDGE_NGINX=1)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="270" height="360" as="geometry"/></mxCell><mxCell id="p59" value="location ~ ^/hooks/[a-z0-9-]+/[A-Za-z0-9_-]{1,64}$&lt;br&gt;client_max_body_size 1m" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p58"><mxGeometry x="10" y="38" width="250" height="56" as="geometry"/></mxCell><mxCell id="p60" value="cầu chì IP: limit_req zone=hooks_ip · limit_conn hooks_conn — /hooks/*: zone &lt;b&gt;hooks_path_ip&lt;/b&gt; (EDGE_IP_FUSE mặc định TẮT, ADR-176). Lưới bật → &lt;b&gt;EDGE_HOOKS_IP_LIMITS=0&lt;/b&gt;: tắt khoá theo IP cho /hooks/* (IP Cloudflare dùng chung)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p58"><mxGeometry x="10" y="104" width="250" height="92" as="geometry"/></mxCell><mxCell id="p61" value="proxy_pass hub_api (127.0.0.1:4000)&lt;br&gt;X-Forwarded-For = $remote_addr (ghi đè)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p58"><mxGeometry x="10" y="206" width="250" height="56" as="geometry"/></mxCell><mxCell id="p62" value="BB-3: nginx không bao giờ trả 2xx thay hub-api, không sửa body (HMAC trên bytes gốc), không đọc x-catchnet-client-ip (không kiểm được chữ ký lưới)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="p58"><mxGeometry x="10" y="272" width="250" height="78" as="geometry"/></mxCell><mxCell id="p63" value="nginx tự trả, KHÔNG tới hub-api (mang x-hub-outcome, ADR-221):&lt;br&gt;404/413 rejected · 429 refused · 503 unavailable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="250" height="66" as="geometry"/></mxCell><mxCell id="p64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p56" target="p57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p57" target="p58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p56" target="p58"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="22" y="125"/><mxPoint x="22" y="336"/></Array></mxGeometry></mxCell><mxCell id="p67" value="&lt;i&gt;① gọi thẳng (trái)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=9;fontColor=#5b2382;" vertex="1" parent="1"><mxGeometry x="30" y="274" width="120" height="20" as="geometry"/></mxCell><mxCell id="p68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p60" target="p61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p60" target="p63"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="296" y="478"/><mxPoint x="296" y="700"/></Array></mxGeometry></mxCell><mxCell id="p71" value="hub-api — main.ts → IngestController → ingestCore (BB-4)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="305" y="80" width="515" height="1810" as="geometry"/></mxCell><mxCell id="p72" value="&lt;b&gt;⓪ gốc app&lt;/b&gt; installHubOutcome — lưới đỡ: phản hồi /hooks/* chưa có header → 4xx &lt;b&gt;rejected&lt;/b&gt; · 5xx &lt;b&gt;unavailable&lt;/b&gt; (lỗi parser, guard, exception filter)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="40" width="470" height="54" as="geometry"/></mxCell><mxCell id="p73" value="&lt;b&gt;⓪g installHooksPathGuard&lt;/b&gt; — /HOOKS/… (sai hoa thường) → 404 như nginx, đặt TRƯỚC cổng phạt (IP sạch và IP bị ban nhận cùng phản hồi, EG1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="112" width="470" height="40" as="geometry"/></mxCell><mxCell id="p74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p72" target="p73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p75" value="404 rejected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="192" width="270" height="36" as="geometry"/></mxCell><mxCell id="p76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p73" target="p75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p77" value="&lt;b&gt;⓪′ penalty-gate.ts&lt;/b&gt; — TRƯỚC body parser, mọi method trừ OPTIONS (PK0). catchnetOf(req): có x-catchnet-signature hợp lệ → IP = x-catchnet-client-ip ĐÃ KÝ, ngược lại IP kết nối → PenaltyBox.checkIp + checkPair (0 Redis, 0 DB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="170" width="470" height="69" as="geometry"/></mxCell><mxCell id="p78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p73" target="p77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p79" value="429 + Retry-After + Connection: close, &lt;b&gt;refused&lt;/b&gt; (body KHÔNG được đọc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="270" height="36" as="geometry"/></mxCell><mxCell id="p80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.261;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p81" value="Chữ ký ĐẦU lưới không có body → kiểm được trước parser (H3). HMAC chỉ chạy khi có header lưới." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1470" y="250" width="200" height="69" as="geometry"/></mxCell><mxCell id="p82" value="&lt;b&gt;① body parser /hooks&lt;/b&gt; ≤ 1 MB: json · urlencoded · express.raw({type: () =&amp;gt; true}) (PK0: bytes gốc MỌI content-type) → req.rawBody — NestFactory.create(AppModule, {rawBody: true})" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p71"><mxGeometry x="25" y="257" width="470" height="54" as="geometry"/></mxCell><mxCell id="p83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p84" value="413 / 400 parser → rejected (lưới đỡ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="337" width="270" height="36" as="geometry"/></mxCell><mxCell id="p85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=