h="180" height="24" as="geometry"/></mxCell><mxCell id="p48" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p49" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;endSize=5;" edge="1" parent="1" source="p48" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="HTTP ra / vào bên ngoài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="525" width="180" height="24" as="geometry"/></mxCell><mxCell id="p52" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p53" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;endSize=5;" edge="1" parent="1" source="p52" target="p53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="nhánh lỗi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="&lt;b&gt;Service của khách&lt;/b&gt; — SDK @hub/sdk&lt;br&gt;createHubClient('hubs://&amp;lt;key&amp;gt;@&amp;lt;host&amp;gt;/&amp;lt;project&amp;gt;')&lt;br&gt;publish · poll · endpoints.ensure · verifyWebhook · challengeResponse (vd Shop tự ensure endpoint + subscription payment.received)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="250" height="110" as="geometry"/></mxCell><mxCell id="p57" value="&lt;b&gt;hub listen&lt;/b&gt; (CLI dev): GET /v1/p/:project/events?after=&amp;lt;cursor&amp;gt;&amp;amp;wait=20 → ký phía client bằng whsec_ phiên (toWebhookBody dùng chung với WebhookSender) → POST localhost:3000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="250" height="100" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;hub trigger &amp;lt;type&amp;gt;&lt;/b&gt; — canonicalSample → POST /events (như service) → validateCanonical" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="250" height="64" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;Endpoint của service&lt;/b&gt; (URL công khai)&lt;br&gt;trả lại {challenge} trong JSON khi nhận endpoint.verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="515" width="250" height="80" as="geometry"/></mxCell><mxCell id="p60" value="hub-api — Service API /v1/p/:project/* (ServiceApiController · ServiceResourcesController)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="830" height="620" as="geometry"/></mxCell><mxCell id="p61" value="&lt;b&gt;ApiKeyGuard&lt;/b&gt; (thứ tự CỐ ĐỊNH, 0 lệnh Redis)&lt;br&gt;Authorization: Bearer hk_(test|live)_… → sha256 → prisma.findApiKeyByHash() (tra theo hash)&lt;br&gt;1. sai / không có / revoked → 401&lt;br&gt;2. slug project GẮN VỚI KEY ≠ :project → 404 (cùng body, không lộ project kia có tồn tại)&lt;br&gt;3. thiếu @RequireScope → 403 missing_scope&lt;br&gt;→ request.principal = {kind:'key', tenantId, scopes, readTypes}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="20" y="40" width="420" height="170" as="geometry"/></mxCell><mxCell id="p62" value="401 invalid_api_key · 404 not_found · 403 missing_scope&lt;br&gt;khuôn lỗi {error, message, fix, docsUrl, requestId} + header x-request-id (docs/ERRORS.md)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="p60"><mxGeometry x="470" y="40" width="340" height="90" as="geometry"/></mxCell><mxCell id="p63" value="Scope: publish:events · read:events · manage:endpoints · manage:sources · read:unverified (PK5). Key thô trả MỘT lần lúc tạo; lastUsedAt ghi ≤ 1 lần/phút (bộ nhớ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p60"><mxGeometry x="470" y="142" width="340" height="68" as="geometry"/></mxCell><mxCell id="p64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="&lt;b&gt;POST /events&lt;/b&gt; (publish:events) → validatePublishBody → IngestService.publishFromService: ②q 507 → EVAL rate:source:{sourceId} 429 → &lt;b&gt;persistAccepted&lt;/b&gt; (cùng lõi /hooks, ADR-074) → &lt;b&gt;202&lt;/b&gt; {rawEventId, duplicate:false} | 200 {duplicate:true}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="420" y="240" width="390" height="120" as="geometry"/></mxCell><mxCell id="p66" value="&lt;b&gt;GET /events&lt;/b&gt;?after=&amp;lt;cursor&amp;gt;&amp;amp;limit&amp;amp;types&amp;amp;status&amp;amp;endpointId&amp;amp;wait=0..20 (read:events)&lt;br&gt;assignPollSeq(): pg_advisory_xact_lock(4242, hashtext(tenant)) → cấp &lt;b&gt;poll_seq&lt;/b&gt; cho dòng ĐÃ COMMIT (theo thứ tự commit) → SELECT poll_seq &amp;gt; after (bỏ probe)&lt;br&gt;long-poll 1s, 0 Redis · cursor rác → 400 · lọc verified=false trừ includeUnverified + scope read:unverified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="20" y="240" width="380" height="150" as="geometry"/></mxCell><mxCell id="p67" value="&lt;b&gt;POST /endpoints&lt;/b&gt; · &lt;b&gt;/endpoints/:id/verify&lt;/b&gt; (manage:endpoints) → EndpointService (dùng chung console): TX destinations PENDING (whsec_ mã hoá, hiện MỘT lần) + subscription → COMMIT → challenge NGOÀI tx: POST {type:'endpoint.verification', challenge} ký Standard Webhooks → so timingSafeEqual → VERIFIED | FAILED (+ verificationFix)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="20" y="410" width="380" height="115" as="geometry"/></mxCell><mxCell id="p68" value="&lt;b&gt;POST · PATCH · GET /subscriptions&lt;/b&gt; (manage:endpoints): eventTypes (khớp chính xác · payment.* · *) + &lt;b&gt;sourceIds&lt;/b&gt; (rỗng = mọi source) + &lt;b&gt;acceptUnverified&lt;/b&gt; (PK5 khoá 4, mặc định false)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="420" y="380" width="390" height="80" as="geometry"/></mxCell><mxCell id="p69" value="&lt;b&gt;POST · GET /sources&lt;/b&gt; · &lt;b&gt;/sources/:id/inspect&lt;/b&gt; (manage:sources): GenericAdapter verificationConfig (6 scheme · bắt tay · idempotency header|field|path|bodyHash — trang 11) · lắng nghe chẩn đoán raw_event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="20" y="535" width="380" height="80" as="geometry"/></mxCell><mxCell id="p70" value="&lt;b&gt;GET /me&lt;/b&gt; (@NoProjectScope) — key xem chính nó" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p60"><mxGeometry x="420" y="480" width="390" height="50" as="geometry"/></mxCell><mxCell id="p71" value="R-8: route thiếu @RequireScope / @NoProjectScope / @PublicRoute → 500 scope_not_declared" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p60"><mxGeometry x="420" y="550" width="390" height="50" as="geometry"/></mxCell><mxCell id="p72" value="principal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.221;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackground