 as="geometry"/></mxCell><mxCell id="p93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p87" target="p92"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p94" value="&lt;b&gt;hub.subscriptions&lt;/b&gt; ⨝ &lt;b&gt;hub.destinations&lt;/b&gt;&lt;br&gt;(truy vấn Postgres, không cache)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1110" y="784.0" width="320" height="44" as="geometry"/></mxCell><mxCell id="p95" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p92" target="p94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p96" value="&lt;b&gt;⑥b&lt;/b&gt; bỏ qua: event verified=false mà subscription không acceptUnverified (PK5 khoá 4, metric hub_unverified_skipped_total) · đích webhook verification ≠ VERIFIED (S6, ADR-040)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="780" width="490" height="56" as="geometry"/></mxCell><mxCell id="p97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p92" target="p96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p98" value="&lt;b&gt;⑥c repoTx.createDelivery({status: 'PENDING', attemptGeneration: 1})&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="858" width="490" height="56" as="geometry"/></mxCell><mxCell id="p99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p96" target="p98"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p100" value="&lt;b&gt;hub.deliveries&lt;/b&gt; PENDING&lt;br&gt;UNIQUE(event_id, subscription_id, attempt_generation) — chốt 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1110" y="949.0" width="320" height="54" as="geometry"/></mxCell><mxCell id="p101" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p98" target="p100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p102" value="&lt;b&gt;⑥d tx.outbox.create({topic: 'delivery.requested'})&lt;/b&gt; payload = buildDeliveryMessage {deliveryId, tenantId, attemptGeneration: 1, attemptCount: 0, correlationId} + &lt;b&gt;gợi ý destinationId, rateLimitRps&lt;/b&gt; (BP2: delivery gate trước khi nạp DB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="936" width="490" height="70" as="geometry"/></mxCell><mxCell id="p103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p98" target="p102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p104" value="&lt;b&gt;hub.outbox&lt;/b&gt; topic=delivery.requested&lt;br&gt;→ relay → x.hub.delivery / deliver (trang 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1110" y="1039.0" width="320" height="44" as="geometry"/></mxCell><mxCell id="p105" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p102" target="p104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p106" value="Không publish thẳng lên x.hub.delivery (S1-2, ADR-043): tất cả cùng COMMIT hoặc không có gì" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1460" y="1026" width="210" height="70" as="geometry"/></mxCell><mxCell id="p107" value="&lt;b&gt;⑥e&lt;/b&gt; INSERT processed_messages(consumer='normalize', message_id=rawEventId) → &lt;b&gt;COMMIT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1028" width="490" height="56" as="geometry"/></mxCell><mxCell id="p108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p102" target="p107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p109" value="&lt;b&gt;hub.processed_messages&lt;/b&gt; — ghi CÙNG transaction với kết quả" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1110" y="1124.0" width="320" height="44" as="geometry"/></mxCell><mxCell id="p110" value="INSERT + COMMIT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p107" target="p109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p111" value="&lt;b&gt;⑦ redisPub.publish('hub:realtime:events', notice)&lt;/b&gt; — SAU COMMIT, 1 lần / raw event (gộp events[] + deliveries[]), best-effort" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1106" width="490" height="56" as="geometry"/></mxCell><mxCell id="p112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p107" target="p111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p113" value="&lt;b&gt;PUBLISH hub:realtime:events&lt;/b&gt;&lt;br&gt;→ hub-api → Socket.IO event.received" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="1202.0" width="320" height="44" as="geometry"/></mxCell><mxCell id="p114" value="PUBLISH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p111" target="p113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p115" value="BB-2: Redis lỗi → mất realtime, không mất dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="1196" width="210" height="56" as="geometry"/></mxCell><mxCell id="p116" value="&lt;b&gt;⑧ channel.ack(msg)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1184" width="490" height="40" as="geometry"/></mxCell><mxCell id="p117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p111" target="p116"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p118" value="&lt;b&gt;catch → handleFailure()&lt;/b&gt; — classifyNormalizeError = classifyInfraError:&lt;br&gt;transient = Prisma P1001 · P1002 · P1008 · P1017 · P2024 · P2028 · P2034 · PrismaClientInitializationError · ECONNRESET · ETIMEDOUT · ECONNREFUSED · EPIPE · Postgres 57P01–03 · lớp 08 (BP5)&lt;br&gt;còn lại = vĩnh viễn (mặc định). transient → tín hiệu infra_fail cho FailureRateController" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1246" width="490" height="172" as="geometry"/></mxCell><mxCell id="p119" value="transient &amp;amp; DB đang ốm (factor &amp;gt; 0) → &lt;b&gt;retry.30s KHÔNG đốt lượt&lt;/b&gt; (x-normalize-deferred-since, ≤ NORMALIZE_MAX_DEFER_MS 60 phút, BP5) → ack" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="1336" width="250" height="62" as="geometry"/></mxCell><mxCell id="p120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p118" target="p119"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p121" value="transient &amp;amp; x-normalize-retry &amp;lt; 5 → &lt;b&gt;sendToQueue q.normalize.retry.30s&lt;/b&gt; (header +1) → ack" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="1404" width="250" height="49" as="geometry"/></mxCell><mxCell id="p122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.538;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p118" target="p121"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p123" value="vĩnh viễn / hết 5 lượt → nack(requeue=false) → x.hub.normalize.dlx → q.normalize.dlq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="1459" width="250" height="49" as="geometry"/></mxCell><mxCell id="p124" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.858;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p118" target="p123"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p125" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p56" target="p58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p126" value="lỗi ném ở ②–⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p87" target="p118"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="298" y="700"/><mxPoint x="298" y="1365"/></Array></mxGeometry></mxCell><mxCell id="p127" value="&lt;b&gt;emitHubEvent()&lt;/b&gt; (hub-events.ts) — StorageJob / StorageAlerts (QT4b/QT6)&lt;br&gt;validateCanonical → createEvent(source='hub', origin='derived', sourceId=null, idempotency_key='hub:evt_…') → CÙNG routeEventToSubscriptions (không đường gửi riêng). Kiểu: hub.project.storage · hub.project.cleanup_suggested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="594" width="250" height="150" as="geometry"/></mxCell><mxCell id="p128" value="hub.project.*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p127" target="p92"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="806"/></Array></mxGeometry></mxCell><mxCell id="p129" value="&lt;b&gt;Phát lại dựa trên Postgres&lt;/b&gt;: GET /api/v1/raw-events/orphans (raw ACCEPTED chưa có event) → POST /api/v1/raw-events/renormalize → outbox event.received → lại vào q.normalize. DLQ broker chỉ để soi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="250" height="120" as="geometry"/></mxCell><mxCell id="p130" value="&lt;b&gt;Effectively-once&lt;/b&gt;: at-least-once (outbox + manual ack) + consumer idempotent (processed_messages, UNIQUE events/deliveries) — message giao lại không sinh event/delivery thứ hai." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="250" height="100" as="geometry"/></mxCell><mxCell id="p131" value="&lt;b&gt;Catalog kiểu chuẩn — hợp đồng đầu ra (docs/EVENT-CATALOG.md, test U50)&lt;/b&gt;&lt;br&gt;&lt;b&gt;payment.received&lt;/b&gt; · &lt;b&gt;payment.sent&lt;/b&gt; · &lt;b&gt;payment.failed&lt;/b&gt; · &lt;b&gt;payment.refunded&lt;/b&gt; — PayOS (code==='00'), SePay (transferType in/out), Stripe (payment_intent.*, charge.refunded)&lt;br&gt;&lt;b&gt;repo.push&lt;/b&gt; · &lt;b&gt;repo.pull_request.&amp;lt;action&amp;gt;&lt;/b&gt; (closed+merged → repo.pull_request.merged) · &lt;b&gt;repo.issue.&amp;lt;action&amp;gt;&lt;/b&gt; — GitHub&lt;br&gt;&lt;b&gt;github.ping&lt;/b&gt; → normalized:false, &lt;b&gt;probe:true&lt;/b&gt; (lưu, không định tuyến, polling không trả)&lt;br&gt;kiểu khác → &lt;b&gt;&amp;lt;provider&amp;gt;.&amp;lt;kiểu gốc&amp;gt;&lt;/b&gt;, normalized:false, data = {raw}&lt;br&gt;&lt;b&gt;hub.project.storage&lt;/b&gt; · &lt;b&gt;hub.project.cleanup_suggested&lt;/b&gt; — CHỈ hub phát (emitHubEvent)&lt;br&gt;&lt;br&gt;&lt;b&gt;Phong bì gửi đích&lt;/b&gt; (toWebhookBody, dùng chung với hub listen): id · type · source · sourceId · subject · normalized · &lt;b&gt;verified&lt;/b&gt; (PK5) · data · occurredAt · receivedAt · renderedContent?&lt;br&gt;payment.* / repo.* sai khuôn = lỗi normalize vĩnh viễn — KHÔNG hạ cấp âm thầm xuống normalized:false. Nguồn unverified (PK5): kiểu = eventType của source, data = {raw base64, contentType, headers, url?, method} — đích tự verify." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1110" y="1518" width="830" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg5" name="5. Delivery · circuit · retry · replay"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;5 · Giao hàng (delivery.consumer.ts) · gate Lua TRƯỚC khi nạp DB (BP2) · circuit 3 trạng thái OPEN 60s→300s (BP3) · slow-start (BP4) · lease · Standard Webhooks · retry / DEAD · sweeper · replay&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Postgres là trọng tài (deliveries.status, processed_messages, lease claimForSend); Redis chỉ chạy circuit/throttle/ramp và được phép sai (fail-open). ≤ 2 lệnh Redis / delivery (LUA_GATE + PUBLISH); hoãn OPEN / throttle / ramp: 1 lệnh; HALF_OPEN không probe: 2 lệnh (gate + giành probe); 0 truy vấn đọc.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="80" width="250" height="508" as="geometry"/></mxCell><mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="46" height="18" as="geometry"/></mxCell><mxCell id="p5" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="107" width="180" height="24" as="geometry"/></mxCell><mxCell id="p6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="134" width="46" height="18" as="geometry"/></mxCell><mxCell id="p7" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="131" width="180" height="24" as="geometry"/></mxCell><mxCell id="p8" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="158" width="46" height="18" as="geometry"/></mxCell><mxCell id="p9" value="Trạng thái trong bộ nhớ tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="155" width="180" height="24" as="geometry"/></mxCell><mxCell id="p10" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=4;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="182" width="46" height="18" as="geometry"/></mxCell><mxCell id="p11" value="PostgreSQL (bảng)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="179" width="180" height="24" as="geometry"/></mxCell><mxCell id="p12" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="206" width="46" height="18" as="geometry"/></mxCell><mxCell id="p13" value="Redis (khoá · lệnh)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="203" width="180" height="24" as="geometry"/></mxCell><mxCell id="p14" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="230" width="46" height="18" as="geometry"/></mxCell><mxCell id="p15" value="RabbitMQ exchange" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="227" width="180" height="24" as="geometry"/></mxCell><mxCell id="p16" value="" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="254" width="46" height="18" as="geometry"/></mxCell><mxCell id="p17" value="RabbitMQ queue" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="251" width="180" height="24" as="geometry"/></mxCell><mxCell id="p18" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="278" width="46" height="18" as="geometry"/></mxCell><mxCell id="p19" value="Bên ngoài (provider · đích · người)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="275" width="180" height="24" as="geometry"/></mxCell><mxCell id="p20" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1700" y="302" width="46" height="18" as="geometry"/></mxCell><mxCell id="p21" value="Bất biến BB-x được bảo vệ ở đây" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="299" width="180" height="24" as="geometry"/></mxCell><mxCell id="p22" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontS