;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1460" y="386" width="210" height="84" as="geometry"/></mxCell><mxCell id="p79" value="&lt;b&gt;⑤ assertCanonical(events, provider)&lt;/b&gt;: kiểu dành riêng payment.* · repo.* phải qua validateCanonical(type, data); adapter KHÔNG được sinh hub.* (chỉ emitHubEvent). Kiểm TRƯỚC transaction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="402" width="490" height="66" as="geometry"/></mxCell><mxCell id="p80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p74" target="p79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p81" value="CanonicalSchemaError → metric schema_errors → nack(false) → DLQ (lỗi VĨNH VIỄN, không ghi gì)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="492" width="250" height="54" as="geometry"/></mxCell><mxCell id="p82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.409;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p79" target="p81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p83" value="&lt;b&gt;⑤b assertUnverifiedNotReserved(events, raw.verified)&lt;/b&gt; — PK5 khoá 3: raw nhận KHÔNG xác thực mà ra payment.* / repo.* / hub.* → lỗi vĩnh viễn (0 event, 0 delivery)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="490" width="490" height="56" as="geometry"/></mxCell><mxCell id="p84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p79" target="p83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p85" value="CanonicalSchemaError(field='verified') → nack(false) → DLQ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="580" width="250" height="36" as="geometry"/></mxCell><mxCell id="p86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.321;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p83" target="p85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p87" value="&lt;b&gt;⑥ prisma.tenantTx(tenantId) BEGIN&lt;/b&gt; — với mỗi NormalizedEvent: repoTx.createEvent() (idempotency_key = evt.id, type, source, subject, data, normalized, probe, origin, &lt;b&gt;verified&lt;/b&gt; CHÉP từ raw_events — PK5 khoá 2)&lt;br&gt;&lt;b&gt;probe = true&lt;/b&gt; (github.ping, mẫu test PayOS) → lưu cho console, KHÔNG định tuyến" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="568" width="490" height="84" as="geometry"/></mxCell><mxCell id="p88" value="" style="