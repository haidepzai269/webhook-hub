Align=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="453" width="180" height="24" as="geometry"/></mxCell><mxCell id="p40" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="488" width="1" height="1" as="geometry"/></mxCell><mxCell id="p41" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="488" width="1" height="1" as="geometry"/></mxCell><mxCell id="p42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p40" target="p41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p43" value="Redis PUBLISH / SUBSCRIBE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="477" width="180" height="24" as="geometry"/></mxCell><mxCell id="p44" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p45" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="512" width="1" height="1" as="geometry"/></mxCell><mxCell id="p46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;endSize=5;" edge="1" parent="1" source="p44" target="p45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p47" value="message AMQP" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="501" width="180" height="24" as="geometry"/></mxCell><mxCell id="p48" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p49" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="536" width="1" height="1" as="geometry"/></mxCell><mxCell id="p50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;endSize=5;" edge="1" parent="1" source="p48" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="HTTP ra / vào bên ngoài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="525" width="180" height="24" as="geometry"/></mxCell><mxCell id="p52" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p53" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;endSize=5;" edge="1" parent="1" source="p52" target="p53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="nhánh lỗi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="&lt;b&gt;q.delivery.main&lt;/b&gt; → runGated(…, 'delivery'): chờ permit của FailureRateController (trang 9) rồi mới xử lý" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="250" height="76" as="geometry"/></mxCell><mxCell id="p57" value="hub-worker — DeliveryConsumer.handle (prefetch 20, manual ack)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="520" height="1556" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;① parseDeliveryMessage(msg.content)&lt;/b&gt; → {deliveryId, tenantId, attemptGeneration, attemptCount, correlationId} + &lt;b&gt;gợi ý&lt;/b&gt; destinationId, rateLimitRps (ADR-042, BP2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="40" width="490" height="62" as="geometry"/></mxCell><mxCell id="p59" value="hỏng → publish x.hub.delivery.dlx, &lt;b&gt;x-dead-reason=parse_error&lt;/b&gt;; nội dung: JSON object → giữ object, bỏ config/signingSecret/event; không parse được → chỉ {unparsable, bytes, sha256} → ack (BP6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="130" width="265" height="62" as="geometry"/></mxCell><mxCell id="p60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p61" value="&lt;b&gt;② GATE TRƯỚC KHI NẠP&lt;/b&gt; (có gợi ý): circuitBreaker.getState(hint.destinationId, hint.rateLimitRps) = MỘT EVAL LUA_GATE · HALF_OPEN → tryAcquireProbe (EVAL LUA_ACQUIRE_PROBE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="120" width="490" height="104" as="geometry"/></mxCell><mxCell id="p62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p63" value="OPEN / HALF_OPEN không giành probe, chưa quá trần → hoãn như ④ — &lt;b&gt;0 truy vấn đọc&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="210" width="265" height="36" as="geometry"/></mxCell><mxCell id="p64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.173;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="vượt throttle / ramp → &lt;b&gt;sendToQueue q.delivery.retry.10s&lt;/b&gt; → ack — 0 DB" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="252" width="265" height="36" as="geometry"/></mxCell><mxCell id="p66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.577;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p67" value="&lt;b&gt;LUA_GATE&lt;/b&gt; KEYS circuit:{id}:open · :failures · &lt;b&gt;throttle:destination:{id}:{giây}&lt;/b&gt; · &lt;b&gt;:ramp&lt;/b&gt; → {open, failures, PTTL(:open), count, rampCap}. INCR chỉ khi CLOSED và có trần. Redis lỗi → fail-open CLOSED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1125" y="245" width="315" height="83" as="geometry"/></mxCell><mxCell id="p68" value="1 EVAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=1;exitY=0.865;exitDx=0;exitDy=0;entryX=0;entryY=0.663;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p69" value="Message thiếu gợi ý (kiểu cũ) bỏ qua ②, gate sau khi nạp ở ③" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="210" width="205" height="104" as="geometry"/></mxCell><mxCell id="p70" value="&lt;b&gt;③ repo.findDeliveryForSend(deliveryId)&lt;/b&gt; — MỘT truy vấn đã scope tenant: delivery + event + subscription + destination" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="242" width="490" height="62" as="geometry"/></mxCell><mxCell id="p71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p61" target="p70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p72" value="không còn / khác tenant → ack (nhả probe)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="332" width="265" height="36" as="geometry"/></mxCell><mxCell id="p73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.29;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p74" value="&lt;b&gt;hub.deliveries&lt;/b&gt; ⨝ events ⨝ subscriptions ⨝ destinations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1125" y="358.0" width="315" height="44" as="geometry"/></mxCell><mxCell id="p75" value="SELECT (1 câu)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.774;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p76" value="BB-5: tenant từ message; TenantScopedRepository (forTenant) + RLS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1465" y="332" width="205" height="62" as="geometry"/></mxCell><mxCell id="p77" value="&lt;b&gt;③b&lt;/b&gt; đích đã lưu trữ (archived_at) → repo.abandonDelivery()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="322" width="490" height="40" as="geometry"/></mxCell><mxCell id="p78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p79" value="DEAD (destination_archived), không gửi → ack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="412" width="265" height="36" as="geometry"/></mxCell><mxCell id="p80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p81" value="&lt;b&gt;③c kiểm gợi ý với row thật (C9)&lt;/b&gt;: thiếu gợi ý / lệch đích → gate lại bằng id thật (1 lệnh, hiếm) · rps lệch → recheckThrottle (so lại count đã INCR, không đếm hai lần) · syncObserved(): trạng thái quan sát ≠ destinations.circuit_state → UPDATE có điều kiện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="380" width="490" height="69" as="geometry"/></mxCell><mxCell id="p82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p83" value="&lt;b&gt;hub.destinations&lt;/b&gt;.circuit_state + &lt;b&gt;circuit_half_open_at&lt;/b&gt; (chỉ để hiển thị) · PUBLISH &lt;b&gt;hub:realtime:circuit&lt;/b&gt; (bên đổi được dòng)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1125" y="477.5" width="315" height="54" as="geometry"/></mxCell><mxCell id="p84" value="UPDATE khi đổi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p81" target="p83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p85" value="&lt;b&gt;④ hoãn vì circuit&lt;/b&gt; (OPEN, hoặc HALF_OPEN không có probe) — circuitDeferDecision(headers): x-circuit-deferred-since; now − since ≤ &lt;b&gt;CIRCUIT_MAX_DEFER_MS (30 phút)&lt;/b&gt; → deferForCircuit: tầng = circuitDeferTier(PTTL của :open) · attemptCount GIỮ NGUYÊN · next_attempt_at ghi THƯA ≤ 1 lần/2 phút (x-defer-written-at). Quá trần → MỘT lần thử thất bại status 0 (không gọi đích, KHÔNG ghi circuit) → ⑥ ⑦ → ⑩ ⑫" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="467" width="490" height="97" as="geometry"/></mxCell><mxCell id="p86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p81" target="p85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p87" value="&lt;b&gt;sendToQueue q.delivery.retry.1m&lt;/b&gt; (OPEN 60s · HALF_OPEN không probe) | &lt;b&gt;q.delivery.retry.5m&lt;/b&gt; (OPEN 300s) → ack · DEFERRED không PUBLISH" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="557" width="265" height="62" as="geometry"/></mxCell><mxCell id="p88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p85" target="p87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p89" value="repo.deferDelivery: &lt;b&gt;deliveries.next_attempt_at&lt;/b&gt; = now + TTL tầng (thưa)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1125" y="618.0" width="315" height="44" as="geometry"/></mxCell><mxCell id="p90" value="UPDATE thưa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.856;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p85" target="p89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p91" value="BP3 (ADR-197): hoãn tới HẾT OPEN theo PTTL thật — đích chết lâu tốn ~1 lệnh Redis / 5 phút / message thay vì / phút" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="557" width="205" height="97" as="geometry"/></mxCell><mxCell id="p92" value="&lt;b&gt;⑤ throttle + slow-start&lt;/b&gt; (CLOSED; bộ đếm đã tăng trong LUA_GATE): trần = min(rate_limit_rps nếu &amp;gt; 0, rampCap) — cửa sổ cố định 1s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="582" width="490" height="64" as="geometry"/></mxCell><mxCell id="p93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p85" target="p92"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p94" value="vượt → &lt;b&gt;sendToQueue q.delivery.retry.10s&lt;/b&gt; → ack (nhả probe), không tăng lượt, không ghi DB" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="672" width="265" height="49" as="geometry"/></mxCell><mxCell id="p95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.383;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p92" target="p94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p96" value="BP4 (ADR-198): rampCap = 2 × 2^⌊(now − rampStart)/10s⌋ → 2·4·8·16·32·64 rps trong DELIVERY_RAMP_SECONDS = 60" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1465" y="672" width="205" height="64" as="geometry"/></mxCell><mxCell id="p97" value="&lt;b&gt;⑥ renderTemplate(subscription.template, event)&lt;/b&gt; · chốt 5: processedMessage.findUnique({consumer: 'delivery', messageId}) với messageId = deliveryId:generation:attemptNo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="664" width="490" height="62" as="geometry"/></mxCell><mxCell id="p98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p92" target="p97"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p99" value="đã xử lý → ack (nhả probe)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="754" width="265" height="36" as="geometry"/></mxCell><mxCell id="p100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.29;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p97" target="p99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p101" value="&lt;b&gt;hub.processed_messages&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1125" y="780.0" width="315" height="44" as="geometry"/></mxCell><mxCell id="p102" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.774;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p97" target="p101"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p103" value="&lt;b&gt;⑦ lease repo.claimForSend(deliveryId, generation, attemptCount)&lt;/b&gt;: UPDATE deliveries SET status='DELIVERING' WHERE status/generation/attempt_count khớp (lease 60s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="744" width="490" height="75" as="geometry"/></mxCell><mxCell id="p104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p97" target="p103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p105" value="0 dòng, lease DELIVERING còn hạn → &lt;b&gt;sendToQueue q.delivery.retry.1m&lt;/b&gt;; đã xong / sang lần khác → ack" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="834" width="265" height="49" as="geometry"/></mxCell><mxCell id="p106" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.327;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p103" target="p105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p107" value="&lt;b&gt;hub.deliveries&lt;/b&gt; → DELIVERING (UPDATE có điều kiện)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1125" y="873.0" width="315" height="44" as="geometry"/></mxCell><mxCell id="p108" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.813;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p103" target="p107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p109" value="&lt;b&gt;⑧ giải mã&lt;/b&gt; config + signing secret (AES-256-GCM) NGAY LÚC GỬI · SenderRegistry.get(type) · &lt;b&gt;WebhookSender.send()&lt;/b&gt;: SSRF guard · body = toWebhookBody(event) (có &lt;b&gt;verified&lt;/b&gt;, PK5) · &lt;b&gt;webhook-id&lt;/b&gt; = event.id · &lt;b&gt;webhook-timestamp&lt;/b&gt; · &lt;b&gt;webhook-signature&lt;/b&gt; = v1,base64(HMAC-SHA256(whsec, id.ts.body)) · timeout DELIVERY_TIMEOUT_MS (5s, kẹp 1–10s) · không follow redirect · đọc ≤ 64 KB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="837" width="490" height="97" as="geometry"/></mxCell><mxCell id="p110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p103" target="p109"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p111" value="&lt;b&gt;Đích&lt;/b&gt;: endpoint webhook (VERIFIED) · Shop POST /hub-webhook · Telegram · Discord (nhãn “chưa xác thực” nếu verified=false)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1125" y="948.5" width="315" height="54" as="geometry"/></mxCell><mxCell id="p112" value="POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p109" target="p111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p113" value="&lt;b&gt;⑨ kết quả → circuit&lt;/b&gt; (http-outcome.ts) — 2xx → recordSuccess: failures = 0 &amp;amp; CLOSED → 0 lệnh; probe HALF_OPEN → LUA_CLOSE_AND_RAMP (DEL failures/open/probe/trips + SET :ramp EX 60); còn lại DEL 4 khoá · 5xx/408/429/mạng → recordFailure: EVAL INCR :failures EX 120; ≥ 5 → MULTI SET :open EX &lt;b&gt;60&lt;/b&gt; (lần đầu) | EX &lt;b&gt;300&lt;/b&gt; (probe lỗi, :trips+1), DEL :probe :ramp · probe nhận 4xx khác → nhả probe, giữ HALF_OPEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="952" width="490" height="97" as="geometry"/></mxCell><mxCell id="p114" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p109" target="p113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p115" value="&lt;b&gt;circuit:{id}:failures|open|probe|trips|ramp&lt;/b&gt; · OPEN: circuit_half_open_at = now + TTL vừa đặt (“Thử lại lúc …”)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1125" y="1063.5" width="315" height="54" as="geometry"/></mxCell><mxCell id="p116" value="EVAL / MULTI / DEL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p113" target="p115"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p117" value="&lt;b&gt;⑩ prisma.tenantTx(tenantId)&lt;/b&gt;: INSERT delivery_attempts (status, duration_ms, body ≤ 2 KB, error) · UPDATE deliveries (status, attempt_count, next_attempt_at, last_error) · INSERT processed_messages — CÙNG transaction" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1067" width="490" height="62" as="geometry"/></mxCell><mxCell id="p118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p113" target="p117"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p119" value="P2002 processed_messages → worker khác đã xử lý → ack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="1157" width="265" height="36" as="geometry"/></mxCell><mxCell id="p120" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.29;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p117" target="p119"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p121" value="&lt;b&gt;hub.delivery_attempts&lt;/b&gt; · &lt;b&gt;hub.deliveries&lt;/b&gt;&lt;br&gt;&lt;b&gt;hub.processed_messages&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1125" y="1169" width="315" height="64" as="geometry"/></mxCell><mxCell id="p122" value="INSERT / UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=1;exitY=0.774;exitDx=0;exitDy=0;entryX=0;entryY=0.562;entryDx=0;entryDy=0;" edge="1" parent="1" source="p117" target="p121"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p123" value="BB-2: Postgres là trọng tài trạng thái; DLQ broker chỉ là bản sao" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffffff;strokeColor=#c00000;strokeWidth=2;fontColor=#c00000;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1465" y="1157" width="205" height="62" as="geometry"/></mxCell><mxCell id="p124" value="&lt;b&gt;⑪ redisPub.publish('hub:realtime:deliveries')&lt;/b&gt; — SUCCEEDED / RETRYING / DEAD (DEFERRED không publish) · metric hub_deliveries_total" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1147" width="490" height="40" as="geometry"/></mxCell><mxCell id="p125" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p117" target="p124"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p126" value="&lt;b&gt;PUBLISH hub:realtime:deliveries&lt;/b&gt; → Socket.IO delivery.attempt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1125" y="1235.0" width="315" height="44" as="geometry"/></mxCell><mxCell id="p127" value="PUBLISH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;dashed=1;dashPattern=1 3;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p124" target="p126"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p128" value="&lt;b&gt;⑫ định tuyến kết quả&lt;/b&gt; — isNonRetryableHttpStatus · getNextRetryQueue(attemptNo)&lt;br&gt;tổng 6 lần gửi = 1 lần đầu + 5 tầng (10s · 1m · 5m · 30m · 2h); lần thử mới → freshAttemptHeaders (xoá since, reset bộ đếm hoãn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1205" width="490" height="159" as="geometry"/></mxCell><mxCell id="p129" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p124" target="p128"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p130" value="2xx → &lt;b&gt;SUCCEEDED&lt;/b&gt; → ack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#2d7a2d;strokeWidth=2;fontColor=#2d7a2d;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="1295" width="265" height="36" as="geometry"/></mxCell><mxCell id="p131" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.113;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p128" target="p130"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p132" value="retryable còn tầng → &lt;b&gt;RETRYING&lt;/b&gt;, next_attempt_at = now + TTL → &lt;b&gt;sendToQueue q.delivery.retry.{10s|1m|5m|30m|2h}&lt;/b&gt; (x-attempt) → ack" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="1337" width="265" height="62" as="geometry"/></mxCell><mxCell id="p133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.459;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p128" target="p132"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p134" value="4xx (trừ 408/429) → DEAD ngay; hết 5 tầng → &lt;b&gt;DEAD&lt;/b&gt; → publish &lt;b&gt;x.hub.delivery.dlx / dead&lt;/b&gt; (bản sao) → ack" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#ffffff;strokeColor=#cc0000;dashed=1;fontColor=#cc0000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="1405" width="265" height="49" as="geometry"/></mxCell><mxCell id="p135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.846;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p128" target="p134"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p136" value="&lt;b&gt;catch ngoài cùng (BP1, ADR-195)&lt;/b&gt; — nhả probe đang giữ · classifyInfraError(err) (Prisma P1001/P1002/P1008/P1017/P2024/P2028/P2034, init, ECONNRESET/ETIMEDOUT/ECONNREFUSED/EPIPE, Postgres 57P01–03, lớp 08)&lt;br&gt;KHÔNG BAO GIỜ nack(requeue=true); attemptCount không tăng (lỗi của hub). Kết quả trả về cho bộ điều khiển áp lực ngược: transient = infra_fail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="15" y="1382" width="490" height="146" as="geometry"/></mxCell><mxCell id="p137" value="transient → &lt;b&gt;sendToQueue q.delivery.retry.10s&lt;/b&gt; (x-infra-deferrals + 1; LogThrottle ≤ 1 dòng / 30s)" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="1472" width="265" height="49" as="geometry"/></mxCell><mxCell id="p138" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.168;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136" target="p137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCe