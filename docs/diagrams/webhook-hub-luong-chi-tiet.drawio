="1" source="p22" target="p35"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="378"/><mxPoint x="1010" y="592"/></Array></mxGeometry></mxCell><mxCell id="p39" value="&lt;b&gt;q.normalize&lt;/b&gt; · durable&lt;br&gt;x-dead-letter-exchange = x.hub.normalize.dlx · rk = dead" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="360" height="64" as="geometry"/></mxCell><mxCell id="p40" value="&lt;b&gt;q.normalize.retry.30s&lt;/b&gt; · x-message-ttl = 30000&lt;br&gt;DLX = x.hub.events · rk = event.received (không bind — sendToQueue)&lt;br&gt;dùng cho: lỗi tạm (x-normalize-retry ≤ 5) · hoãn KHÔNG đốt lượt khi DB ốm + spill (x-normalize-deferred-since ≤ 60 phút, BP5)" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="222" width="360" height="92" as="geometry"/></mxCell><mxCell id="p41" value="&lt;b&gt;q.normalize.dlq&lt;/b&gt; · durable (không consumer)" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="330" width="360" height="64" as="geometry"/></mxCell><mxCell id="p42" value="&lt;b&gt;q.delivery.main&lt;/b&gt; · durable&lt;br&gt;&lt;b&gt;KHÔNG có DLX&lt;/b&gt; (nack(false) = vứt message)" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="560" width="360" height="64" as="geometry"/></mxCell><mxCell id="p43" value="5 tầng retry (1 queue/tầng) — cả hàng HOÃN" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#d79b00;fontColor=#d79b00;" vertex="1" parent=