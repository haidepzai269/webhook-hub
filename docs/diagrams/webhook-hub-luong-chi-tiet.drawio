></mxGeometry></mxCell><mxCell id="p144" value="lỗi ném ở ②–⑫" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p136"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="298" y="375.4"/><mxPoint x="298" y="1515.8"/></Array></mxGeometry></mxCell><mxCell id="p145" value="Circuit theo ĐÍCH (Redis chạy)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#a50021;fontColor=#a50021;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="250" height="640" as="geometry"/></mxCell><mxCell id="p146" value="CLOSED&lt;br&gt;&lt;span style='font-weight:normal'&gt;gửi; throttle nếu rps &amp;gt; 0&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="170" height="56" as="geometry"/></mxCell><mxCell id="p147" value="CLOSED + ramp&lt;br&gt;&lt;span style='font-weight:normal'&gt;:ramp EX 60 · 2→64 rps&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#e2efda;strokeColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="170" height="56" as="geometry"/></mxCell><mxCell id="p148" value="OPEN&lt;br&gt;&lt;span style='font-weight:normal'&gt;:open EX 60 (lần đầu)&lt;br&gt;EX 300 sau probe lỗi&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#f8cecc;strokeColor=#a50021;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="170" height="66" as="geometry"/></mxCell><mxCell id="p149" value="HALF_OPEN&lt;br&gt;&lt;span style='font-weight:normal'&gt;suy ra, KHÔNG lưu&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="170" height="56" as="geometry"/></mxCell><mxCell id="p150" value="≥ 5 lỗi 5xx/408/429/mạng&lt;br&gt;trong :failures (120s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p146" target="p148"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="77" y="450"/></Array></mxGeometry></mxCell><mxCell id="p151" value=":open hết hạn mà&lt;br&gt;failures ≥ 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p148" target="p149"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p152" value="probe lỗi → 300s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p149" target="p148"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p153" value="probe 2xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p149" target="p147"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="258" y="668"/><mxPoint x="258" y="358"/></Array></mxGeometry></mxCell><mxCell id="p154" value="hết 60s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p147" target="p146"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p155" value="lỗi đủ ngưỡng → DEL :ramp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#a50021;fontColor=#a50021;strokeWidth=1.5;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p147" target="p148"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p156" value="probe = đúng 1 (SET :probe token NX EX 30) · probe 4xx khác → nhả, giữ HALF_OPEN · mạch tự về CLOSED (khoá hết hạn) thì KHÔNG ramp · Redis chết → fail-open · CIRCUIT_OPEN_MAX_SECONDS kẹp 60..300 (chỉ được thấp hơn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="230" height="112" as="geometry"/></mxCell><mxCell id="p157" value="hub-worker — DeliverySweeper" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="250" height="340" as="geometry"/></mxCell><mxCell id="p158" value="60s ±10s · prisma.systemTx('sweeper: delivery kẹt')&lt;br&gt;WITH stuck … FOR UPDATE OF d SKIP LOCKED LIMIT 100:&lt;br&gt;· PENDING &amp;gt; 10' chưa attempt, next_attempt_at NULL hoặc cũ (hoãn hợp lệ thì bỏ qua)&lt;br&gt;· DELIVERING treo &amp;gt; 10'&lt;br&gt;· RETRYING quá next_attempt_at + 5'&lt;br&gt;→ INSERT outbox &lt;b&gt;delivery.requested&lt;/b&gt; (kèm gợi ý destinationId, rateLimitRps)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p157"><mxGeometry x="10" y="36" width="230" height="196" as="geometry"/></mxCell><mxCell id="p159" value="Bản trùng an toàn: lease claimForSend + processed_messages chỉ cho MỘT lần gửi (bỏ qua delivery còn outbox chưa publish)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p157"><mxGeometry x="10" y="242" width="230" height="88" as="geometry"/></mxCell><mxCell id="p160" value="hub-api — replay (api.controller.ts)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1240" width="250" height="400" as="geometry"/></mxCell><mxCell id="p161" value="&lt;b&gt;POST /api/v1/deliveries/:id/replay&lt;/b&gt; — chỉ delivery DEAD, generation MỚI NHẤT (không → 409); event chưa xác thực chỉ khi subscription còn acceptUnverified (PK5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p160"><mxGeometry x="10" y="36" width="230" height="110" as="geometry"/></mxCell><mxCell id="p162" value="&lt;b&gt;POST /api/v1/deliveries/replay-bulk&lt;/b&gt; — lọc DLQ theo đích / thời gian / lý do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p160"><mxGeometry x="10" y="156" width="230" height="84" as="geometry"/></mxCell><mxCell id="p163" value="tenantTx: INSERT deliveries (attempt_generation + 1, PENDING) · INSERT outbox &lt;b&gt;delivery.replayed&lt;/b&gt; (kèm gợi ý) · INSERT audit_logs — CÙNG TX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p160"><mxGeometry x="10" y="250" width="230" height="140" as="geometry"/></mxCell><mxCell id="p164" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p161" target="p163"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="53" y="1490"/></Array></mxGeometry></mxCell><mxCell id="p165" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p162" target="p163"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p166" value="&lt;b&gt;hub.outbox&lt;/b&gt;&lt;br&gt;delivery.requested / delivery.replayed&lt;br&gt;→ OutboxRelay → x.hub.delivery / deliver → q.delivery.main" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1680" width="230" height="110" as="geometry"/></mxCell><mxCell id="p167" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p163" target="p166"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p168" value="INSERT … SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#1e5a1e;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p158" target="p166"><mxGeometry x="0.8" relative="1" as="geometry"><Array as="points"><mxPoint x="12" y="1004"/><mxPoint x="12" y="1735"/></Array></mxGeometry></mxCell><mxCell id="p169" value="relay (trang 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p166" target="p56"><mxGeometry x="0.85" relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="1735"/><mxPoint x="280" y="190"/><mxPoint x="145" y="190"/></Array></mxGeometry></mxCell><mxCell id="p170" value="&lt;b&gt;UNIQUE(event_id, subscription_id, attempt_generation)&lt;/b&gt; (chốt 4): replay = generation + 1 → không đụng unique, lịch sử cũ giữ nguyên. webhook-id = event.id không đổi → đích tự chống trùng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="1820" width="250" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg6" name="6. Đa project · API key · RLS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2" value='&lt;b style="font-size:20px"&gt;6 · Đa project / API: /v1/p/:project/* (API key + scope) · polling theo cursor (poll_seq) · endpoint challenge · console · ba lớp cô lập (BB-5)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#444"&gt;Project = biên cô lập; cột tenant_id ở mọi bảng nghĩa là project_id. Service và người dùng chung MỘT ngôn ngữ quyền (@RequireScope).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1920" height="56" as="geometry"/></mxCell><mxCell id="p3" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1690" y="80" width="250" height="508" as="geometry"/></mxCell><mxCell id="p4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="46" height="18" as="geometry"/></mxCell><mxCell id="p5" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="107" width="180" height="24" as="geometry"/></mxCell><mxCell id="p6" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="134" width="46" height="18" as="geometry"/></mxCell><mxCell id="p7" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;al