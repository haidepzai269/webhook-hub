ông consumer) — 3 loại bản sao:&lt;br&gt;DEAD (không header) · x-dead-reason=unknown_error · x-dead-reason=parse_error (object bỏ config/secret/event, hỏng → chỉ giữ chỗ; BP6)" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="1010" width="360" height="64" as="geometry"/></mxCell><mxCell id="p50" value="bind event.received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33" target="p39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="nack(requeue=false) → dead-letter rk=dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p39" target="p34"><mxGeometry x="0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="1262" y="194"/><mxPoint x="1262" y="312"/><mxPoint x="1130" y="312"/></Array></mxGeometry></mxCell><mxCell id="p52" value="bind dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34" target="p41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p53" value="hết TTL 30s → dead-letter rk=event.received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p40" target="p33"><mxGeometry x="-0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="260"/></Array></mxGeometry></mxCell><mxCell id="p54" value="bind deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35" target="p42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="hết TTL → dead-letter rk=deliver → quay về q.delivery.main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p43" target="p35"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="800"/></Array></mxGeometry></mxCell><mxCell id="p56" value="bind dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p36" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p57" value="hub-worker — consumers (main.ts)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1690" y="90" width="250" height="700" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;NormalizeConsumer&lt;/b&gt; — channel riêng · prefetch 20 · manual ack · runGated (permit, trang 9)&lt;br&gt;lỗi tạm → retry.30s (x-normalize-retry ≤ 5; DB ốm → không đốt lượt)&lt;br&gt;vĩnh viễn / hết lượt → nack(false)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="10" y="34" width="230" height="124" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;DeliveryConsumer&lt;/b&gt; — channel riêng · prefetch 20 · manual ack · runGated&lt;br&gt;lỗi đích retryable → tầng kế (x-attempt)&lt;br&gt;HOÃN (attempt giữ nguyên): circuit → 1m | 5m · throttle/ramp/lỗi hạ tầng/spill → 10s · lease/lỗi lạ → 1m&lt;br&gt;DEAD · lỗi lạ lần 5 · parse lỗi → publish x.hub.delivery.dlx" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="10" y="418" width="230" height="192" as="geometry"/></mxCell><mxCell id="p60" value="&lt;b&gt;1 AMQP connection / tiến trình&lt;/b&gt;, nhiều channel: setup · confirm (relay) · normalize · delivery. Mất connection HOẶC channel consumer đóng (BP5) → process.exit để orchestrator dựng lại; message chưa ack được trả về queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p57"><mxGeometry x="10" y="172" width="230" height="150" as="geometry"/></mxCell><mxCell id="p61" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="p39" target="p58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p62" value="sendToQueue (lỗi tạm)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p40"><mxGeometry x="0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p63" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p42" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p64" value="sendToQueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p43"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1769" y="710"/></Array></mxGeometry></mxCell><mxCell id="p65" value="publish rk=dead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p36"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1815" y="1110"/><mxPoint x="1130" y="1110"/></Array></mxGeometry></mxCell><mxCell id="p66" value="&lt;b&gt;Policy hub-dlq-bounded&lt;/b&gt; (DLQ_POLICY): pattern ^q\.(delivery|normalize)\.dlq$ · max-length 5000 · overflow drop-head · priority 10.&lt;br&gt;KHÔNG đặt x-max-length vào arguments (đổi argument queue đã tồn tại → PRECONDITION_FAILED, cạm bẫy 3). LOCAL: service rabbitmq-init đặt; DEPLOYED (CloudAMQP): đặt tay qua management API. DLQ broker chỉ là BẢN SAO để soi — nguồn sự thật là Postgres (deliveries.status='DEAD', raw_events)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="1130" width="640" height="120" as="geometry"/></mxCell><mxCell id="p67" value="&lt;b&gt;Vì sao Outbox?&lt;/b&gt; Ghi DB và publish broker không thể nguyên tử. Ghi outbox CÙNG transaction với dữ liệu → COMMIT là đủ để không mất; relay publish sau (có thể trùng → consumer chống trùng bằng processed_messages, at-least-once + idempotent = effectively-once).&lt;br&gt;&lt;b&gt;Payload chỉ là tham chiếu&lt;/b&gt; (ADR-042): event.received = {rawEventId, sourceId, tenantId, provider, correlationId}; delivery.* = {deliveryId, tenantId, attemptGeneration, attemptCount, correlationId} — không secret, không body.&lt;br&gt;&lt;b&gt;Không jitter ở tầng retry&lt;/b&gt;: TTL theo queue, không theo message (§5.4c) — thay bằng slow-start theo đích (BP4). Tổng 6 lần gửi = 1 + 5 tầng. Thêm hoãn KHÔNG thêm queue: OPEN 60s/300s khớp đúng retry.1m/retry.5m (ADR-197)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="720" width="590" height="120" as="geometry"/></mxCell><mxCell id="p68" value="&lt;b&gt;Không publish thẳng&lt;/b&gt; lên x.hub.delivery từ normalize (S1-2, ADR-043): mọi delivery đi qua outbox → hoặc tất cả cùng COMMIT, hoặc không có gì. Hoãn/retry trong delivery consumer thì dùng sendToQueue thẳng vào queue retry (default exchange)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="390" y="860" width="590" height="64" as="geometry"/></mxCell><mxCell id="p69" value="Chú giải" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;strokeColor=#555555;fontColor=#333333;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="330" height="508" as="geometry"/></mxCell><mxCell id="p70" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f5597;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="46" height="18" as="geometry"/></mxCell><mxCell id="p71" value="Tiến trình (swimlane)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="747" width="260" height="24" as="geometry"/></mxCell><mxCell id="p72" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="774" width="46" height="18" as="geometry"/></mxCell><mxCell id="p73" value="Bước xử lý trong tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="771" width="260" height="24" as="geometry"/></mxCell><mxCell id="p74" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="798" width="46" height="18" as="geometry"/></mxCell><mxCell id="p75" value="Trạng thái trong bộ nhớ tiến trình" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="795" width="260" height="24" as="geometry"/></mxCell><mxCell id="p76" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=4;fillColor=#d5e8d4;strokeColor=#2d7a2d;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="822" width="46" height="18" as="geometry"/></mxCell><mxCell id="p77" value="PostgreSQL (bảng)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="819" width="260" height="24" as="geometry"/></mxCell><mxCell id="p78" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#a50021;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="846" width="46" height="18" as="geometry"/></mxCell><mxCell id="p79" value="Redis (khoá · lệnh)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="843" width="260" height="24" as="geometry"/></mxCell><mxCell id="p80" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="46" height="18" as="geometry"/></mxCell><mxCell id="p81" value="RabbitMQ exchange" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="867" width="260" height="24" as="geometry"/></mxCell><mxCell id="p82" value="" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="1"