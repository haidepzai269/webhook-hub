e;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7030a0;fontColor=#5b2382;strokeWidth=1.5;endSize=5;" edge="1" parent="1" source="p48" target="p49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p51" value="HTTP ra / vào bên ngoài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="525" width="180" height="24" as="geometry"/></mxCell><mxCell id="p52" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1698" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p53" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1746" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="p54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;endSize=5;" edge="1" parent="1" source="p52" target="p53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p55" value="nhánh lỗi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1752" y="549" width="180" height="24" as="geometry"/></mxCell><mxCell id="p56" value="hub-worker main.ts — mỗi tiến trình" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="380" height="560" as="geometry"/></mxCell><mxCell id="p57" value="&lt;b&gt;q.normalize&lt;/b&gt;&lt;br&gt;channel riêng · prefetch 20" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="38" width="170" height="60" as="geometry"/></mxCell><mxCell id="p58" value="&lt;b&gt;q.delivery.main&lt;/b&gt;&lt;br&gt;channel riêng · prefetch 20" style="shape=process;whiteSpace=wrap;html=1;size=0.06;fillColor=#fff2e6;strokeColor=#d79b00;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="200" y="38" width="170" height="60" as="geometry"/></mxCell><mxCell id="p59" value="&lt;b&gt;runGated(controller, lane, handler, msg)&lt;/b&gt; (backpressure/gate.ts)&lt;br&gt;await controller.acquire(lane) — message vẫn UNACKED trong lúc chờ (worker chết → RabbitMQ giao lại); prefetch giữ 20, không đổi basic.qos lúc chạy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="130" width="360" height="120" as="geometry"/></mxCell><mxCell id="p60" value="&lt;b&gt;permit&lt;/b&gt; → handleMessage → release; CHỈ message có permit vào inFlight" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="10" y="270" width="115" height="120" as="geometry"/></mxCell><mxCell id="p61" value="&lt;b&gt;timeout&lt;/b&gt;: chờ quá 60s (BACKPRESSURE_ HOLD_MAX_MS) → &lt;b&gt;spill&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="132" y="270" width="115" height="120" as="geometry"/></mxCell><mxCell id="p62" value="&lt;b&gt;shutdown&lt;/b&gt; → KHÔNG xử lý, KHÔNG republish, KHÔNG ack (C5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p56"><mxGeometry x="255" y="270" width="115" height="120" as="geometry"/></mxCell><mxCell id="p63" value="&lt;b&gt;spill&lt;/b&gt; — republish KHÔNG đốt lượt rồi ack:&lt;br&gt;· normalize → &lt;b&gt;q.normalize.retry.30s&lt;/b&gt;, gắn/giữ x-normalize-deferred-since; quá NORMALIZE_MAX_DEFER_MS (60') → đốt x-normalize-retry; hết 5 → nack → DLQ&lt;br&gt;· delivery → &lt;b&gt;q.delivery.retry.10s&lt;/b&gt;, giữ header + attemptCount (không cần trần: Postgres còn PENDING/RETRYING, sweeper hồi sinh)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p56"><mxGeometry x="10" y="410" width="360" height="140" as="geometry"/></mxCell><mxCell id="p64" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p57" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p65" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;fontColor=#8a5a00;dashed=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p58" target="p59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.16;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.84;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p69" value="FailureRateController('db') — failure-rate.controller.ts (bộ nhớ, 0 Redis)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="90" width="560" height="560" as="geometry"/></mxCell><mxCell id="p70" value="&lt;b&gt;record(outcome)&lt;/b&gt; — bucket 1s trong cửa sổ trượt &lt;b&gt;30s&lt;/b&gt;&lt;br&gt;normalize: transient → infra_fail · xử lý xong → ok · lỗi dữ liệu → không ghi&lt;br&gt;delivery: catch transient → infra_fail · xong có chạm DB → ok (kể cả đích 5xx/4xx/timeout) · hoãn trước khi nạp ('nodb') / lỗi lạ → không ghi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="38" width="540" height="100" as="geometry"/></mxCell><mxCell id="p71" value="&lt;b&gt;tick() mỗi 1s&lt;/b&gt; (AIMD đảo chiều): tỷ lệ lỗi &amp;gt; set point &lt;b&gt;5%&lt;/b&gt; (≥ 10 mẫu) → factor &lt;b&gt;+0.25&lt;/b&gt; (lùi nhanh); ngược lại &lt;b&gt;−0.1&lt;/b&gt; (hồi chậm). Thiếu mẫu mà cửa sổ còn lỗi → GIỮ factor (chế độ dò chỉ ~6 mẫu/30s). Metric hub_backpressure_factor{dependency}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="150" width="540" height="92" as="geometry"/></mxCell><mxCell id="p72" value="&lt;b&gt;permits mỗi lane&lt;/b&gt; = max(1, ⌈20 × (1 − factor)⌉) — MỘT factor, HAI semaphore (normalize | delivery, review TB-1): đích chậm giữ permit delivery không làm chậm normalize của tenant khác" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="254" width="540" height="70" as="geometry"/></mxCell><mxCell id="p73" value="&lt;b&gt;lane normalize&lt;/b&gt; — MAX 20 · inUse · waiters" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="10" y="336" width="265" height="56" as="geometry"/></mxCell><mxCell id="p74" value="&lt;b&gt;lane delivery&lt;/b&gt; — MAX 20 · inUse · waiters" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f2f2f2;strokeColor=#7f7f7f;dashed=1;fontColor=#000000;fontSize=11;" vertex="1" parent="p69"><mxGeometry x="285" y="336" width="265" height="56" as="geometry"/></mxCell><mxCell id="p75" value="Khoẻ&lt;br&gt;&lt;span style='font-weight:normal'&gt;factor 0 · 20 permit/lane&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#e2efda;strokeColor=#2d7a2d;" vertex="1" parent="p69"><mxGeometry x="20" y="420" width="150" height="70" as="geometry"/></mxCell><mxCell id="p76" value="Ốm&lt;br&gt;&lt;span style='font-weight:normal'&gt;0 &amp;lt; factor &amp;lt; 1 · normalize hoãn không đốt lượt&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p69"><mxGeometry x="205" y="420" width="150" height="70" as="geometry"/></mxCell><mxCell id="p77" value="Dò&lt;br&gt;&lt;span style='font-weight:normal'&gt;factor 1 · 1 msg / 5s / lane&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fillColor=#f8cecc;strokeColor=#a50021;" vertex="1" parent="p69"><mxGeometry x="390" y="420" width="150" height="70" as="geometry"/></mxCell><mxCell id="p78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p70" target="p71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p71" target="p72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p72" target="p73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p72" target="p74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p82" value="lỗi &amp;gt; 5%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p75" target="p76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p83" value="+0.25/s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#cc0000;fontColor=#cc0000;dashed=1;dashPattern=6 3;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p76" target="p77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p84" value="−0.1/s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p77" target="p76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p85" value="khoẻ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#2d7a2d;fontColor=#2d7a2d;strokeWidth=2.5;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p76" target="p75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p86" value="acquire(lane)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p59" target="p69"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p87" value="&lt;b&gt;classifyInfraError(err)&lt;/b&gt; (consumers/infra-errors.ts — dùng chung normalize + delivery)&lt;br&gt;&lt;b&gt;transient&lt;/b&gt;: Prisma P1001 · P1002 · P1008 · P1017 · P2024 · P2028 · P2034 · PrismaClientInitializationError · ECONNRESET · ETIMEDOUT · ECONNREFUSED · EPIPE · Postgres SQLSTATE &lt;b&gt;57P01 / 57P02 / 57P03&lt;/b&gt;, lớp &lt;b&gt;08&lt;/b&gt; (08000/001/003/004/006) — Neon autosuspend/restart (BP5)&lt;br&gt;&lt;b&gt;unknown&lt;/b&gt;: mọi thứ còn lại — kể cả amqplib “Channel closed” (không làm lệch bộ điều khiển db)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="100" width="640" height="150" as="geometry"/></mxCell><mxCell id="p88" value="&lt;b&gt;Normalize khi DB ốm&lt;/b&gt; (§7.4): lỗi tạm VÀ factor &amp;gt; 0 → &lt;b&gt;q.normalize.retry.30s KHÔNG đốt lượt&lt;/b&gt; (x-normalize-deferred-since) tối đa NORMALIZE_MAX_DEFER_MS = 60 phút; factor = 0 (lỗi lẻ) → hành vi cũ 5 lượt × 30s rồi DLQ. Trước BP5: Neon chết &amp;gt; 2,5 phút = cả lô vào q.normalize.dlq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="640" height="110" as="geometry"/></mxCell><mxCell id="p89" value="Tắt máy — shutdown.ts gracefulStop (có test thứ tự)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#2f5597;fontColor=#1f3864;fontStyle=1;fontSize=13;swimlaneFillColor=#f4f8fd;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="640" height="250" as="geometry"/></mxCell><mxCell id="p90" value="① cancel consumer (không nhận mới)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p89"><mxGeometry x="10" y="38" width="145" height="90" as="geometry"/></mxCell><mxCell id="p91" value="② backpressure.shutdown(): mọi waiter nhận 'shutdown'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p89"><mxGeometry x="165" y="38" width="145" height="90" as="geometry"/></mxCell><mxCell id="p92" value="③ chờ handler có permit (waitIdle, ngân sách 25s − 5s) + việc nền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p89"><mxGeometry x="320" y="38" width="145" height="90" as="geometry"/></mxCell><mxCell id="p93" value="④ đóng channel → connection → app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;" vertex="1" parent="p89"><mxGeometry x="475" y="38" width="155" height="90" as="geometry"/></mxCell><mxCell id="p94" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p90" target="p91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p95" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p91" target="p92"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p92" target="p93"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p97" value="Cả quy trình chạy đua với SHUTDOWN_TIMEOUT_MS = &lt;b&gt;25000&lt;/b&gt; (Render SIGKILL ~30s). Message chưa ack → RabbitMQ giao lại cho tiến trình khác. Channel consumer đóng bất thường (lỗi mức channel) → process.exit(1) (BP5 đóng nợ “channel zombie”), log mã lỗi channel gần nhất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="p89"><mxGeometry x="10" y="140" width="620" height="100" as="geometry"/></mxCell><mxCell id="p98" value="&lt;b&gt;Mọi đường HOÃN / lỗi của một message delivery&lt;/b&gt; (delivery.consumer.ts) — hoãn = KHÔNG phải một lần thử: attemptCount giữ nguyên; chỉ lỗi phía đích mới đốt lượt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="1640" height="30" as="geometry"/></mxCell><mxCell id="p99" value="&lt;b&gt;Tình huống&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="726" width="330" height="30" as="geometry"/></mxCell><mxCell id="p100" value="&lt;b&gt;Hàng đợi / đích&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="726" width="300" height="30" as="geometry"/></mxCell><mxCell id="p101" value="&lt;b&gt;Đốt lượt?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="726" width="110" height="30" as="geometry"/></mxCell><mxCell id="p102" value="&lt;b&gt;Redis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="726" width="210" height="30" as="geometry"/></mxCell><mxCell id="p103" value="&lt;b&gt;Postgres&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="726" width="330" height="30" as="geometry"/></mxCell><mxCell id="p104" value="&lt;b&gt;Header / ghi chú&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;fillColor=#dae8fc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="726" width="360" height="30" as="geometry"/></mxCell><mxCell id="p105" value="Circuit OPEN, lần trip đầu (:open EX 60)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;fontSize=10;arcSize=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="756" width="330" height="34" as="geometry"/></mxCell><mxCell id="p106" value="q.delivery.retry.1m" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;fontSize=10;arcSize=0;rounded=0;" vertex="1" parent="1"><mxGeometry x="350" y="756" width="300" height="34" as="geometry"/></mxCell><mxCell id="p107" value="không" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#2f5597;fontColor=#000000;fontSize=11;align=left;spacingLeft=6;fontSize=10;arcSize=0;