{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"], "@hub/flow": ["../../libs/common/src/flow/index.ts"],
      "@hub/common/alerts/text": ["../../libs/common/src/alerts/text.ts"],
      "@hub/common/auth/redact": ["../../libs/common/src/auth/redact.ts"],
      "@hub/providers/catalog": ["../../libs/providers/src/catalog/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.spec.ts"]
}
