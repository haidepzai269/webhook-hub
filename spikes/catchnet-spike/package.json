{
  "name": "catchnet-spike",
  "private": true,
  "version": "0.0.0",
  "description": "LH-S: Worker nháp hub-hooks-spike — vứt đi được, KHÔNG thuộc npm workspaces của hub",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:local": "wrangler d1 execute hub-hooks-spike-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute hub-hooks-spike-db --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
