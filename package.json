{
  "name": "webhook-hub-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "!apps/catchnet",
    "libs/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build:libs && npm run build --workspace=apps/hub-api --workspace=apps/hub-worker --workspace=apps/shop --if-present",
    "build:libs": "npm run build --workspace=libs/common --workspace=libs/crypto --workspace=libs/messaging --workspace=libs/database --workspace=libs/providers --workspace=libs/hub-sdk --if-present",
    "start:api": "npm run start:dev --workspace=apps/hub-api",
    "start:worker": "npm run start:dev --workspace=apps/hub-worker",
    "start:shop": "npm run start:dev --workspace=apps/shop",
    "start:web": "npm run dev --workspace=apps/web",
    "test": "jest --maxWorkers=2",
    "test:watch": "jest --watch --maxWorkers=2",
    "test:cov": "jest --coverage --maxWorkers=2",
    "prisma:generate": "npm run prisma:generate --workspace=libs/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=libs/database",
    "prisma:seed": "npm run prisma:seed --workspace=libs/database",
    "verify:up": "ts-node --transpile-only -P tsconfig.json verify/cli/stack.ts up",
    "verify:down": "ts-node --transpile-only -P tsconfig.json verify/cli/stack.ts down",
    "verify:reset": "ts-node --transpile-only -P tsconfig.json verify/cli/stack.ts reset",
    "verify:seed": "ts-node --transpile-only -P tsconfig.json verify/cli/stack.ts seed",
    "verify:ps": "ts-node --transpile-only -P tsconfig.json verify/cli/stack.ts ps",
    "verify": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts all",
    "verify:unit": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts unit",
    "verify:db": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts db",
    "verify:map": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts map",
    "verify:e2e": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts e2e",
    "verify:deployed": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts deployed",
    "verify:chaos": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts chaos",
    "verify:chaos:bp": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts chaos --tag chaos-bp",
    "verify:all": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts all-l3",
    "verify:probe": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts probe",
    "verify:bb": "ts-node --transpile-only -P tsconfig.json verify/cli/run.ts bb",
    "demo:reset": "ts-node --transpile-only -P tsconfig.json verify/cli/demo.ts reset",
    "demo:run": "ts-node --transpile-only -P tsconfig.json verify/cli/demo.ts run",
    "demo:rehearse": "ts-node --transpile-only -P tsconfig.json verify/cli/demo.ts rehearse",
    "demo:warm": "ts-node --transpile-only -P tsconfig.json verify/cli/demo.ts warm",
    "verify:selftest": "ts-node --transpile-only -P tsconfig.json verify/scenarios/stack-isolation.ts",
    "adr:new": "ts-node --transpile-only -P tsconfig.json scripts/adr-new.ts",
    "verify:gates": "ts-node --transpile-only -P tsconfig.json verify/cli/gates.ts",
    "verify:e2e:auth": "ts-node --transpile-only -P tsconfig.json verify/scenarios/auth-e2e.ts",
    "hub-sim": "ts-node --transpile-only -P tsconfig.json tools/hub-sim/cli.ts",
    "catalog:build": "ts-node --transpile-only -r tsconfig-paths/register -P tsconfig.json libs/providers/src/catalog/tools/build-catalog.ts",
    "verify:catalog": "ts-node --transpile-only -r tsconfig-paths/register -P tsconfig.json libs/providers/src/catalog/tools/verify-catalog.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
