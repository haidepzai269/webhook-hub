{
  "uid": "webhook-hub",
  "title": "Webhook Hub",
  "tags": [
    "webhook-hub"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS ingest theo provider",
      "description": "Request /hooks mỗi giây (mọi kết quả).",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (provider) (rate(hub_ingest_requests_total[1m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Độ trễ ingest p50 / p95 / p99",
      "description": "Nhận -> verify -> COMMIT -> ACK. Số liệu báo cáo lấy ở LOCAL (ADR-019).",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(hub_ingest_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hub_ingest_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hub_ingest_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kết quả ingest (ACCEPTED / REJECTED / DUPLICATE …)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(hub_ingest_requests_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Delivery theo trạng thái",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (status, destination_type) (rate(hub_deliveries_total[1m]))",
          "legendFormat": "{{destination_type}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox lag",
      "description": "Tuổi dòng outbox chưa publish lâu nhất (relay đo mỗi lượt).",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "max(hub_outbox_lag_seconds)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit đổi trạng thái",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (to) (increase(hub_circuit_transitions_total[5m]))",
          "legendFormat": "-> {{to}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cảnh báo đang OPEN theo mức",
      "description": "hub_alerts_open{severity} — đặt cuối mỗi lượt đánh giá trọn vẹn (60s). Mỗi worker tự đánh giá mọi project (không khoá, ADR-165) nên báo cùng con số: dùng max, không sum.",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "max by (severity) (hub_alerts_open)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cảnh báo đổi trạng thái / lỗi đánh giá",
      "description": "hub_alert_transitions_total{rule,to}: lần chuyển OPEN/RESOLVED do chính worker ghi được. hub_alert_eval_errors_total{rule}: luật ném lỗi (các luật khác vẫn chạy) — khác 0 kéo dài là evaluator đang mù.",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (rule, to) (increase(hub_alert_transitions_total[5m]))",
          "legendFormat": "{{rule}} -> {{to}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "B",
          "expr": "sum by (rule) (increase(hub_alert_eval_errors_total[5m]))",
          "legendFormat": "lỗi {{rule}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Lớp biên: sourceKey lạ + hộp phạt (EG2)",
      "description": "Chỉ người vận hành (Grafana). hub_ingest_unknown_source_total: request /hooks vào sourceKey không tồn tại (404, không thuộc tenant nào — không lưu DB). hub_ingest_penalty_bans_total{reason}: lần BẮT ĐẦU tạm chặn (unknown_source = cả IP; bad_signature = cặp IP + sourceKey). hub_ingest_penalty_blocked_total{reason}: request bị chặn 429 ip_temporarily_blocked. Mỗi instance hub-api đếm riêng (ADR-177). hub_ingest_penalty_bans_skipped_total{reason,cause}: đủ ngưỡng nhưng không phạt vì số ban chạm trần (capacity).",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hub_ingest_unknown_source_total[5m]))",
          "legendFormat": "sourceKey lạ (404)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "B",
          "expr": "sum by (reason) (increase(hub_ingest_penalty_bans_total[5m]))",
          "legendFormat": "bắt đầu phạt {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "C",
          "expr": "sum by (reason) (increase(hub_ingest_penalty_blocked_total[5m]))",
          "legendFormat": "bị chặn {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "D",
          "expr": "sum by (reason, cause) (increase(hub_ingest_penalty_bans_skipped_total[5m]))",
          "legendFormat": "không phạt {{reason}} ({{cause}})"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Hộp phạt: khoá trong bộ nhớ, IP private bị bỏ qua, lưu lượng bị bỏ (EG2/EG4)",
      "description": "hub_ingest_penalty_entries: số khoá hộp phạt đang giữ ở mỗi instance (trần EDGE_PENALTY_MAX_ENTRIES — chạm trần là đang bị dội nhiều IP). hub_traffic_flush_dropped_total: request của bảng lưu lượng bị bỏ vì ghi Postgres lỗi quá 10 phút (ADR-179). skipped_private = hub_ingest_penalty_skipped_private_total / request /hooks (provider!=\"api\") có IP loopback/private (hộp phạt bỏ qua): > 50% /hooks = cấu hình IP sai (hub-api thấy IP của proxy/NAT). hub_ingest_penalty_good_entries: số cặp tốt (trần EDGE_PENALTY_GOOD_MAX_ENTRIES).",
      "datasource": {
        "type": "prometheus",
        "uid": "hub-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "A",
          "expr": "sum by (instance) (hub_ingest_penalty_entries)",
          "legendFormat": "khoá hộp phạt {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "B",
          "expr": "sum(increase(hub_traffic_flush_dropped_total[5m]))",
          "legendFormat": "lưu lượng bị bỏ"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "C",
          "expr": "sum(increase(hub_ingest_penalty_skipped_private_total[5m])) / clamp_min(sum(increase(hub_ingest_requests_total{provider!=\"api\"}[5m])), 1)",
          "legendFormat": "skipped_private / /hooks (trừ api)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hub-prometheus"
          },
          "refId": "D",
          "expr": "sum by (instance) (hub_ingest_penalty_good_entries)",
          "legendFormat": "cặp tốt {{instance}}"
        }
      ]
    }
  ]
}
