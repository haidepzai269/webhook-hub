# =====================================================================================
# VF1 (SPEC-verification §4.2, ADR-067): env của stack kiểm chứng `hubv`. FILE NÀY ĐƯỢC COMMIT.
# - KHÔNG có secret thật nào. Mọi giá trị nhạy cảm là giá trị giả cố định `VERIFY_ONLY_…`.
#   hub-api / hub-worker THOÁT nếu NODE_ENV=production mà gặp giá trị `VERIFY_ONLY_…` (testOnlyConfigProblems).
# - TELEGRAM_BOT_TOKEN, DISCORD_WEBHOOK_URL PHẢI để trống: seed trỏ đích vào /mock/* của hub-api.
#   `verify/cli/stack.ts` từ chối chạy nếu hai biến này có giá trị.
# - Không có `.env.verify.local`, không có "sandbox secret thật" (spec §4.2 bản 10/10).
# - Dùng làm --env-file cho docker compose (nội suy): dấu `$` trong hash bcrypt phải viết `$$`.
# =====================================================================================

MASTER_KEY=VERIFY_ONLY_master_key_0000000000000000000000
JWT_SECRET=VERIFY_ONLY_jwt_secret_00000000000000000000000
HUB_SIGNING_SECRET=VERIFY_ONLY_hub_signing_secret
INTERNAL_TOKEN=VERIFY_ONLY_internal_token

# AU1 (SPEC-auth §7): operator của console (thay ADMIN_USERNAME/ADMIN_PASSWORD_HASH). Mật khẩu: VERIFY_ONLY_admin_password
OPERATOR_EMAIL=operator@verify.local
OPERATOR_PASSWORD_HASH=$$2b$$10$$KOw7dYmHfpMPOZiM0LK0aerYvyW.jRTeinGVXLWXp.9.NXVQzWom.
# Bí mật phiên đăng nhập: mỗi cái ≥ 32 ký tự và KHÁC nhau (hub-api kiểm lúc khởi động).
CSRF_SECRET=VERIFY_ONLY_csrf_secret_0000000000000000000000
SOCKET_TICKET_SECRET=VERIFY_ONLY_socket_ticket_0000000000000000000
OAUTH_COOKIE_SECRET=VERIFY_ONLY_oauth_cookie_000000000000000000000
# R-2 (ADR-110): secret chung web <-> hub-api để chuyển IP client qua proxy web
WEB_PROXY_SECRET=VERIFY_ONLY_web_proxy_00000000000000000000000000
WEB_PUBLIC_URL=http://localhost:13000
# AU5b (ADR-127): đăng nhập Google qua fake-google trong sink (KHÔNG gọi Google thật). Production đặt FAKE_BASE_URL -> app thoát.
GOOGLE_OAUTH_CLIENT_ID=VERIFY_ONLY_google_client.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=VERIFY_ONLY_google_oauth_secret_000000
GOOGLE_OAUTH_FAKE_BASE_URL=http://sink:4100/fake-google
# AU6: role runtime hub_app (RLS). verify:db chạy test bằng role này; fixture dựng bằng owner (hub_user).
HUB_APP_DB_PASSWORD=VERIFY_ONLY_hub_app_db_password
# AU2: mail ghi ra file (verify/.mail trên host), không gửi thật. Production + capture -> app thoát.
MAIL_DRIVER=capture
MAIL_CAPTURE_DIR=/mail

# Secret phía provider (hub-sim / smoke ký bằng chính các giá trị này)
PAYOS_CLIENT_ID=VERIFY_ONLY_payos_client_id
PAYOS_API_KEY=VERIFY_ONLY_payos_api_key
PAYOS_CHECKSUM_KEY=VERIFY_ONLY_payos_checksum_key
SEPAY_API_KEY=VERIFY_ONLY_sepay_api_key
GITHUB_WEBHOOK_SECRET=VERIFY_ONLY_github_webhook_secret
DEMO_SEPAY_APIKEY=VERIFY_ONLY_demo_sepay_apikey

# Đích: TRỐNG → /mock/telegram, /mock/discord (ADR-054). Không bao giờ điền giá trị thật ở đây.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Đích Telegram là mock nên bật được subscription để e2e đi hết đường Telegram.
SEED_TELEGRAM_ACTIVE=true

SHOP_DB_PASSWORD=VERIFY_ONLY_shop_db_password
RUN_SEED=true
# Trần ingest cao: runner e2e/chaos bắn nhiều request liên tiếp vào cùng source.
INGEST_RATE_LIMIT_PER_MIN=100000
METRICS_TOKEN=

# Đa service S2/S11: host trong connection string (cổng hubv) + key `shop` cố định (seed lưu sha256, shop dùng trong HUB_URL)
HUB_PUBLIC_URL=http://localhost:14000
SEED_SHOP_API_KEY=hk_test_VERIFY_ONLY_shop_key_0000000000000000000000

# S12 (ADR-082): endpoint của project demo cafe/bookstore trỏ sink để đọc lại payload (GET :14100/_requests)
DEMO_ENDPOINT_BASE_URL=http://sink:4100
